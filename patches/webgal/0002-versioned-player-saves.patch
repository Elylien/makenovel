+    if (!object(item)) throw new Error('历史记录无效。');
+    assertMetadata(item.makenovel, meta);
+    assertStage(item.currentStageState);
+    assertScene(item.saveScene);
+  }
+  const { scenes } = await validateCurrent();
+  const sceneSources = new Map<string, string>();
+  for (const reference of references) {
+    const bytes = scenes.get(reference.path);
+    if (!bytes) throw new Error('存档场景不在本作品版本清单中。');
+    sceneSources.set(reference.url, new TextDecoder('utf-8', { fatal: true }).decode(bytes));
+  }
+  return { rawScene: sceneSources.get(snapshot.sceneData.sceneUrl)!, sceneSources };
+}
