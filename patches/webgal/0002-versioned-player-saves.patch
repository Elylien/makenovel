diff --git a/packages/webgal/src/UI/SaveDataTools/SaveDataTools.tsx b/packages/webgal/src/UI/SaveDataTools/SaveDataTools.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..00943362a13dd00fcafcae706d6fff57368f975c
--- /dev/null
+++ b/packages/webgal/src/UI/SaveDataTools/SaveDataTools.tsx
@@ -0,0 +1,112 @@
+import { useEffect, useRef, useState } from 'react';
+import localforage from 'localforage';
+import { captureSaveBackup, verifySaveBackup } from '@/Core/controller/storage/saveBackup';
+import {
+  clearSaveError,
+  getSaveStatus,
+  reportSaveError,
+  subscribeSaveStatus,
+} from '@/Core/controller/storage/makenovelCompatibility';
+import './saveDataTools.scss';
+
+function useSaveStatus() {
+  const [status, setStatus] = useState(getSaveStatus);
+  useEffect(() => {
+    const refresh = () => setStatus(getSaveStatus());
+    const unsubscribe = subscribeSaveStatus(refresh);
+    refresh();
+    return unsubscribe;
+  }, []);
+  return status;
+}
+
+export function SaveDataNotice() {
+  const status = useSaveStatus();
+  if (!status.error) return null;
+  return (
+    <aside className="makenovel-save-notice" role="alert" onClick={(event) => event.stopPropagation()}>
+      <span>{status.error}</span>
+      <button type="button" onClick={clearSaveError}>
+        知道了
+      </button>
+    </aside>
+  );
+}
+
+export function SaveDataTools() {
+  const status = useSaveStatus();
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState('');
+  const fileInput = useRef<HTMLInputElement>(null);
+  async function exportBackup() {
+    if (busy || !status.scope) return;
+    setBusy(true);
+    setResult('正在完整读取本作品的玩家数据…');
+    try {
+      const backup = await captureSaveBackup(localforage, status.scope);
+      const url = URL.createObjectURL(new Blob([JSON.stringify(backup)], { type: 'application/json' }));
+      const anchor = document.createElement('a');
+      anchor.href = url;
+      anchor.download = `makenovel-player-backup-${new Date().toISOString().replace(/[:.]/g, '-')}.json`;
+      document.body.append(anchor);
+      anchor.click();
+      anchor.remove();
+      window.setTimeout(() => URL.revokeObjectURL(url), 60000);
+      setResult(
+        `备份已生成：${backup.payload.records.length} 项当前数据、${backup.payload.preserved.length} 份保留副本。请保管下载文件。`,
+      );
+    } catch (error) {
+      setResult('备份未完成，原始数据仍保留。');
+      reportSaveError(error);
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function verifyFile(file: File | undefined) {
+    if (!file || !status.scope || busy) return;
+    setBusy(true);
+    setResult('正在核对备份…');
+    try {
+      if (file.size > 256 * 1024 * 1024) throw new Error('备份文件过大，无法在本页校验。');
+      const archive = await verifySaveBackup(JSON.parse(await file.text()), status.scope);
+      setResult(`备份校验通过：${archive.payload.records.length} 项数据。此操作只校验文件；跨版本恢复仍需专门迁移。`);
+    } catch (error) {
+      setResult('备份未通过校验，当前玩家数据未更改。');
+      reportSaveError(error);
+    } finally {
+      setBusy(false);
+      if (fileInput.current) fileInput.current.value = '';
+    }
+  }
+  return (
+    <section className="makenovel-save-tools" aria-label="玩家数据与版本">
+      <h3>玩家数据与版本</h3>
+      <p>{status.message}</p>
+      <p>完整备份包含已保存的全部槽、快档、已读、设置、鉴赏、流程图和旧版本副本。来源不明的旧档暂不直接导入。</p>
+      <div>
+        <button
+          type="button"
+          disabled={busy || !status.scope}
+          onClick={() => {
+            void exportBackup();
+          }}
+        >
+          导出完整备份
+        </button>
+        <button type="button" disabled={busy || !status.scope} onClick={() => fileInput.current?.click()}>
+          校验备份文件
+        </button>
+        <input
+          ref={fileInput}
+          type="file"
+          accept="application/json,.json"
+          hidden
+          onChange={(event) => {
+            void verifyFile(event.target.files?.[0]);
+          }}
+        />
+      </div>
+      <p role="status">{result}</p>
+    </section>
+  );
+}
