--- /dev/null
+++ b/packages/webgal/src/Core/controller/storage/saveBackup.ts
@@ -0,0 +1,480 @@
+/**
+ * Lossless, scoped copies of the persisted player data. This module never removes
+ * or updates a player key and deliberately has no restore-to-active-store API.
+ */
+export interface SaveBackupStorage {
+  keys(): Promise<string[]>;
+  getItem<T = unknown>(key: string): Promise<T | null>;
+  setItem<T>(key: string, value: T): Promise<T>;
+}
+
+export interface SaveBackupScope {
+  projectId?: string;
+  legacyGameKey: string;
+  legacyGameName?: string;
+}
+
+// Tagged values preserve undefined, sparse arrays, negative zero and binary data.
+// Object fields are pairs rather than dynamically assigned properties: even a
+// stored __proto__ field is inert data. Unsupported values fail the entire copy.
+export type BackupValue =
+  | { type: 'null' | 'undefined' }
+  | { type: 'boolean'; value: boolean }
+  | { type: 'string' | 'number' | 'bigint' | 'date'; value: string }
+  | { type: 'array'; length: number; entries: Array<[number, BackupValue]> }
+  | { type: 'object'; entries: Array<[string, BackupValue]> }
+  | { type: 'map'; entries: Array<[BackupValue, BackupValue]> }
+  | { type: 'set'; values: BackupValue[] }
+  | { type: 'binary'; kind: string; base64: string; mime?: string };
+
+export interface SaveBackupPayload {
+  format: 'makenovel-player-backup';
+  schemaVersion: 1;
+  createdAt: string;
+  reason: 'before-initialization' | 'manual-export';
+  scope: SaveBackupScope;
+  records: Array<{ key: string; value: BackupValue }>;
+  // Preserved copies never contain further copies (no exponential nesting).
+  preserved: Array<{ key: string; archive: SaveBackupArchive }>;
+}
+
+export interface SaveBackupArchive {
+  payload: SaveBackupPayload;
+  checksum: { algorithm: 'SHA-256'; value: string };
+}
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+const HASH = /^[0-9a-f]{64}$/;
+const MAX_ARCHIVE_CHARS = 256 * 1024 * 1024;
+const MAX_RECORDS = 10000;
+const BINARY_KINDS = new Set([
+  'ArrayBuffer',
+  'Int8Array',
+  'Uint8Array',
+  'Uint8ClampedArray',
+  'Int16Array',
+  'Uint16Array',
+  'Int32Array',
+  'Uint32Array',
+  'Float32Array',
+  'Float64Array',
+  'BigInt64Array',
+  'BigUint64Array',
+  'DataView',
+  'Blob',
+]);
+
+function assertScope(scope: SaveBackupScope) {
+  if (
+    !scope ||
+    (scope.projectId !== undefined && !UUID.test(scope.projectId)) ||
+    typeof scope.legacyGameKey !== 'string' ||
+    scope.legacyGameKey.length === 0 ||
+    /^makenovel-(?:v1|unverified-v1|backup-v1):/.test(scope.legacyGameKey) ||
+    (scope.legacyGameName !== undefined && typeof scope.legacyGameName !== 'string')
+  ) {
+    throw new Error('备份作品身份无效；没有读取或修改玩家数据。');
+  }
+}
+
+function normalizedScope(scope: SaveBackupScope): SaveBackupScope {
+  return {
+    legacyGameKey: scope.legacyGameKey,
+    ...(scope.projectId === undefined ? {} : { projectId: scope.projectId }),
+    ...(scope.legacyGameName === undefined ? {} : { legacyGameName: scope.legacyGameName }),
+  };
+}
+
+function backupPrefix(scope: SaveBackupScope) {
+  return scope.projectId === undefined
+    ? `makenovel-backup-v1:legacy:${encodeURIComponent(scope.legacyGameKey)}:`
+    : `makenovel-backup-v1:${scope.projectId}:`;
+}
+
+function isPreservedKey(key: string, scope: SaveBackupScope) {
+  return (
+    key.startsWith(backupPrefix(scope)) ||
+    (scope.projectId !== undefined && key.startsWith(backupPrefix({ legacyGameKey: scope.legacyGameKey })))
+  );
+}
+
+function preservedScope(key: string, archive: unknown, scope: SaveBackupScope): SaveBackupScope {
+  if (!recordObject(archive) || !recordObject(archive.payload) || !recordObject(archive.payload.scope)) {
+    throw new Error('备份副本身份无效。');
+  }
+  const retainedScope = archive.payload.scope as unknown as SaveBackupScope;
+  assertScope(retainedScope);
+  const ownsProject = scope.projectId !== undefined && retainedScope.projectId === scope.projectId;
+  const ownsLegacy = retainedScope.projectId === undefined && retainedScope.legacyGameKey === scope.legacyGameKey;
+  if (
+    (!ownsProject && !ownsLegacy) ||
+    !key.startsWith(backupPrefix(retainedScope)) ||
+    !UUID.test(key.slice(backupPrefix(retainedScope).length))
+  )
+    throw new Error('备份副本身份无效。');
+  return retainedScope;
+}
+
+function ownsNamespaceKey(key: string, namespace: string) {
+  if (key === namespace || key === `${namespace}-saves-fast` || key === `${namespace}-flowchart`) return true;
+  const suffix = key.slice(namespace.length);
+  return key.startsWith(namespace) && (/^-saves\d+$/.test(suffix) || /^-flowchart-.+$/s.test(suffix));
+}
+
+/** Strict current-format parsing; legacy keys have no authenticated project ID. */
+export function ownsSaveBackupKey(key: string, scope: SaveBackupScope): boolean {
+  assertScope(scope);
+  if (ownsNamespaceKey(key, scope.legacyGameKey)) return true;
+  if (
+    scope.legacyGameName !== undefined &&
+    (key === `FastSaveKey-${scope.legacyGameName}-${scope.legacyGameKey}` ||
+      key === `FastSaveActive-${scope.legacyGameName}-${scope.legacyGameKey}`)
+  )
+    return true;
+  if (scope.projectId === undefined) return false;
+  const prefix = `makenovel-v1:${scope.projectId}:`;
+  if (!key.startsWith(prefix)) return false;
+  const manifestHash = key.slice(prefix.length, prefix.length + 64);
+  return HASH.test(manifestHash) && ownsNamespaceKey(key, `${prefix}${manifestHash}`);
+}
+
+function canonical(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
+  if (value !== null && typeof value === 'object') {
+    return `{${Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonical((value as Record<string, unknown>)[key])}`)
+      .join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+async function digest(value: unknown) {
+  const text = canonical(value);
+  if (text.length > MAX_ARCHIVE_CHARS) throw new Error('备份超过本版 256 MiB 字符上限；原数据未修改。');
+  const hash = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
+  return Array.from(new Uint8Array(hash), (byte) => byte.toString(16).padStart(2, '0')).join('');
+}
+
+// Derive this key from the legacy identity, never from an imported namespace.
+// Only settings live here; unverified slots/flowchart keys are not accepted.
+async function isolatedSettingsKey(scope: SaveBackupScope): Promise<string> {
+  const hash = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(scope.legacyGameKey));
+  return `makenovel-unverified-v1:${Array.from(new Uint8Array(hash), (byte) => byte.toString(16).padStart(2, '0')).join('')}`;
+}
+
+function base64(bytes: Uint8Array) {
+  let result = '';
+  for (let i = 0; i < bytes.length; i += 8192) result += String.fromCharCode(...bytes.subarray(i, i + 8192));
+  return btoa(result);
+}
+
+async function encode(value: unknown, ancestors = new Set<object>(), depth = 0): Promise<BackupValue> {
+  if (depth > 100) throw new Error('玩家数据嵌套过深，无法安全备份；原数据未修改。');
+  if (value === null) return { type: 'null' };
+  if (value === undefined) return { type: 'undefined' };
+  if (typeof value === 'string') return { type: 'string', value };
+  if (typeof value === 'boolean') return { type: 'boolean', value };
+  if (typeof value === 'number') return { type: 'number', value: Object.is(value, -0) ? '-0' : String(value) };
+  if (typeof value === 'bigint') return { type: 'bigint', value: String(value) };
+  if (typeof value !== 'object') throw new Error('玩家数据包含不支持的值，备份已中止；原数据未修改。');
+  if (ancestors.has(value)) throw new Error('玩家数据存在循环引用，备份已中止；原数据未修改。');
+  const next = new Set(ancestors).add(value);
+  const child = (item: unknown) => encode(item, next, depth + 1);
+  if (value instanceof Date)
+    return { type: 'date', value: Number.isNaN(value.getTime()) ? 'Invalid Date' : value.toISOString() };
+  if (value instanceof ArrayBuffer)
+    return { type: 'binary', kind: 'ArrayBuffer', base64: base64(new Uint8Array(value)) };
+  if (ArrayBuffer.isView(value)) {
+    return {
+      type: 'binary',
+      kind: value.constructor.name,
+      base64: base64(new Uint8Array(value.buffer, value.byteOffset, value.byteLength)),
+    };
+  }
+  if (typeof Blob !== 'undefined' && value instanceof Blob) {
+    if (typeof File !== 'undefined' && value instanceof File)
+      throw new Error('玩家数据包含文件对象，备份已中止；原数据未修改。');
+    return {
+      type: 'binary',
+      kind: 'Blob',
+      mime: value.type,
+      base64: base64(new Uint8Array(await value.arrayBuffer())),
+    };
+  }
+  if (value instanceof Map) {
+    const entries: Array<[BackupValue, BackupValue]> = [];
+    for (const [key, item] of value) entries.push([await child(key), await child(item)]);
+    return { type: 'map', entries };
+  }
+  if (value instanceof Set) {
+    const values: BackupValue[] = [];
+    for (const item of value) values.push(await child(item));
+    return { type: 'set', values };
+  }
+  if (Array.isArray(value)) {
+    const entries: Array<[number, BackupValue]> = [];
+    for (let index = 0; index < value.length; index++) {
+      if (Object.prototype.hasOwnProperty.call(value, index)) entries.push([index, await child(value[index])]);
+    }
+    // IndexedDB arrays do not retain custom non-index properties consistently.
+    if (Object.keys(value).some((key) => !/^(0|[1-9]\d*)$/.test(key) || Number(key) >= value.length)) {
+      throw new Error('玩家数组包含自定义字段，备份已中止；原数据未修改。');
+    }
+    return { type: 'array', length: value.length, entries };
+  }
+  if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) {
+    throw new Error('玩家数据包含不支持的对象，备份已中止；原数据未修改。');
+  }
+  if (Object.getOwnPropertySymbols(value).length !== 0)
+    throw new Error('玩家数据包含符号字段，备份已中止；原数据未修改。');
+  const entries: Array<[string, BackupValue]> = [];
+  for (const key of Object.keys(value).sort())
+    entries.push([key, await child((value as Record<string, unknown>)[key])]);
+  return { type: 'object', entries };
+}
+
+function recordObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function exactKeys(value: Record<string, unknown>, keys: string[]) {
+  return Object.keys(value).sort().join('|') === keys.slice().sort().join('|');
+}
+
+function validateValue(value: unknown, depth = 0): void {
+  const invalid = () => {
+    throw new Error('备份含有无效或不支持的数据值。');
+  };
+  if (depth > 100 || !recordObject(value) || typeof value.type !== 'string') return invalid();
+  const next = (item: unknown) => validateValue(item, depth + 1);
+  switch (value.type) {
+    case 'null':
+    case 'undefined':
+      if (!exactKeys(value, ['type'])) invalid();
+      return;
+    case 'boolean':
+      if (!exactKeys(value, ['type', 'value']) || typeof value.value !== 'boolean') invalid();
+      return;
+    case 'string':
+    case 'number':
+    case 'bigint':
+    case 'date': {
+      if (!exactKeys(value, ['type', 'value']) || typeof value.value !== 'string') return invalid();
+      if (
+        value.type === 'number' &&
+        !['NaN', 'Infinity', '-Infinity', '-0'].includes(value.value) &&
+        (value.value === '' || String(Number(value.value)) !== value.value)
+      )
+        invalid();
+      if (value.type === 'bigint' && !/^(0|-?[1-9]\d*)$/.test(value.value)) invalid();
+      if (
+        value.type === 'date' &&
+        value.value !== 'Invalid Date' &&
+        (!Number.isFinite(Date.parse(value.value)) || new Date(value.value).toISOString() !== value.value)
+      )
+        invalid();
+      return;
+    }
+    case 'array':
+    case 'object': {
+      if (
+        !exactKeys(value, value.type === 'array' ? ['type', 'length', 'entries'] : ['type', 'entries']) ||
+        !Array.isArray(value.entries)
+      )
+        return invalid();
+      if (
+        value.type === 'array' &&
+        (!Number.isSafeInteger(value.length) || (value.length as number) < 0 || (value.length as number) > 4294967295)
+      )
+        invalid();
+      const seen = new Set<unknown>();
+      for (const pair of value.entries) {
+        if (!Array.isArray(pair) || pair.length !== 2 || seen.has(pair[0])) return invalid();
+        seen.add(pair[0]);
+        if (
+          value.type === 'array'
+            ? !Number.isSafeInteger(pair[0]) || pair[0] < 0 || pair[0] >= (value.length as number)
+            : typeof pair[0] !== 'string'
+        )
+          invalid();
+        next(pair[1]);
+      }
+      return;
+    }
+    case 'map':
+      if (!exactKeys(value, ['type', 'entries']) || !Array.isArray(value.entries)) return invalid();
+      for (const pair of value.entries) {
+        if (!Array.isArray(pair) || pair.length !== 2) return invalid();
+        next(pair[0]);
+        next(pair[1]);
+      }
+      return;
+    case 'set':
+      if (!exactKeys(value, ['type', 'values']) || !Array.isArray(value.values)) return invalid();
+      value.values.forEach(next);
+      return;
+    case 'binary':
+      if (
+        !exactKeys(value, value.kind === 'Blob' ? ['type', 'kind', 'base64', 'mime'] : ['type', 'kind', 'base64']) ||
+        typeof value.kind !== 'string' ||
+        !BINARY_KINDS.has(value.kind) ||
+        typeof value.base64 !== 'string' ||
+        !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value.base64) ||
+        (value.kind === 'Blob' && typeof value.mime !== 'string')
+      )
+        invalid();
+      return;
+    default:
+      invalid();
+  }
+}
+
+/** Offline validation only: a checksum detects damage, not an authenticated author. */
+export async function verifySaveBackup(
+  input: unknown,
+  scope: SaveBackupScope,
+  preservedCopy = false,
+): Promise<SaveBackupArchive> {
+  assertScope(scope);
+  const settingsKey = await isolatedSettingsKey(scope);
+  if (
+    !recordObject(input) ||
+    !exactKeys(input, ['payload', 'checksum']) ||
+    !recordObject(input.payload) ||
+    !recordObject(input.checksum) ||
+    !exactKeys(input.checksum, ['algorithm', 'value']) ||
+    input.checksum.algorithm !== 'SHA-256' ||
+    typeof input.checksum.value !== 'string' ||
+    !HASH.test(input.checksum.value)
+  ) {
+    throw new Error('不是受支持的完整玩家备份。');
+  }
+  const payload = input.payload;
+  if (
+    !exactKeys(payload, ['format', 'schemaVersion', 'createdAt', 'reason', 'scope', 'records', 'preserved']) ||
+    payload.format !== 'makenovel-player-backup' ||
+    payload.schemaVersion !== 1 ||
+    typeof payload.createdAt !== 'string' ||
+    !Number.isFinite(Date.parse(payload.createdAt)) ||
+    !['before-initialization', 'manual-export'].includes(payload.reason as string) ||
+    !recordObject(payload.scope) ||
+    canonical(payload.scope) !== canonical(normalizedScope(scope)) ||
+    !Array.isArray(payload.records) ||
+    payload.records.length > MAX_RECORDS ||
+    !Array.isArray(payload.preserved) ||
+    payload.preserved.length > MAX_RECORDS ||
+    (preservedCopy && payload.preserved.length !== 0)
+  ) {
+    throw new Error('备份格式或作品身份不匹配。');
+  }
+  const seen = new Set<string>();
+  for (const record of payload.records) {
+    if (
+      !recordObject(record) ||
+      !exactKeys(record, ['key', 'value']) ||
+      typeof record.key !== 'string' ||
+      (!ownsSaveBackupKey(record.key, scope) && record.key !== settingsKey) ||
+      seen.has(record.key)
+    )
+      throw new Error('备份包含重复键或其他作品的数据。');
+    seen.add(record.key);
+    validateValue(record.value);
+  }
+  for (const preserved of payload.preserved) {
+    if (
+      !recordObject(preserved) ||
+      !exactKeys(preserved, ['key', 'archive']) ||
+      typeof preserved.key !== 'string' ||
+      !isPreservedKey(preserved.key, scope) ||
+      seen.has(preserved.key)
+    )
+      throw new Error('备份副本身份无效。');
+    seen.add(preserved.key);
+    await verifySaveBackup(preserved.archive, preservedScope(preserved.key, preserved.archive, scope), true);
+  }
+  if ((await digest(payload)) !== input.checksum.value) throw new Error('备份摘要不匹配，文件可能损坏或被修改。');
+  return input as unknown as SaveBackupArchive;
+}
+
+/**
+ * Two reads detect concurrent writes. This is not a cross-tab database transaction;
+ * startup must await this function before starting any local player-data writers.
+ */
+export async function captureSaveBackup(
+  storage: SaveBackupStorage,
+  scope: SaveBackupScope,
+  reason: SaveBackupPayload['reason'] = 'manual-export',
+): Promise<SaveBackupArchive> {
+  assertScope(scope);
+  const settingsKey = await isolatedSettingsKey(scope);
+  const select = (keys: string[]) =>
+    keys
+      .filter(
+        (key) =>
+          ownsSaveBackupKey(key, scope) ||
+          key === settingsKey ||
+          (reason === 'manual-export' && isPreservedKey(key, scope)),
+      )
+      .sort();
+  const keys = select(await storage.keys());
+  if (keys.length > MAX_RECORDS) throw new Error('玩家备份条目过多；原数据未修改。');
+  const values = new Map<string, string>();
+  const records: SaveBackupPayload['records'] = [];
+  const preserved: SaveBackupPayload['preserved'] = [];
+  for (const key of keys) {
+    const value = await storage.getItem(key);
+    if (isPreservedKey(key, scope)) {
+      const archive = await verifySaveBackup(value, preservedScope(key, value, scope), true);
+      preserved.push({ key, archive });
+      values.set(key, canonical(archive));
+    } else {
+      const encoded = await encode(value);
+      records.push({ key, value: encoded });
+      values.set(key, canonical(encoded));
+    }
+  }
+  if (canonical(keys) !== canonical(select(await storage.keys())))
+    throw new Error('玩家数据正在变化，请暂停其他窗口后重试备份。');
+  for (const key of keys) {
+    const value = await storage.getItem(key);
+    const current = isPreservedKey(key, scope) ? canonical(value) : canonical(await encode(value));
+    if (current !== values.get(key)) throw new Error('玩家数据正在变化，请暂停其他窗口后重试备份。');
+  }
+  const payload: SaveBackupPayload = {
+    format: 'makenovel-player-backup',
+    schemaVersion: 1,
+    createdAt: new Date().toISOString(),
+    reason,
+    scope: normalizedScope(scope),
+    records,
+    preserved,
+  };
+  return { payload, checksum: { algorithm: 'SHA-256', value: await digest(payload) } };
+}
+
+/** Append a verified, immutable pre-write copy. No empty copies or automatic expiry. */
+export async function preserveBeforeInitialization(
+  storage: SaveBackupStorage,
+  scope: SaveBackupScope,
+): Promise<string | null> {
+  const archive = await captureSaveBackup(storage, scope, 'before-initialization');
+  if (archive.payload.records.length === 0) return null;
+  // Reopening an unchanged game must not fill the quota with identical copies.
+  // Invalid older copies remain untouched; a new verified copy may still be made.
+  for (const existingKey of (await storage.keys()).filter((key) => isPreservedKey(key, scope))) {
+    const previous = await storage.getItem(existingKey);
+    try {
+      const verified = await verifySaveBackup(previous, preservedScope(existingKey, previous, scope), true);
+      if (canonical(verified.payload.records) === canonical(archive.payload.records)) return existingKey;
+    } catch {
+      // Do not repair, replace or remove a previously retained copy.
+    }
+  }
+  const key = `${backupPrefix(scope)}${crypto.randomUUID()}`;
+  if ((await storage.keys()).includes(key)) throw new Error('备份副本键已存在；未覆盖任何内容。');
+  await storage.setItem(key, archive);
+  const persisted = await verifySaveBackup(await storage.getItem(key), scope, true);
+  if (persisted.checksum.value !== archive.checksum.value) throw new Error('备份写入后校验失败；初始化已中止。');
+  return key;
+}
