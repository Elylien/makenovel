+/** Rendering a slot preview must not assume the persisted payload has already passed restore validation. */
+export function canPreviewSave(value: unknown): boolean {
+  if (!value || typeof value !== 'object') return false;
+  const save = value as Record<string, unknown>;
+  if (!save.nowStageState || typeof save.nowStageState !== 'object') return false;
+  const stage = save.nowStageState as Record<string, unknown>;
+  return (
+    typeof save.index === 'number' &&
+    Number.isSafeInteger(save.index) &&
+    typeof save.saveTime === 'string' &&
+    typeof save.previewImage === 'string' &&
+    typeof stage.showName === 'string' &&
+    typeof stage.showText === 'string'
+  );
+}
