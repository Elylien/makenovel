+async function loadImageTexture(texture: Texture): Promise<void> {
+  const baseTexture = texture.baseTexture;
+  const resource = baseTexture.resource;
+  if (!(resource instanceof SVGResource)) {
+    await resource.load();
+    return;
+  }
+  await new Promise<void>((resolve, reject) => {
+    let settled = false;
+    const settle = (failed: boolean, error?: unknown) => {
+      if (settled) return;
+      settled = true;
+      baseTexture.off('error', onError);
+      if (failed) reject(error);
+      else resolve();
+    };
+    const onError = (_texture: BaseTexture, error: unknown) => settle(true, error);
+    baseTexture.on('error', onError);
+    try {
+      void resource.load().then(() => settle(false), (error) => settle(true, error));
+    } catch (error) {
+      settle(true, error);
+    }
+  });
