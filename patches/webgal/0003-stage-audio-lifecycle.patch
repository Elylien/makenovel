--- /dev/null
+++ b/packages/webgal/src/Core/controller/stage/pixi/stageExitLifecycle.ts
@@ -0,0 +1,35 @@
+import type PixiStage from './PixiController';
+import type { IStageObject } from './PixiController';
+
+type ExitStage = Pick<PixiStage, 'removeAnimation' | 'getStageObjByKey' | 'removeStageObjectByKey'>;
+const exits = new Set<() => void>();
+
+/** Temporary exit objects are not serialized stage state. Own their lifetime explicitly. */
+export function scheduleStageExit(stage: ExitStage, object: IStageObject, animationKey: string, duration: number) {
+  const key = object.key;
+  let finished = false;
+  const finish = () => {
+    if (finished) return;
+    finished = true;
+    clearTimeout(timer);
+    exits.delete(finish);
+    // A canceled/late callback must never delete a replacement with the same key.
+    if (stage.getStageObjByKey(key) !== object) return;
+    try {
+      stage.removeAnimation(animationKey);
+    } finally {
+      if (stage.getStageObjByKey(key) === object) stage.removeStageObjectByKey(key);
+    }
+  };
+  const timer = setTimeout(finish, Math.max(0, duration));
+  exits.add(finish);
+}
+
+export function hasPendingStageExits() {
+  return exits.size > 0;
+}
+
+/** Load/title/reset finish and remove all old exit objects before rebuilding a stage. */
+export function finishStageExits() {
+  for (const finish of [...exits]) finish();
+}
