+// Menus keep native animation/audio clocks running, but cannot consume dialogue.
+// A natural completion is remembered once and resumed after the last overlay closes.
+const isStoryCovered = () => {
+  const gui = webgalStore.getState().GUI;
+  return gui.showMenuPanel || gui.showBacklog || gui.showFlowchart || gui.showGlobalDialog ||
+    gui.showPanicOverlay || gui.showExtra;
+};
+
+type DeferredContinue = { epoch: number; scene: object; sentence: number };
+let deferredContinue: DeferredContinue | undefined;
+let unsubscribeContinue: (() => void) | undefined;
+
+export function hasDeferredStoryContinue() {
+  return deferredContinue !== undefined;
+}
+
+function cancelDeferredContinue() {
+  deferredContinue = undefined;
+  unsubscribeContinue?.();
+  unsubscribeContinue = undefined;
+}
+
+function deferContinue() {
+  const manager = WebGAL.sceneManager;
+  if (!deferredContinue) {
+    deferredContinue = {
+      epoch: manager.getSessionEpoch(),
+      scene: manager.sceneData.currentScene,
+      sentence: manager.sceneData.currentSentenceId,
+    };
+  }
+  if (unsubscribeContinue) return;
+  const resume = () => {
+    const pending = deferredContinue;
+    if (!pending) return;
+    if (webgalStore.getState().GUI.showTitle || !manager.isSessionCurrent(pending.epoch) ||
+      pending.scene !== manager.sceneData.currentScene || pending.sentence !== manager.sceneData.currentSentenceId) {
+      cancelDeferredContinue();
+      return;
+    }
+    if (isStoryCovered()) return;
+    // Redux subscribers run synchronously: wait until the entire GUI update is done.
+    // The identity check makes duplicate notifications and manual input harmless.
+    queueMicrotask(() => {
+      if (deferredContinue !== pending) return;
+      if (isStoryCovered()) return;
+      const valid = !webgalStore.getState().GUI.showTitle && manager.isSessionCurrent(pending.epoch) &&
+        pending.scene === manager.sceneData.currentScene && pending.sentence === manager.sceneData.currentSentenceId;
+      cancelDeferredContinue();
+      if (valid) continueSentence();
+    });
+  };
+  unsubscribeContinue = webgalStore.subscribe(resume);
+}
