index 0000000000000000000000000000000000000000..f4d2a68898c7785617504d79a675c92152d9ca8e
--- /dev/null
+++ b/packages/webgal/src/Core/gameScripts/vocal/mediaElementSource.ts
@@ -0,0 +1,17 @@
+// A media element can only be associated with one source node per AudioContext,
+// including after that node was disconnected while another voice was playing.
+const sources = new WeakMap<AudioContext, WeakMap<HTMLMediaElement, MediaElementAudioSourceNode>>();
+
+export function getMediaElementSource(context: AudioContext, element: HTMLMediaElement) {
+  let elements = sources.get(context);
+  if (!elements) {
+    elements = new WeakMap();
+    sources.set(context, elements);
+  }
+  let source = elements.get(element);
+  if (!source) {
+    source = context.createMediaElementSource(element);
+    elements.set(element, source);
+  }
+  return source;
+}
