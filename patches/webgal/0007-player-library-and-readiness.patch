index 0000000000000000000000000000000000000000..af5258d3f664b1d878b1fbf62b364c58d78f5373
--- /dev/null
+++ b/packages/webgal/src/UI/Favorites/useFavorites.ts
@@ -0,0 +1,102 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import type { IBacklogItem } from '@/Core/Modules/backlog';
+import {
+  favoriteBacklog, favoriteIdForBacklog, loadFavorites, removeFavorite, subscribeFavorites,
+  type FavoriteEntry,
+} from '@/Core/controller/storage/makenovelFavorites';
+import {
+  getSaveStatus, getSaveStorageEpoch, isSaveStorageEnabled, subscribeSaveStatus,
+} from '@/Core/controller/storage/makenovelCompatibility';
+import { WebGAL } from '@/Core/WebGAL';
+
+export const favoriteContext = () => `${WebGAL.gameKey}:${getSaveStorageEpoch()}:${isSaveStorageEnabled()}`;
+
+export function useFavorites(open: boolean) {
+  const [entries, setEntries] = useState<FavoriteEntry[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [available, setAvailable] = useState(false);
+  const request = useRef(0);
+  const locked = useRef(false);
+  const mounted = useRef(false);
+
+  const refresh = useCallback(async () => {
+    const token = ++request.current;
+    const context = favoriteContext();
+    setLoading(true);
+    setError('');
+    try {
+      const next = await loadFavorites();
+      if (!mounted.current || token !== request.current || context !== favoriteContext()) return;
+      setEntries(next);
+      setAvailable(true);
+    } catch (cause) {
+      if (!mounted.current || token !== request.current || context !== favoriteContext()) return;
+      setAvailable(false);
+      setError(cause instanceof Error ? cause.message : '收藏读取失败；原数据未被替换。');
+    } finally {
+      if (mounted.current && token === request.current) setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (!open) return;
+    mounted.current = true;
+    let context = favoriteContext();
+    const checkContext = () => {
+      if (context === favoriteContext()) return;
+      context = favoriteContext();
+      ++request.current;
+      setEntries([]);
+      setAvailable(false);
+      setNotice('');
+      void refresh();
+    };
+    const unsubscribe = subscribeSaveStatus(checkContext);
+    const unsubscribeFavorites = subscribeFavorites(() => {
+      if (!locked.current) void refresh();
+    });
+    void refresh();
+    return () => {
+      mounted.current = false;
+      ++request.current;
+      unsubscribe();
+      unsubscribeFavorites();
+    };
+  }, [open, refresh]);
+
+  const mutate = useCallback(async (operation: () => Promise<FavoriteEntry[]>, message: string) => {
+    if (!mounted.current || locked.current) return;
+    locked.current = true;
+    setBusy(true);
+    setError('');
+    setNotice('');
+    const token = ++request.current;
+    const context = favoriteContext();
+    try {
+      const next = await operation();
+      if (!mounted.current || token !== request.current || context !== favoriteContext()) return;
+      setEntries(next);
+      setAvailable(true);
+      setNotice(message);
+    } catch (cause) {
+      if (!mounted.current || token !== request.current || context !== favoriteContext()) return;
+      setError(cause instanceof Error ? cause.message : '收藏保存失败；原数据未被替换。');
+    } finally {
+      locked.current = false;
+      if (mounted.current) setBusy(false);
+    }
+  }, []);
+
+  const toggle = (item: IBacklogItem) => {
+    const id = favoriteIdForBacklog(item, entries);
+    return mutate(() => id ? removeFavorite(id) : favoriteBacklog(item), id ? '已取消收藏。' : '已收藏。');
+  };
+  const remove = (id: string) => mutate(() => removeFavorite(id), '已取消收藏。');
+  const preview = getSaveStatus().preview;
+  return { entries, loading, busy, error, notice, available: available && !preview, refresh, toggle, remove };
+}
+
+export type FavoritesController = ReturnType<typeof useFavorites>;
