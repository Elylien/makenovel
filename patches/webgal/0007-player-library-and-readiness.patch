+  if (!value || value.includes('\\')) throw new Error('收藏引用的作品路径无效。');
+  const root = new URL('.', document.baseURI);
+  const url = new URL(value, root);
+  if (url.protocol !== root.protocol || url.origin !== root.origin || url.host !== root.host || url.search || url.hash ||
