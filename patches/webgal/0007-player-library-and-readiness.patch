+  }
+  const id = ids.get(index);
+  const mentions = Array.from(raw.matchAll(/@makenovel-node ([A-Za-z][A-Za-z0-9._:-]{0,95})(?=\s|$)/g));
+  return id && [...ids.values()].filter(value => value === id).length === 1 &&
+    mentions.filter(match => match[1] === id).length === 1 ? id : undefined;
+}
+async function createEntry(item: IBacklogItem, context: Context): Promise<FavoriteEntry> {
+  if (!sameMeta(item.makenovel, context.meta)) throw new Error('历史对白来自其他版本或作者预览，不能写入当前收藏。');
+  const value = projection(item);
+  const { rawScene } = await assertCompatibleSnapshot({
+    makenovel: item.makenovel, nowStageState: item.currentStageState, sceneData: item.saveScene, backlog: [],
+  });
+  assertContext(context);
+  // Native parser only: no prefetch, command execution, variable changes, seek or restore.
+  const parser = new SceneParser(undefined, assetSetter, ADD_NEXT_ARG_LIST, SCRIPT_CONFIG);
+  const scene = parser.parse(rawScene, item.saveScene.sceneName, item.saveScene.sceneUrl);
+  const sentence = scene.sentenceList[value.sentenceIndex];
+  if (!sentence || sentence.command !== commandType.say || sentence.isLineBreakHolder) {
+    throw new Error('历史对白的位置已失效；没有按相同文字猜测收藏身份。');
+  }
+  const nodeId = sourceNodeId(rawScene, scene.sentenceList, value.sentenceIndex);
+  const identity = nodeId ? 'node' : 'revision-position';
+  const id = await sha256(new TextEncoder().encode(JSON.stringify([
+    context.namespace, value.sceneUrl, nodeId ?? value.sentenceIndex, value.speaker, value.text,
+    value.voice, value.voiceUnavailable ?? '',
+  ])));
+  assertContext(context);
+  return { id, identity, ...(nodeId ? { nodeId } : {}), ...value, createdAt: new Date().toISOString(), manifestHash: context.meta.manifestHash };
+}
+export function loadFavorites(): Promise<FavoriteEntry[]> {
+  return observed(async () => { const context = captureContext(); return enqueue(context, () => read(context)); });
+}
+export function favoriteBacklog(item: IBacklogItem): Promise<FavoriteEntry[]> {
+  return observed(async () => {
+    const context = captureContext();
+    const snapshot = cloneDeep(item);
+    return enqueue(context, async () => {
+      const entries = await read(context);
+      const entry = await createEntry(snapshot, context);
+      if (entries.some(value => value.id === entry.id)) return entries;
+      if (entries.length >= MAX_ENTRIES) throw new Error('收藏已达2000条，请先导出备份并移除不需要的条目。');
+      return write(context, [...entries, entry]);
+    });
+  });
+}
+export function removeFavorite(id: string): Promise<FavoriteEntry[]> {
+  return observed(async () => {
+    const context = captureContext();
+    if (typeof id !== 'string' || !HASH.test(id)) throw new Error('收藏条目标识无效。');
+    return enqueue(context, async () => {
+      const entries = await read(context);
+      const remaining = entries.filter(entry => entry.id !== id);
+      return remaining.length === entries.length ? entries : write(context, remaining);
+    });
+  });
+}
+export function clearFavorites(): Promise<FavoriteEntry[]> {
+  return observed(async () => {
+    const context = captureContext();
+    return enqueue(context, async () => {
+      const entries = await read(context);
+      return entries.length ? write(context, []) : entries;
+    });
+  });
+}
+
+/** The caller owns this object URL and must revoke it on stop/error/cancel. */
+export function verifyFavoriteVoice(entry: FavoriteEntry): Promise<string> {
+  return observed(async () => {
+    const context = captureContext();
+    const snapshot = cloneDeep(entry);
+    validateEnvelope({format:'makenovel-favorites',schemaVersion:1,namespace:context.namespace,entries:[snapshot]},context);
+    if (!snapshot.voice) throw new Error(snapshot.voiceUnavailable ?? '这条收藏没有语音。');
+    const path = decodeURIComponent(gamePath(snapshot.voice, 'vocal'));
+    const bytes = await readVerifiedVocalAsset(path);
+    assertContext(context);
+    const type: Record<string,string> = {wav:'audio/wav',ogg:'audio/ogg',mp3:'audio/mpeg',m4a:'audio/mp4',
+      aac:'audio/aac',flac:'audio/flac',opus:'audio/ogg',webm:'audio/webm'};
+    const extension = path.slice(path.lastIndexOf('.') + 1).toLowerCase();
+    return URL.createObjectURL(new Blob([bytes as BlobPart],{type:type[extension] ?? 'application/octet-stream'}));
+  });
+}
