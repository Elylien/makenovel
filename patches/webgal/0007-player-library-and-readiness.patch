+const NODE_ID = /^[A-Za-z][A-Za-z0-9._:-]{0,95}$/;
+const MARKER = /@makenovel-node ([A-Za-z][A-Za-z0-9._:-]{0,95})\s*$/;
+const MAX_ENTRIES = 2000;
+const MAX_CHARS = 8 * 1024 * 1024;
+const queues = new Map<string, Promise<unknown>>();
+const listeners = new Set<() => void>();
+
+export function subscribeFavorites(listener: () => void) {
+  listeners.add(listener);
+  return () => { listeners.delete(listener); };
+}
+function notify() {
+  listeners.forEach(listener => {
+    // A broken subscriber cannot turn an acknowledged storage write into a failure.
+    try { listener(); } catch { /* Its UI owner handles rendering errors independently. */ }
+  });
+}
+function sameMeta(left: SaveCompatibility | undefined, right: SaveCompatibility) {
+  return left && ['schemaVersion', 'projectId', 'gameKey', 'runtimeCompatibilityId', 'manifestHash']
+    .every(key => left[key as keyof SaveCompatibility] === right[key as keyof SaveCompatibility]);
+}
+function assertContext(context: Context) {
+  if (!isSaveStorageEnabled() || context.epoch !== getSaveStorageEpoch() || context.namespace !== WebGAL.gameKey ||
+      context.namespace !== `makenovel-v1:${context.meta.projectId}:${context.meta.manifestHash}` ||
+      !sameMeta(captureSaveCompatibility(), context.meta)) {
+    throw new Error(getSaveUnavailableMessage('收藏暂不可用，或作品版本/玩家存储会话已改变。原有收藏已保留。'));
+  }
+}
+function captureContext(): Context {
+  const meta = captureSaveCompatibility();
+  if (!meta) throw new Error(getSaveUnavailableMessage('作品尚未通过版本核对，暂不能读取或修改收藏。'));
+  const context = { namespace: WebGAL.gameKey, epoch: getSaveStorageEpoch(), meta };
+  assertContext(context);
+  return context;
+}
+function observed<T>(operation: () => Promise<T>): Promise<T> {
+  const promise = operation();
+  void promise.catch(reportSaveError);
+  return promise;
+}
+function enqueue<T>(context: Context, operation: () => Promise<T>): Promise<T> {
+  const key = `${context.namespace}-favorites`;
+  const next = (queues.get(key) ?? Promise.resolve()).catch(() => {}).then(async () => {
+    const run = async () => { assertContext(context); return operation(); };
+    // The same-origin Web Lock coordinates other tabs. Without it only read/no-op
+    // operations are allowed; write() explicitly refuses changes in older hosts.
+    if (typeof navigator !== 'undefined' && navigator.locks) {
+      return navigator.locks.request(`makenovel-favorites:${key}`, run);
+    }
