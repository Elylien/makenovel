+type ReadinessListener = () => void;
+const listeners = new Set<ReadinessListener>();
+
+/** Native lifecycle signals are hints only: consumers must recheck their own scope and save gate. */
+export function subscribeVisualReadiness(listener: ReadinessListener) {
+  listeners.add(listener);
+  return () => { listeners.delete(listener); };
+}
+
+export function notifyVisualReadiness() {
+  for (const listener of [...listeners]) listener();
+}
