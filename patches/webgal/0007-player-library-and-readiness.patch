+/** A text/voice snapshot, never a restorable scene or an executable script. */
+export interface FavoriteEntry {
+  id: string;
+  nodeId?: string;
+  identity: 'node' | 'revision-position';
+  sceneUrl: string;
+  sceneName: string;
+  sentenceIndex: number;
+  text: string;
