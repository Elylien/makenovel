+      !boundedString(item.currentStageState.showText, 32768) || !item.currentStageState.showText.trim() ||
+      !boundedString(item.currentStageState.showName, 1024) || !boundedString(item.currentStageState.vocal, 4096)) {
+    throw new Error('这条历史记录没有可收藏的完整对白。');
+  }
+  return {
+    sceneUrl: gamePath(item.saveScene.sceneUrl, 'scene'), sceneName: item.saveScene.sceneName,
+    sentenceIndex: item.saveScene.currentSentenceId - 1, text: item.currentStageState.showText,
+    speaker: item.currentStageState.showName, ...voiceSnapshot(item.currentStageState.vocal),
+  };
+}
+/** Match the rendered snapshot, not line number or text alone. No stable ID is invented. */
+export function favoriteIdForBacklog(item: IBacklogItem, entries: readonly FavoriteEntry[]): string | undefined {
+  try {
+    const meta = captureSaveCompatibility();
+    if (!meta || !sameMeta(item.makenovel, meta)) return undefined;
+    const value = projection(item);
+    return entries.find(entry => entry.manifestHash === meta.manifestHash &&
+      entry.sceneUrl === value.sceneUrl && entry.sentenceIndex === value.sentenceIndex &&
+      entry.text === value.text && entry.speaker === value.speaker && entry.voice === value.voice &&
+      entry.voiceUnavailable === value.voiceUnavailable)?.id;
+  } catch { return undefined; }
+}
+export function isBacklogFavorite(item: IBacklogItem, entries: readonly FavoriteEntry[]): boolean {
+  return favoriteIdForBacklog(item, entries) !== undefined;
+}
+function validateEnvelope(value: unknown, context: Context): FavoriteEntry[] {
+  const invalid = () => { throw new Error('收藏数据损坏、格式未知或版本不匹配；没有覆盖原数据，请先导出玩家备份。'); };
+  if (value === null) return [];
+  if (!plain(value) || !exact(value, ['format', 'schemaVersion', 'namespace', 'entries']) ||
+      value.format !== 'makenovel-favorites' || value.schemaVersion !== 1 || value.namespace !== context.namespace ||
+      !Array.isArray(value.entries) || value.entries.length > MAX_ENTRIES) return invalid();
+  const ids = new Set<string>();
+  for (const entry of Array.from(value.entries)) {
+    if (!plain(entry) || !exact(entry,
+      ['id', 'identity', 'sceneUrl', 'sceneName', 'sentenceIndex', 'text', 'speaker', 'voice', 'createdAt', 'manifestHash'],
+      ['nodeId', 'voiceUnavailable']) ||
+      typeof entry.id !== 'string' || !HASH.test(entry.id) || ids.has(entry.id) ||
+      (entry.identity !== 'node' && entry.identity !== 'revision-position') ||
+      (entry.identity === 'node' ? typeof entry.nodeId !== 'string' || !NODE_ID.test(entry.nodeId) : entry.nodeId !== undefined) ||
+      !boundedString(entry.sceneUrl, 4096) || !boundedString(entry.sceneName, 1024) ||
+      !Number.isSafeInteger(entry.sentenceIndex) || (entry.sentenceIndex as number) < 0 ||
+      !boundedString(entry.text, 32768) || !entry.text.trim() || !boundedString(entry.speaker, 1024) ||
+      !boundedString(entry.voice, 4096) ||
+      (entry.voiceUnavailable !== undefined && (!boundedString(entry.voiceUnavailable, 1024) || entry.voice !== '')) ||
+      !boundedString(entry.createdAt, 32) || !Number.isFinite(Date.parse(entry.createdAt)) ||
+      new Date(entry.createdAt).toISOString() !== entry.createdAt || entry.manifestHash !== context.meta.manifestHash) return invalid();
+    try {
+      if (gamePath(entry.sceneUrl, 'scene') !== entry.sceneUrl ||
+          (entry.voice && gamePath(entry.voice, 'vocal') !== entry.voice)) return invalid();
+    } catch { return invalid(); }
+    ids.add(entry.id);
+  }
+  if (JSON.stringify(value).length > MAX_CHARS) return invalid();
+  return cloneDeep(value.entries as FavoriteEntry[]);
+}
+async function read(context: Context): Promise<FavoriteEntry[]> {
+  assertContext(context);
+  const value = await localforage.getItem(`${context.namespace}-favorites`);
+  assertContext(context);
+  return validateEnvelope(value, context);
+}
+async function write(context: Context, entries: FavoriteEntry[]) {
+  const envelope: Envelope = { format: 'makenovel-favorites', schemaVersion: 1, namespace: context.namespace, entries };
+  validateEnvelope(envelope, context);
+  assertContext(context);
+  if (typeof navigator === 'undefined' || !navigator.locks) {
+    throw new Error('当前运行环境不支持安全的跨窗口收藏写入；收藏保持只读，原数据没有修改。');
+  }
+  await localforage.setItem(`${context.namespace}-favorites`, envelope);
+  // An already-started storage write cannot be rolled back after a preview/session change.
+  // Never announce success or inject its old context into the new UI session.
+  assertContext(context);
+  notify();
+  return cloneDeep(entries);
+}
