diff --git a/packages/webgal/src/UI/Favorites/Favorites.tsx b/packages/webgal/src/UI/Favorites/Favorites.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c4b84a79d372c2e29a28c7012724b805135a44f0
--- /dev/null
+++ b/packages/webgal/src/UI/Favorites/Favorites.tsx
@@ -0,0 +1,179 @@
+import { Fragment, useEffect, useMemo, useRef, useState } from 'react';
+import { webgalStore } from '@/store/store';
+import { subscribeSaveStatus } from '@/Core/controller/storage/makenovelCompatibility';
+import { verifyFavoriteVoice, type FavoriteEntry } from '@/Core/controller/storage/makenovelFavorites';
+import { WebGAL } from '@/Core/WebGAL';
+import { subscribeVisualReadiness } from '@/Core/Modules/visualReadiness';
+import { compileSentence } from '@/Stage/TextBox/TextBox';
+import { FavoriteVoicePlayer } from './favoriteVoice';
+import { favoriteContext, type FavoritesController } from './useFavorites';
+import styles from './favorites.module.scss';
+
+export function selectFavorites(entries: FavoriteEntry[], query: string, voiced: boolean, oldest: boolean) {
+  const needle = query.trim().toLocaleLowerCase();
+  return entries.filter((entry) => (!voiced || !!entry.voice) && (!needle ||
+    `${entry.speaker}\n${entry.text}\n${entry.sceneName}`.toLocaleLowerCase().includes(needle)))
+    .sort((a, b) => (oldest ? 1 : -1) * a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id));
+}
+
+function Snapshot({ text }: { text: string }) {
+  return <>{compileSentence(text, 3, true, false).map((line, index) =>
+    <div key={index}>{line.map((part, i) => <Fragment key={i}>{part.reactNode}</Fragment>)}</div>)}</>;
+}
+
+export function Favorites({ controller, active }: { controller: FavoritesController; active: boolean }) {
+  const [query, setQuery] = useState('');
+  const [voiced, setVoiced] = useState(false);
+  const [oldest, setOldest] = useState(false);
+  const [limit, setLimit] = useState(40);
+  const [playing, setPlaying] = useState('');
+  const [checking, setChecking] = useState('');
+  const [voiceError, setVoiceError] = useState('');
+  const player = useRef<FavoriteVoicePlayer>();
+  const auditionRequest = useRef(0);
+  const alive = useRef(false);
+  const isActive = useRef(active);
+  isActive.current = active;
+  const voiceContext = useRef<() => string>(() => '');
+  const shown = useMemo(() => selectFavorites(controller.entries, query, voiced, oldest),
+    [controller.entries, query, voiced, oldest]);
+
+  useEffect(() => {
+    let mounted = true;
+    alive.current = true;
+    let scene = WebGAL.sceneManager.sceneData.currentScene;
+    let sceneRevision = 0;
+    voiceContext.current = () => {
+      const current = WebGAL.sceneManager.sceneData.currentScene;
+      if (scene !== current) { scene = current; ++sceneRevision; }
+      return `${favoriteContext()}:${WebGAL.sceneManager.getSessionEpoch()}:${sceneRevision}:${WebGAL.sceneManager.lockSceneWrite}`;
+    };
+    const voice = new FavoriteVoicePlayer({
+      createAudio: (url) => new Audio(url),
+      releaseAudioUrl: (url) => URL.revokeObjectURL(url),
+      currentVoice: () => document.getElementById('currentVocal') as HTMLAudioElement | null,
+      stopHistory: () => document.querySelectorAll<HTMLAudioElement>('[id^="backlog_audio_play_element_"]').forEach((audio) => {
+        audio.pause();
+        audio.currentTime = 0;
+      }),
+      volume: () => {
+        const options = webgalStore.getState().userData.optionData;
+        return options.volumeMain * options.vocalVolume / 10000;
+      },
+      context: () => voiceContext.current(),
+      onState: (id, error) => { if (mounted) { setPlaying(id); setVoiceError(error); } },
+    });
+    player.current = voice;
+    let context = voiceContext.current();
+    const checkContext = () => {
+      if (context === voiceContext.current()) return;
+      context = voiceContext.current();
+      ++auditionRequest.current;
+      voice.dispose();
+      setPlaying('');
+      setChecking('');
+      setVoiceError('');
+    };
+    const unsubscribe = subscribeSaveStatus(checkContext);
+    const unsubscribeReadiness = subscribeVisualReadiness(checkContext);
+    const stopOnBlur = () => { ++auditionRequest.current; setChecking(''); voice.stop(); };
+    const stopOnHidden = () => { if (document.hidden) stopOnBlur(); };
+    const stopOnNativeVoice = (event: Event) => {
+      if ((event.target as HTMLElement | null)?.id === 'currentVocal') stopOnBlur();
+    };
+    document.addEventListener('visibilitychange', stopOnHidden);
+    document.addEventListener('play', stopOnNativeVoice, true);
+    window.addEventListener('blur', stopOnBlur);
+    return () => {
+      mounted = false;
+      alive.current = false;
+      ++auditionRequest.current;
+      unsubscribe();
+      unsubscribeReadiness();
+      document.removeEventListener('visibilitychange', stopOnHidden);
+      document.removeEventListener('play', stopOnNativeVoice, true);
+      window.removeEventListener('blur', stopOnBlur);
+      voice.dispose();
+      player.current = undefined;
+    };
+  }, []);
+
+  useEffect(() => { if (!active) { ++auditionRequest.current; setChecking(''); player.current?.stop(); } }, [active]);
+  useEffect(() => {
+    if ((playing && !shown.some((entry) => entry.id === playing)) || (checking && !shown.some((entry) => entry.id === checking))) {
+      ++auditionRequest.current; setChecking(''); player.current?.stop();
+    }
+  }, [shown, playing, checking]);
+  useEffect(() => { setLimit(40); }, [query, voiced, oldest]);
+
+  const audition = async (entry: FavoriteEntry) => {
+    const request = ++auditionRequest.current;
+    player.current?.stop();
+    if (playing === entry.id || checking === entry.id) { setChecking(''); return; }
+    const context = voiceContext.current();
+    const current = () => alive.current && isActive.current && request === auditionRequest.current && context === voiceContext.current();
+    setChecking(entry.id);
+    setVoiceError('');
+    try {
+      const url = await verifyFavoriteVoice(entry);
+      if (!current()) { URL.revokeObjectURL(url); return; }
+      await player.current?.play(entry.id, url);
+    } catch (cause) {
+      if (current()) setVoiceError(cause instanceof Error ? cause.message : '语音核验失败，文本收藏仍保留。');
+    } finally { if (current()) setChecking(''); }
+  };
+
+  return <section className={styles.panel} aria-label="收藏列表"
+    onKeyDown={(event) => {
+      // Let the parent history overlay handle Escape outside an editable control.
+      if (event.key === 'Escape' && !event.nativeEvent.isComposing && event.nativeEvent.keyCode !== 229 &&
+        !(event.target as HTMLElement).closest('input, textarea, select, [contenteditable="true"]')) return;
+      event.stopPropagation();
+    }} onKeyUp={(event) => event.stopPropagation()}
+    onClick={(event) => event.stopPropagation()} onDoubleClick={(event) => event.stopPropagation()}>
+    <div className={styles.tools}>
+      <label className={styles.search}>搜索收藏
+        <input type="search" value={query} placeholder="台词、角色或场景"
+          onChange={(event) => setQuery(event.target.value)} />
+      </label>
+      <label className={styles.filter}><input type="checkbox" checked={voiced}
+        onChange={(event) => setVoiced(event.target.checked)} />仅有语音</label>
+      <label className={styles.sort}>排列
+        <select value={oldest ? 'oldest' : 'newest'} onChange={(event) => setOldest(event.target.value === 'oldest')}>
+          <option value="newest">最近收藏优先</option><option value="oldest">最早收藏优先</option>
+        </select>
+      </label>
+    </div>
+    <div className={styles.description}>收藏保留当前版本的台词与语音，不随读档回退。试听期间剧情语音静音并继续播放，停止后恢复声音。</div>
+    <div className={styles.status} role="status" aria-live="polite">
+      {controller.loading ? '正在读取收藏…' : controller.busy ? '正在保存…' : !controller.available ? '收藏暂时不可用' : controller.notice || `共 ${shown.length} 条收藏`}
+    </div>
+    {controller.error && <div role="alert" className={styles.error}>{controller.error}
+      <button type="button" onClick={() => void controller.refresh()} disabled={controller.loading || controller.busy}>重新读取</button>
+    </div>}
+    {voiceError && <div role="alert" className={styles.error}>{voiceError}</div>}
+    <div className={styles.list}>
+      {controller.available && !controller.loading && shown.length === 0 &&
+        <div className={styles.empty}>{query || voiced ? '没有符合筛选条件的收藏。' : '还没有收藏。在历史记录中点击“收藏”即可保存喜欢的台词。'}</div>}
+      {controller.available && shown.slice(0, limit).map((entry) => <article key={entry.id} className={styles.card}>
+        <header><strong><Snapshot text={entry.speaker || '旁白'} /></strong><span>{entry.sceneName}</span></header>
+        <div className={styles.text}><Snapshot text={entry.text} /></div>
+        {entry.voiceUnavailable && <div className={styles.description}>{entry.voiceUnavailable}</div>}
+        {entry.identity === 'revision-position' && <div className={styles.description}
+          title="未登记稳定台词身份，收藏按当前版本的场景位置保存，不推断其他修订中的对应台词。">此台词仅按当前版本位置保存。</div>}
+        <footer>
+          <span>{new Date(entry.createdAt).toLocaleString()} · {entry.voice ? '有语音' : '纯文本'}</span>
+          <div className={styles.actions}>
+            {entry.voice && <button type="button" disabled={!active || controller.busy || controller.loading}
+              aria-pressed={playing === entry.id} onClick={() => void audition(entry)}>
+              {playing === entry.id ? '停止试听' : checking === entry.id ? '取消载入' : '试听语音'}</button>}
+            <button type="button" disabled={controller.busy || controller.loading}
+              onClick={() => void controller.remove(entry.id)} aria-label={`取消收藏：${entry.speaker || '旁白'}`}>取消收藏</button>
+          </div>
+        </footer>
+      </article>)}
+      {controller.available && shown.length > limit && <button className={styles.more} type="button"
+        onClick={() => setLimit((value) => value + 40)}>显示更多（剩余 {shown.length - limit} 条）</button>}
+    </div>
+  </section>;
+}
diff --git a/packages/webgal/src/UI/Favorites/favoriteVoice.ts b/packages/webgal/src/UI/Favorites/favoriteVoice.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2313303503ed27bc580b9432f1061c42d8792633
--- /dev/null
+++ b/packages/webgal/src/UI/Favorites/favoriteVoice.ts
@@ -0,0 +1,83 @@
+type VoiceEnvironment = {
+  createAudio: (url: string) => HTMLAudioElement;
+  releaseAudioUrl: (url: string) => void;
+  currentVoice: () => HTMLAudioElement | null;
+  stopHistory: () => void;
+  volume: () => number;
+  context: () => string;
+  onState: (id: string, error: string) => void;
+};
+
+/** Audition owns only its media element and a temporary mute on the current
+ * voice. Native timing, performs and scene state are never paused or changed. */
+export class FavoriteVoicePlayer {
+  private generation = 0;
+  private active?: HTMLAudioElement;
+  private activeUrl?: string;
+  private muted?: { media: HTMLAudioElement; original: boolean };
+
+  constructor(private readonly env: VoiceEnvironment) {}
+
+  async play(id: string, url: string): Promise<void> {
+    this.stop(false, false);
+    const generation = this.generation;
+    const context = this.env.context();
+    const media = this.env.currentVoice();
+    if (media !== this.muted?.media) {
+      this.releaseMute();
+      if (media) { this.muted = { media, original: media.muted }; media.muted = true; }
+    }
+    this.env.stopHistory();
+    this.activeUrl = url;
+    let audio: HTMLAudioElement;
+    try { audio = this.env.createAudio(url); }
+    catch {
+      this.stop();
+      this.env.onState('', '语音无法载入。文本收藏仍保留。');
+      return;
+    }
+    this.active = audio;
+    audio.volume = Math.max(0, Math.min(1, this.env.volume()));
+    const current = () => this.active === audio && this.generation === generation && this.env.context() === context;
+    audio.onended = () => { if (current()) this.stop(); };
+    audio.onerror = () => {
+      if (!current()) return;
+      this.stop();
+      this.env.onState('', '这条收藏的语音无法播放，文件可能缺失或格式不支持。文本收藏仍保留。');
+    };
+    this.env.onState(id, '');
+    try {
+      await audio.play();
+      if (!current()) audio.pause();
+    } catch {
+      if (!current()) return;
+      this.stop();
+      this.env.onState('', '语音播放失败，请检查资源或再次点击试听。文本收藏仍保留。');
+    }
+  }
+
+  private releaseMute() {
+    if (!this.muted) return;
+    this.muted.media.muted = this.muted.original;
+    this.muted = undefined;
+  }
+
+  stop(releaseVoice = true, notify = true): void {
+    ++this.generation;
+    const audio = this.active;
+    this.active = undefined;
+    if (audio) {
+      audio.onended = null;
+      audio.onerror = null;
+      audio.pause();
+      audio.removeAttribute('src');
+      audio.load();
+    }
+    if (this.activeUrl) this.env.releaseAudioUrl(this.activeUrl);
+    this.activeUrl = undefined;
+    if (releaseVoice) this.releaseMute();
+    if (notify) this.env.onState('', '');
+  }
+
+  dispose(): void { this.stop(true, false); }
+}
