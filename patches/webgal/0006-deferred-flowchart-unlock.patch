+/** Read-only visual gate shared by explicit saves and first-scene flowchart unlocks. */
+export function getVisualSnapshotReadiness(): VisualSnapshotReadiness {
+  const stageState = stageStateManager.getCalculationStageState();
+  if (hasDeferredStoryContinue() || hasPendingStageExits() || stageState.PerformList.some((perform) => !perform.isHoldOn && unstableSaveCommands.has(perform.script.command))) {
+    return { ready: false, transient: true,
+      message: '当前演出尚未结束或正在等待继续，请返回剧情，在演出结束后的对白处保存。此次没有覆盖存档。' };
