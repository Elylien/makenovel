+      let valueStart = equal + 1;
+      while (valueStart < token.raw.length && token.raw[valueStart].trim() === '') valueStart += 1;
+      addChange(token.start + valueStart, token.end, encoded);
+    }
+  }
+  if (additions.length) addChange(originalParts.insertAt, originalParts.insertAt, additions.join(''));
+  const result = applySourceChanges(source, changes);
+  const afterScene = parseNative(result.source);
+  if (afterScene.length !== originalScene.length) fail('UNSAFE_NATIVE_PROJECTION', '局部修改改变了原生语句边界，请使用源码模式。');
+  for (let index = 0; index < originalScene.length; index += 1) {
+    const before = originalScene[index];
+    const after = afterScene[index];
+    if (before.startLine === node.startLine) {
+      if (after.command !== desired.command || after.content !== desired.content || normalizedArgs(after) !== normalizedArgs(desired)
+          || after.startLine !== before.startLine || after.endLine !== before.endLine || after.inlineComment !== before.inlineComment) {
+        fail('UNSAFE_NATIVE_PROJECTION', '无法在保留源码格式的同时实现这次图形修改，请使用源码模式。');
+      }
+    } else if (JSON.stringify(before) !== JSON.stringify(after)) {
+      fail('UNSAFE_NATIVE_PROJECTION', '这次修改影响了相邻语句，请使用源码模式。');
+    }
+  }
+  return result;
+}
