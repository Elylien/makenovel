+  if (statement.startsWith('\uFEFF')) fail('INVALID_INSERT_STATEMENT', '新语句不能携带文件 BOM。');
+  scanLines(statement);
+  const normalized = statement.replace(/\r?\n/g, neighboringEol);
+  const statementRanges = parseNative(normalized);
+  const incoming = checkedIdentity(normalized, statementRanges);
+  if (incoming.nodes.length !== 1 || incoming.nodes[0].nodeId) {
+    fail('INVALID_INSERT_STATEMENT', '一次只能插入一条尚未登记身份的原生命令；复制节点请使用复制操作。');
+  }
+  const occupied = new Set(existing.nodes.map(node => node.nodeId).filter((id): id is string => !!id));
+  const nodeId = freshId(factory, occupied);
+  const registered = assignMissingNodeIds(normalized, statementRanges, () => nodeId).source;
+  const inserted = insertBlock(source, offset, registered, neighboringEol);
+  const result = applySourceChanges(source, [{ start: offset, end: offset, before: '', after: inserted }]);
+  const after = checkedIdentity(result.source, parseNative(result.source));
+  if (after.nodes.length !== existing.nodes.length + 1 || !after.nodes.some(node => node.nodeId === nodeId)
+      || existing.nodes.some(node => node.nodeId && !after.nodes.some(candidate => candidate.nodeId === node.nodeId))) {
+    fail('UNSAFE_INSERT_BOUNDARY', '插入会改变相邻命令的续行或身份，请在源码模式处理。');
+  }
+  return { ...result, nodeId };
+}
+
+/** Move before another stable node; null places it at the end. Comments inside the block move with it. */
+export function moveNode(source: string, ranges: readonly NativeSentenceRange[], nodeId: string, beforeNodeId: string | null): SourceEditResult {
+  const identity = checkedIdentity(source, ranges);
+  const node = requireNode(identity, nodeId);
+  assertClosedBlock(source, node);
+  const before = beforeNodeId === null ? undefined : requireNode(identity, beforeNodeId);
+  if (before?.nodeId === nodeId || before?.blockStart === node.blockEnd || (!before && node.blockEnd === source.length)) return { source, changes: [] };
+  const block = source.slice(node.blockStart, node.blockEnd);
+  const without = source.slice(0, node.blockStart) + source.slice(node.blockEnd);
+  const oldOffset = before ? before.blockStart : source.length;
+  const offset = oldOffset > node.blockStart ? oldOffset - block.length : oldOffset;
+  const eol = scanLines(source).find(line => line.eol)?.eol ?? '\n';
+  const inserted = insertBlock(without, offset, block, eol);
+  return applySourceChanges(source, [
+    { start: node.blockStart, end: node.blockEnd, before: block, after: '' },
+    { start: oldOffset, end: oldOffset, before: '', after: inserted },
+  ]);
+}
+
+/** Copy immediately after a node. A fresh explicit identity replaces the copied marker. */
+export function duplicateNode(source: string, ranges: readonly NativeSentenceRange[], nodeId: string, factory: () => string): SourceEditResult & { nodeId: string } {
+  const identity = checkedIdentity(source, ranges);
+  const node = requireNode(identity, nodeId);
+  assertClosedBlock(source, node);
+  const newId = freshId(factory, new Set(identity.nodes.map(item => item.nodeId as string)));
+  const block = source.slice(node.blockStart, node.blockEnd);
+  if (node.markerStart === undefined || node.markerEnd === undefined) fail('ID_NOT_FOUND', '身份标记的源范围已失效。');
+  const copy = block.slice(0, node.markerStart - node.blockStart) + `${markerPrefix} ${newId}` + block.slice(node.markerEnd - node.blockStart);
+  const eol = scanLines(source).find(line => line.eol)?.eol ?? '\n';
+  const inserted = insertBlock(source, node.blockEnd, copy, eol);
+  return { ...applySourceChanges(source, [{ start: node.blockEnd, end: node.blockEnd, before: '', after: inserted }]), nodeId: newId };
+}
+
+/** Detect identity changes across explicit source revisions; never remap by text or row. */
+export function compareSceneIdentities(before: SceneIdentity, after: SceneIdentity): { removed: string[]; added: string[]; retained: string[] } {
+  const previous = new Set(before.nodes.map(node => node.nodeId).filter((id): id is string => !!id));
+  const current = new Set(after.nodes.map(node => node.nodeId).filter((id): id is string => !!id));
+  return {
+    removed: [...previous].filter(id => !current.has(id)),
+    added: [...current].filter(id => !previous.has(id)),
+    retained: [...previous].filter(id => current.has(id)),
+  };
+}
