+
+  it('keeps native bindings with their DLLs outside ASAR and preserves game bytes', async () => {
+    const appDir = join(root, 'app');
+    const archive = join(root, 'app.asar');
+    const nativeDir = join('node_modules', 'steamworks.js', 'dist', 'win64');
+    const binding = join(nativeDir, 'steamworksjs.win32-x64-msvc.node');
+    const dll = join(nativeDir, 'steam_api64.dll');
+    const scene = join('public', 'game', 'scene', '中文 场景.txt');
+    const fixture = Buffer.from('\ufeff; preserve\r\nsay:离线打包验证;\r\n');
+    await fs.mkdir(join(appDir, nativeDir), { recursive: true });
+    await fs.mkdir(join(appDir, 'public', 'game', 'scene'), {
+      recursive: true,
+    });
+    await fs.writeFile(join(appDir, binding), Buffer.from([0x4d, 0x5a, 1, 2]));
+    await fs.writeFile(join(appDir, dll), Buffer.from([0x4d, 0x5a, 3, 4]));
+    await fs.writeFile(join(appDir, scene), fixture);
+    await fs.writeFile(join(appDir, 'main.js'), 'console.log("fixture");\n');
+    const logger = new ConsoleLogger('AsarTest', { logLevels: [] });
+    const service = new ManageGameService(logger, new WebgalFsService(logger));
+
+    await service['packElectronAppAsar'](appDir, archive);
+
+    expect(asar.statFile(archive, binding)).toMatchObject({ unpacked: true });
+    expect(asar.statFile(archive, dll)).toMatchObject({ unpacked: true });
+    expect(await fs.readFile(join(`${archive}.unpacked`, binding))).toEqual(
+      Buffer.from([0x4d, 0x5a, 1, 2]),
+    );
+    expect(await fs.readFile(join(`${archive}.unpacked`, dll))).toEqual(
+      Buffer.from([0x4d, 0x5a, 3, 4]),
+    );
+    expect(asar.extractFile(archive, scene)).toEqual(fixture);
+    expect(asar.statFile(archive, scene)).not.toMatchObject({ unpacked: true });
+    await expect(fs.access(appDir)).rejects.toMatchObject({ code: 'ENOENT' });
+  });
+});
