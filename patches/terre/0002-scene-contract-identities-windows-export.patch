+import { ConsoleLogger } from '@nestjs/common';
+import * as fs from 'fs/promises';
+import { tmpdir } from 'os';
+import { basename, dirname, join } from 'path';
+import { UserDataService } from '../user-data/user-data.service';
+import { WebgalFsService } from '../webgal-fs/webgal-fs.service';
+import { ManageGameController } from '../manage-game/manage-game.controller';
+
+describe('scene validation before real transactional save', () => {
+  const game = '中文作品';
+  const scene = 'game/scene/中文剧本.txt';
+  const original =
+    '\uFEFF;保留\r\nfuturePlugin:opaque -custom=keep; untouched\r\nsay:旧对白;\r\n';
+  let root: string;
+  let target: string;
+  let service: WebgalFsService;
+
+  beforeEach(async () => {
+    root = await fs.mkdtemp(join(tmpdir(), 'makenovel-scene-validation-'));
+    target = join(root, game, scene);
+    await fs.mkdir(dirname(target), { recursive: true });
+    await fs.writeFile(target, original, 'utf8');
+    jest.spyOn(UserDataService, 'getGameRoot').mockReturnValue(root);
+    jest
+      .spyOn(UserDataService, 'isPathInsideAllowedRoots')
+      .mockImplementation((path) => path.startsWith(root));
+    service = new WebgalFsService(new ConsoleLogger());
+  });
+  afterEach(async () => {
+    jest.restoreAllMocks();
+    await fs.rm(root, { recursive: true, force: true });
+  });
+
+  it('analyzes through the controller without touching disk', async () => {
+    const controller = new ManageGameController(
+      service,
+      undefined,
+      new ConsoleLogger(),
+    );
+    const analysis = await controller.validateSceneSnapshot({
+      text: 'setTransform:{"x":',
+    });
+    expect(analysis).toMatchObject({ valid: false, previewable: false });
+    expect(await fs.readFile(target, 'utf8')).toBe(original);
+  });
+
+  it.each([
+    'setTransform:{"x":',
+    'wait:NaN;',
+    'say:unfinished\\',
+    'say:a; @makenovel-node duplicate\nsay:b; @makenovel-node duplicate',
+  ])(
+    'rejects invalid core source with 422, retaining bytes and leaving no temporary file: %s',
+    async (text) => {
+      const previous = await service.readTextSnapshot(game, scene);
+      await expect(
+        service.saveTextSnapshot(game, scene, text, previous.revision),
+      ).rejects.toMatchObject({
+        status: 422,
+        response: {
+          code: 'SCENE_VALIDATION_FAILED',
+          analysis: { valid: false, previewable: false },
+        },
+      });
+      expect(await fs.readFile(target)).toEqual(Buffer.from(original, 'utf8'));
+      expect(await fs.readdir(dirname(target))).toEqual([basename(target)]);
+    },
+  );
+
+  it('allows a graphical neighbor change while retaining unknown source exactly', async () => {
+    const previous = await service.readTextSnapshot(game, scene);
+    const changed = original.replace('旧对白', '新对白');
+    const saved = await service.saveTextSnapshot(
+      game,
+      scene,
+      changed,
+      previous.revision,
+    );
+    expect(saved.text).toBe(changed);
+    expect(await fs.readFile(target)).toEqual(Buffer.from(changed, 'utf8'));
+    expect(service.validateSceneSnapshot(saved.text)).toMatchObject({
+      valid: true,
+      previewable: false,
+      hasAdvanced: true,
+    });
+  });
+
+  it.each([
+    original.replace('opaque', 'changed'),
+    original + 'newPlugin:hello;\r\n',
+    original + '凛:新对白;\r\n',
+  ])(
+    'keeps added or changed advanced code as an unapplied draft',
+    async (text) => {
+      const previous = await service.readTextSnapshot(game, scene);
+      await expect(
+        service.saveTextSnapshot(game, scene, text, previous.revision),
+      ).rejects.toMatchObject({
+        status: 422,
+        response: {
+          code: 'ADVANCED_CODE_REQUIRES_REVIEW',
+          analysis: { valid: true, previewable: false },
+        },
+      });
+      expect(await fs.readFile(target, 'utf8')).toBe(original);
+    },
+  );
+
+  it('permits an explicit speaker conversion and preserves transactional conflicts', async () => {
+    const previous = await service.readTextSnapshot(game, scene);
+    const converted = 'say:明确的角色对白 -speaker=凛;\r\n';
+    await service.saveTextSnapshot(game, scene, converted, previous.revision);
+    expect(service.validateSceneSnapshot(converted)).toMatchObject({
+      valid: true,
+      previewable: true,
+      hasAdvanced: false,
+    });
+    await expect(
+      service.saveTextSnapshot(game, scene, 'future:new;', previous.revision),
+    ).rejects.toMatchObject({
+      status: 409,
+      response: { code: 'REVISION_CONFLICT' },
+    });
+    expect(await fs.readFile(target, 'utf8')).toBe(converted);
+  });
+
+  it('does not parse config or JSON assets as scene scripts', async () => {
+    const asset = 'game/config.txt';
+    const file = join(root, game, asset);
+    await fs.writeFile(file, 'Game_name:old;');
+    const previous = await service.readTextSnapshot(game, asset);
+    await service.saveTextSnapshot(
+      game,
+      asset,
+      'Game_name:new;\r\nArbitraryAsset:{',
+      previous.revision,
+    );
+    expect(await fs.readFile(file, 'utf8')).toBe(
+      'Game_name:new;\r\nArbitraryAsset:{',
+    );
+  });
+
+  it('validates Windows separators and never accepts path aliases', async () => {
+    const previous = await service.readTextSnapshot(game, scene);
+    await expect(
+      service.saveTextSnapshot(
+        game,
+        scene.replace(/\//g, '\\'),
+        'wait:bad;',
+        previous.revision,
+      ),
+    ).rejects.toMatchObject({
+      status: 422,
+      response: { code: 'SCENE_VALIDATION_FAILED' },
+    });
+    await expect(
+      service.saveTextSnapshot(
+        game,
+        'game/./scene/中文剧本.txt',
+        'wait:bad;',
+        previous.revision,
+      ),
+    ).rejects.toMatchObject({
+      status: 400,
+      response: { code: 'INVALID_PATH' },
+    });
+  });
+
+  it('rejects legacy update, replace and truncate paths with 428 and unchanged bytes', async () => {
+    for (const action of [
+      () => service.updateTextFile(target, 'wait:broken;'),
+      () => service.replaceTextFile(target, '旧对白', 'not applied'),
+      () => service.createEmptyFile(target),
+      () =>
+        service.updateTextFile(
+          join(dirname(target), '..', 'scene', basename(target)),
+          'alias',
+        ),
+    ]) {
+      await expect(action()).rejects.toMatchObject({
+        status: 428,
+        response: { code: 'SCENE_REVISION_REQUIRED' },
+      });
+      expect(await fs.readFile(target, 'utf8')).toBe(original);
+    }
+  });
+
+  it('still creates a new empty scene and imports new files without overwriting scenes', async () => {
+    const created = join(dirname(target), '新建.txt');
+    await expect(service.createEmptyFile(created)).resolves.toBe('created');
+    expect(await fs.readFile(created, 'utf8')).toBe('');
+    const imported = Buffer.from('say:导入的新剧本;');
+    await expect(
+      service.writeFiles(dirname(target), [
+        { fileName: '导入.txt', file: imported },
+      ]),
+    ).resolves.toBe(true);
+    expect(await fs.readFile(join(dirname(target), '导入.txt'))).toEqual(
+      imported,
+    );
+    await expect(
+      service.writeFiles(dirname(target), [
+        { fileName: '不应部分写入.txt', file: imported },
+        { fileName: basename(target), file: Buffer.from('invalid') },
+      ]),
+    ).rejects.toMatchObject({
+      status: 428,
+      response: { code: 'SCENE_REVISION_REQUIRED' },
+    });
+    expect(await fs.readFile(target, 'utf8')).toBe(original);
+    await expect(
+      fs.stat(join(dirname(target), '不应部分写入.txt')),
+    ).rejects.toMatchObject({ code: 'ENOENT' });
+  });
+
+  it('allows legacy config and template writes and replacements', async () => {
+    for (const file of [
+      join(root, game, 'game', 'config.txt'),
+      join(root, 'templates', 'theme', 'game', 'scene', 'template.json'),
+    ]) {
+      await fs.mkdir(dirname(file), { recursive: true });
+      await fs.writeFile(file, 'old');
+      await expect(service.updateTextFile(file, 'new')).resolves.toBe(
+        'Updated.',
+      );
+      await expect(
+        service.replaceTextFile(file, 'new', 'replaced'),
+      ).resolves.toBe('Replaced.');
+      expect(await fs.readFile(file, 'utf8')).toBe('replaced');
+    }
+  });
+});
