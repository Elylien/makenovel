+  for (const range of heads) {
+    const first = lines[range.startLine];
+    if (!isComment(range, first)) continue;
+    const raw = source.slice(first.start, lines[range.endLine].end);
+    if (!raw.includes(markerPrefix)) continue;
+    const match = /^\s*;\s*@makenovel-node ([A-Za-z][A-Za-z0-9._:-]{0,95})\s*$/.exec(raw);
