+  let start = hasColon ? colon + 1 : 0;
+  let end = codeEnd;
+  const argStart = raw.indexOf(' -', start);
+  if (argStart >= 0 && argStart < end) end = argStart;
+  while (start < end && raw[start].trim() === '') start += 1;
+  while (end > start && raw[end - 1].trim() === '') end -= 1;
