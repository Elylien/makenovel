+  const seen = new Map<string, number>();
+  for (const node of nodes) {
+    if (!node.nodeId) continue;
+    const previous = seen.get(node.nodeId);
+    if (previous !== undefined) {
+      diagnostics.push(diagnostic('DUPLICATE_ID', '身份标记重复；复制的命令必须使用新的身份。', node.startLine, node.nodeId));
+    } else seen.set(node.nodeId, node.startLine);
+  }
+  return { nodes, diagnostics };
+}
+
+function checkedIdentity(source: string, ranges: readonly NativeSentenceRange[]): SceneIdentity {
+  const identity = inspectSceneIdentity(source, ranges);
+  const errors = identity.diagnostics.filter(item => item.severity === 'error');
+  if (errors.length) fail('IDENTITY_DIAGNOSTICS', '身份信息存在歧义，请先在源码中修复。', { diagnostics: errors });
+  return identity;
+}
+
+function requireNode(identity: SceneIdentity, nodeId: string): SourceNode {
+  const node = identity.nodes.find(item => item.nodeId === nodeId);
+  if (!node) fail('ID_NOT_FOUND', '找不到指定身份；不会按行号或相同台词猜测。', { nodeId });
