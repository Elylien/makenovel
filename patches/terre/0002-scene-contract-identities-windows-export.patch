+        diagnostics.push(diagnostic('INVALID_ID_MARKER', '身份标记必须唯一并位于命令末尾的行内注释中。', range.endLine));
+      } else if (attached) {
+        diagnostics.push(diagnostic('AMBIGUOUS_ID', '同一命令同时带有独立和行内身份标记，请在源码中选择保留一项。', range.startLine, attached.id));
+      } else {
+        const markerStart = last.start + physicalMatch.index;
+        Object.assign(node, { nodeId: match[1], markerKind: 'inline', markerLine: range.endLine, markerStart, markerEnd: markerStart + markerPrefix.length + 1 + match[1].length });
+      }
+    }
+    if (!node.nodeId) {
+      diagnostics.push({ code: 'MISSING_ID', message: '这条命令尚未登记稳定身份。', line: range.startLine, severity: 'warning' });
+    }
+    nodes.push(node);
+  }
