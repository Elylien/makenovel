+  const keys = new Set([...originalArgs.keys(), ...desiredArgs.keys()]);
+  const additions: string[] = [];
+  for (const key of keys) {
+    if (originalArgs.has(key) === desiredArgs.has(key) && originalArgs.get(key) === desiredArgs.get(key)) continue;
+    const token = tokenByKey.get(key);
+    if (originalArgs.has(key) && !token) fail('UNSUPPORTED_ARGUMENT_EDIT', '隐式参数无法安全局部改写，请使用源码模式。', { key });
+    if (!desiredArgs.has(key)) {
+      if (token) addChange(token.start, token.end, '');
+      continue;
+    }
+    const value = String(desiredArgs.get(key));
+    if (!/^[A-Za-z][A-Za-z0-9_.-]*$/.test(key) || value.includes(' -') || /[\r\n\u0000-\u001f\u007f]/u.test(value) || value.includes('\\')) {
+      fail('UNSUPPORTED_ARGUMENT_EDIT', '参数包含无法安全写回的分隔符或转义，请使用源码模式。', { key });
+    }
+    const encoded = value.replace(/;/g, '\\;');
+    if (!token) {
+      additions.push(` -${key}=${encoded}`);
+      continue;
+    }
+    const equal = token.raw.indexOf('=');
+    const rawKey = token.raw.slice(2, equal >= 0 ? equal : undefined).trim();
+    if (rawKey !== key) {
+      // E.g. the native -voice.ogg shorthand maps to the vocal parameter.
+      addChange(token.start, token.end, ` -${key}=${encoded}`);
+    } else if (equal < 0) {
+      addChange(token.end, token.end, `=${encoded}`);
