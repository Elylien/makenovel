+/** Exact source ranges only. Overlap and stale expected slices reject the complete transaction. */
+export function applySourceChanges(source: string, changes: readonly SourceChange[]): SourceEditResult {
+  const sorted = [...changes].sort((a, b) => a.start - b.start || a.end - b.end);
+  let end = -1;
+  for (const change of sorted) {
+    if (!Number.isInteger(change.start) || !Number.isInteger(change.end) || change.start < 0
+        || change.end < change.start || change.end > source.length || change.start < end) {
+      fail('INVALID_SOURCE_CHANGE', '局部修改的范围无效或重叠。');
+    }
+    if (source.slice(change.start, change.end) !== change.before) fail('STALE_SOURCE_CHANGE', '局部源码已经改变，请重新解析。');
+    end = change.end;
+  }
+  let result = source;
+  for (const change of sorted.slice().reverse()) result = result.slice(0, change.start) + change.after + result.slice(change.end);
+  scanLines(result);
+  return { source: result, changes: sorted };
