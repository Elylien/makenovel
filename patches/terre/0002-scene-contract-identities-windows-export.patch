+ * Existing command spelling, argument order, untouched numeric/boolean spelling,
+ * whitespace and the complete author comment (including identity) are retained.
+ */
+export function patchNodeStatement(
+  source: string,
+  ranges: readonly NativeSentenceRange[],
+  edit: { nodeId: string; replacement: string },
+  parseNative: (source: string) => readonly NativeEditableSentence[],
+): SourceEditResult {
+  const node = requireNode(checkedIdentity(source, ranges), edit.nodeId);
+  if (node.startLine !== node.endLine || /[\r\n]/.test(edit.replacement)) {
+    fail('UNSUPPORTED_MULTILINE_EDIT', '多行源命令请使用源码模式；图形提案必须先经过原生折行预处理。');
+  }
+  scanLines(edit.replacement);
+  const raw = source.slice(node.start, node.end);
+  const originalParts = statementParts(raw);
+  const proposedParts = statementParts(edit.replacement);
+  const originalScene = parseNative(source);
+  const original = originalScene.find(sentence => sentence.startLine === node.startLine && !sentence.isLineBreakHolder);
+  const proposal = parseNative(edit.replacement);
+  if (!original || proposal.length !== 1 || proposal[0].isLineBreakHolder
+      || original.command !== proposal[0].command || proposal[0].commandRaw === 'comment') {
+    fail('UNSUPPORTED_COMMAND_EDIT', '图形提案改变了命令类型，请在源码模式中修改。');
+  }
+  const desired = proposal[0];
+  // Keep explicit say: when the legacy Say serializer emits a speaker prefix.
+  // Every other command prefix must stay unchanged; unknown speaker syntax is
+  // first explicitly confirmed and converted by the editor's source analysis.
+  if (originalParts.prefix !== proposedParts.prefix && originalParts.prefix !== 'say') {
+    fail('UNSUPPORTED_COMMAND_EDIT', '无法保留原命令前缀，请先在源码中确认命令类型。');
+  }
+  const originalArgs = uniqueArgs(original);
+  const desiredArgs = uniqueArgs(desired);
+  const tokenByKey = new Map<string, StatementParts['tokens'][number]>();
+  for (const token of originalParts.tokens) {
+    const tokenSentence = parseNative(`say:__makenovel_token__${token.raw}`)[0];
+    if (!tokenSentence || tokenSentence.args.length !== 1) fail('UNSUPPORTED_ARGUMENT_EDIT', '无法独立定位原始参数，请使用源码模式。');
+    const key = tokenSentence.args[0].key;
+    if (tokenByKey.has(key)) fail('AMBIGUOUS_ARGUMENTS', '重复参数请使用源码模式。', { key });
+    tokenByKey.set(key, token);
+  }
+  const changes: SourceChange[] = [];
+  const addChange = (start: number, end: number, after: string) => {
+    const before = raw.slice(start, end);
+    if (before !== after) changes.push({ start: node.start + start, end: node.start + end, before, after });
+  };
