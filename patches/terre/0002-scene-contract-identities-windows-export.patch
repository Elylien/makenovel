+  const comment = commentOffset(raw);
+  const codeEnd = comment >= 0 ? comment : raw.length;
+  const colon = raw.indexOf(':');
+  const hasColon = colon >= 0 && colon < codeEnd;
+  if (!(hasColon && raw.slice(0, colon) === 'say') && !edit.allowImplicitDialogue) {
+    fail('UNSUPPORTED_COMMAND_EDIT', '只有已确认的对话命令可局部修改正文；高级命令请使用源码模式。', { nodeId: edit.nodeId });
