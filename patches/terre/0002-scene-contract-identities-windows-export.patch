+      fail('UNSUPPORTED_ARGUMENT_EDIT', '复杂参数值请使用源码模式。', { key: arg.key });
+    }
+    result.set(arg.key, arg.value);
+  }
+  return result;
+}
+
+function normalizedArgs(sentence: NativeEditableSentence): string {
+  return JSON.stringify([...uniqueArgs(sentence).entries()].sort(([left], [right]) => left.localeCompare(right)));
+}
+
+/**
+ * Conservatively project a graphical serializer proposal onto original tokens.
+ * The actual native parser validates both the proposal and the resulting whole
