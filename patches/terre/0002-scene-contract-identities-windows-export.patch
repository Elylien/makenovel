+/** Explicit registration preserves existing IDs, comments, BOM and physical line count. */
+export function assignMissingNodeIds(source: string, ranges: readonly NativeSentenceRange[], factory: () => string, options: { eligibleStartLines?: readonly number[] } = {}): SourceEditResult & { assigned: Array<{ nodeId: string; startLine: number }> } {
+  const identity = checkedIdentity(source, ranges);
+  const lines = scanLines(source);
+  const occupied = new Set(identity.nodes.map(node => node.nodeId).filter((id): id is string => !!id));
+  const assigned: Array<{ nodeId: string; startLine: number }> = [];
+  const changes: SourceChange[] = [];
+  for (const node of identity.nodes) {
+    if (node.nodeId || (options.eligibleStartLines && !options.eligibleStartLines.includes(node.startLine))) continue;
+    const last = lines[node.endLine];
+    if (last.text.endsWith('\\')) fail('UNSAFE_CONTINUATION', '末尾续行未结束，请先在源码中修复。', { line: node.endLine });
+    const nodeId = freshId(factory, occupied);
+    // Always add a native comment delimiter. A preceding comment keeps it as
+    // comment text; no existing author whitespace or punctuation is rewritten.
+    changes.push({ start: last.end, end: last.end, before: '', after: `; ${markerPrefix} ${nodeId}` });
+    assigned.push({ nodeId, startLine: node.startLine });
+  }
+  return { ...applySourceChanges(source, changes), assigned };
