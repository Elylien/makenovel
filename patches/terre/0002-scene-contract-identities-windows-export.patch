+/** Delete the native range and its attached legacy marker together. */
+export function deleteNode(source: string, ranges: readonly NativeSentenceRange[], nodeId: string): SourceEditResult {
+  const node = requireNode(checkedIdentity(source, ranges), nodeId);
+  return applySourceChanges(source, [{ start: node.blockStart, end: node.blockEnd, before: source.slice(node.blockStart, node.blockEnd), after: '' }]);
