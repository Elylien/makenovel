index 0000000000000000000000000000000000000000..2bc7f1ea047b3f36b2851abeb2abffdfe0fadef0
--- /dev/null
+++ b/packages/terre2/src/Modules/scene-document/scene-analysis.ts
@@ -0,0 +1,586 @@
+import SceneParser, { SCRIPT_CONFIG, sceneTextPreProcess } from 'webgal-parser';
+import {
+  inspectSceneIdentity,
+  SceneIdentityError,
+} from '../scene-identity/scene-identity';
+
+/** UTF-16 offsets and 1-based positions, suitable for Monaco without conversion. */
+export interface ScenePosition {
+  line: number;
+  column: number;
+  offset: number;
+}
+export interface SceneRange {
+  start: ScenePosition;
+  end: ScenePosition;
+}
+export interface SceneDiagnostic {
+  code: string;
+  severity: 'error' | 'warning';
+  message: string;
+  range: SceneRange;
+}
+export interface SceneBlock {
+  kind: 'command' | 'dialogue' | 'comment' | 'blank' | 'advanced';
+  command?: string;
+  /** Inclusive, 1-based physical source lines. Identity is intentionally separate. */
+  startLine: number;
+  endLine: number;
+  range: SceneRange;
+  /** Exact source including internal EOLs, excluding the last line's EOL. */
+  raw: string;
+  graphicalEditable: boolean;
+}
+export interface SceneAnalysis {
+  valid: boolean;
+  previewable: boolean;
+  hasAdvanced: boolean;
+  coverage: 'locked-webgal-core';
+  diagnostics: SceneDiagnostic[];
+  blocks: SceneBlock[];
+}
+
+// The locked runtime does not register the legacy parser-only if/chooseLabel tags.
+// Keep this list visible and tested against its registry when the upstream changes.
+const runtimeCommands = new Set(
+  SCRIPT_CONFIG.map((item) => item.scriptString).filter(
+    (name) => name !== 'if' && name !== 'chooseLabel',
+  ),
+);
+const parser = new SceneParser(undefined, (name) => name, [], SCRIPT_CONFIG);
+
+const numericArguments: Record<string, string[]> = {
+  bgm: ['enter', 'volume'],
+  changeBg: ['duration', 'enterDuration', 'exitDuration', 'order'],
+  changeFigure: ['duration', 'enterDuration', 'exitDuration', 'zIndex'],
+  choose: ['defaultChoose'],
+  intro: ['delayTime'],
+  playEffect: ['volume'],
+  setComplexAnimation: ['duration'],
+  setTransform: ['duration'],
+  unlockCg: ['order'],
+  say: ['volume'],
+};
+const commonArguments = new Set(['next', 'continue', 'when']);
+const graphicalArguments: Record<string, string[]> = {
+  say: [
+    'speaker',
+    'vocal',
+    'fontSize',
+    'left',
+    'center',
+    'right',
+    'left14',
+    'left13',
+    'right13',
+    'right14',
+    'id',
+    'figureId',
+    'sayPlaceHolder',
+    'concat',
+    'notend',
+    'clear',
+    'volume',
+  ],
+  changeBg: [
+    'duration',
+    'enterDuration',
+    'exitDuration',
+    'order',
+    'transform',
+    'enter',
+    'exit',
+  ],
+  changeFigure: [
+    'id',
+    'left',
+    'center',
+    'right',
+    'zIndex',
+    'duration',
+    'enterDuration',
+    'exitDuration',
+    'transform',
+    'enter',
+    'exit',
+  ],
+  changeFigureDiff: ['id', 'left', 'center', 'right'],
+  bgm: ['enter', 'volume'],
+  playEffect: ['id', 'volume'],
+  playVideo: [],
+  miniAvatar: [],
+  intro: [
+    'fontSize',
+    'color',
+    'hold',
+    'animation',
+    'delayTime',
+    'backgroundColor',
+  ],
+  changeScene: [],
+  choose: ['defaultChoose'],
+  end: [],
+  label: [],
+  jumpLabel: [],
+  setVar: ['global', 'local'],
+  callScene: ['writeReturnTo'],
+  showVars: [],
+  unlockCg: ['name', 'series', 'order'],
+  unlockBgm: ['name', 'series'],
+  filmMode: [],
+  setTextbox: [],
+  setAnimation: ['target', 'keep', 'parallel', 'transformFrom'],
+  setComplexAnimation: ['target', 'duration'],
+  setTransform: [
+    'target',
+    'duration',
+    'ease',
+    'keep',
+    'parallel',
+    'transformFrom',
+    'writeDefault',
+    'ignoreDefault',
+  ],
+  setTempAnimation: [
+    'target',
+    'keep',
+    'parallel',
+    'transformFrom',
+    'writeDefault',
+    'ignoreDefault',
+  ],
+  setTransition: ['target', 'enter', 'exit', 'ignoreDefault'],
+  wait: ['nobreak'],
+  getUserInput: [
+    'title',
+    'buttonText',
+    'defaultValue',
+    'rule',
+    'ruleFlag',
+    'ruleText',
+    'ruleButtonText',
+  ],
+  applyStyle: [],
+  callSteam: [],
+  return: [],
+};
+
+/** No runtime evaluation, asset access or filesystem access occurs in this module. */
+export function analyzeScene(text: string): SceneAnalysis {
+  const lines = text.split('\n');
+  const offsets: number[] = [];
+  let offset = 0;
+  for (const line of lines) {
+    offsets.push(offset);
+    offset += line.length + 1;
+  }
+  const position = (index: number): ScenePosition => {
+    index = Math.max(0, Math.min(index, text.length));
+    let low = 0;
+    let high = offsets.length - 1;
+    while (low < high) {
+      const mid = Math.ceil((low + high) / 2);
+      if (offsets[mid] <= index) low = mid;
+      else high = mid - 1;
+    }
+    return { line: low + 1, column: index - offsets[low] + 1, offset: index };
+  };
+  const range = (start: number, end: number): SceneRange => ({
+    start: position(start),
+    end: position(end),
+  });
+  const diagnostics: SceneDiagnostic[] = [];
+  const blocks: SceneBlock[] = [];
+  const add = (
+    code: string,
+    severity: 'error' | 'warning',
+    message: string,
+    sourceRange: SceneRange,
+  ) => {
+    diagnostics.push({ code, severity, message, range: sourceRange });
+  };
+  const folded = sceneTextPreProcess(text).split('\n');
+  const native = parser.parse(
+    text,
+    'validation',
+    'validation.txt',
+  ).sentenceList;
+  for (const sentence of native) {
+    if (sentence.isLineBreakHolder) continue;
+    const startLine = sentence.startLine;
+    const endLine = sentence.endLine;
+    const lastPhysicalLine = lines[endLine] ?? '';
+    const end = offsets[endLine] + lastPhysicalLine.replace(/\r$/, '').length;
+    const sourceRange = range(offsets[startLine], end);
+    const raw = text.slice(offsets[startLine], end);
+    // Match the native immediate-backslash rule, including escaped semicolons.
+    const core = (folded[startLine] ?? '').split(/(?<!\\);/)[0];
+    const colon = core.indexOf(':');
+    const prefix = colon < 0 ? core : core.slice(0, colon);
+    const known = runtimeCommands.has(prefix);
+    let kind: SceneBlock['kind'];
+    if (!core.trim()) kind = raw.trim() ? 'comment' : 'blank';
+    else if (known) kind = prefix === 'say' ? 'dialogue' : 'command';
+    else
+      kind =
+        colon >= 0 || prefix === 'if' || prefix === 'chooseLabel'
+          ? 'advanced'
+          : 'dialogue';
+    const command = known ? prefix : kind === 'dialogue' ? 'say' : undefined;
+    const block: SceneBlock = {
+      kind,
+      command,
+      startLine: startLine + 1,
+      endLine: endLine + 1,
+      range: sourceRange,
+      raw,
+      graphicalEditable: false,
+    };
+    blocks.push(block);
+    if (kind === 'blank' || kind === 'comment') continue;
+    if (kind === 'advanced') {
+      add(
+        'AMBIGUOUS_OR_UNREGISTERED_COMMAND',
+        'warning',
+        '此行可能是角色名或未登记指令；原样保留。请明确转换为对白，或等待扩展登记后预览。',
+        sourceRange,
+      );
+      continue;
+    }
+    const errorCount = diagnostics.filter(
+      (entry) => entry.severity === 'error',
+    ).length;
+    const argsAt = core.indexOf(' -', colon >= 0 ? colon + 1 : 0);
+    const bodyStart = colon >= 0 ? colon + 1 : 0;
+    const body = core
+      .slice(bodyStart, argsAt >= 0 ? argsAt : undefined)
+      .trim()
+      .replace(/\\;/g, ';');
+    // Native parsing can fold lines; diagnostic ranges then cover the complete
+    // physical block rather than pretending folded offsets are source offsets.
+    const detailRange = (needle: string) => {
+      const found = raw.indexOf(needle);
+      return startLine === endLine && found >= 0
+        ? range(
+            offsets[startLine] + found,
+            offsets[startLine] + found + needle.length,
+          )
+        : sourceRange;
+    };
+    const parameters =
+      argsAt < 0
+        ? []
+        : core
+            .slice(argsAt + 2)
+            .split(' -')
+            .map((argument) => {
+              const equal = argument.indexOf('=');
+              return {
+                key: (equal < 0 ? argument : argument.slice(0, equal)).trim(),
+                value: equal < 0 ? undefined : argument.slice(equal + 1).trim(),
+                raw: argument,
+              };
+            });
+    const seen = new Set<string>();
+    // The caller must preserve the original comment tail when patching a block.
+    let unsafeProjection = startLine !== endLine;
+    for (const parameter of parameters) {
+      const vocalAlias = /\.(ogg|mp3|wav|opus)/i.test(parameter.key);
+      const key = vocalAlias ? 'vocal' : parameter.key;
+      if (seen.has(key)) {
+        unsafeProjection = true;
+        add(
+          'DUPLICATE_ARGUMENT',
+          'warning',
+          `参数 ${key} 重复；运行时使用首项，图形编辑可能合并参数，保留源码编辑。`,
+          detailRange(parameter.raw),
+        );
+      }
+      seen.add(key);
+      const allowed =
+        commonArguments.has(key) ||
+        (graphicalArguments[command ?? ''] ?? []).includes(key);
+      if (!allowed) unsafeProjection = true;
+      if (
+        key === 'when' &&
+        parameter.value !== undefined &&
+        parameter.value !== ''
+      ) {
+        const issue = expressionStructureIssue(parameter.value);
+        if (issue)
+          add(
+            'INVALID_EXPRESSION',
+            'error',
+            `条件表达式${issue}`,
+            detailRange(parameter.raw),
+          );
+      }
+      if (
+        (numericArguments[command ?? ''] ?? []).includes(key) &&
+        parameter.value !== undefined
+      ) {
+        if (
+          !hasInterpolation(parameter.value) &&
+          !['true', 'false'].includes(parameter.value) &&
+          !Number.isFinite(Number(parameter.value))
+        ) {
+          add(
+            'INVALID_NUMERIC_ARGUMENT',
+            'error',
+            `参数 ${key} 需要有限数值。`,
+            detailRange(parameter.raw),
+          );
+        }
+      }
+    }
+    if (
+      command === 'wait' &&
+      !hasInterpolation(body) &&
+      !Number.isFinite(Number(body))
+    ) {
+      add(
+        'INVALID_WAIT_DURATION',
+        'error',
+        'wait 的内容需要有限毫秒数值。',
+        detailRange(body),
+      );
+    }
+    if (command === 'setVar') {
+      const equal = body.indexOf('=');
+      if (equal < 0 || !body.slice(0, equal).trim()) {
+        add(
+          'INVALID_ASSIGNMENT',
+          'error',
+          'setVar 需要变量名和等号；空字符串值可以保留。',
+          detailRange(body),
+        );
+      } else {
+        // The native setVar treats values without arithmetic as literal strings;
+        // quote characters in such a literal are not evidence of broken syntax.
+        const value = body.slice(equal + 1);
+        if (/[+\-*/()]/.test(value)) {
+          const issue = expressionStructureIssue(value);
+          if (issue)
+            add(
+              'INVALID_EXPRESSION',
+              'error',
+              `变量表达式${issue}`,
+              detailRange(value),
+            );
+        }
+      }
+    }
+    if (command === 'setTransform' || command === 'setTempAnimation') {
+      if (body || command === 'setTempAnimation') {
+        try {
+          const parsed: unknown = JSON.parse(body);
+          const shapeValid =
+            command === 'setTransform'
+              ? parsed !== null &&
+                typeof parsed === 'object' &&
+                !Array.isArray(parsed)
+              : Array.isArray(parsed);
+          if (!shapeValid)
+            add(
+              'INVALID_JSON_SHAPE',
+              'error',
+              command === 'setTransform'
+                ? 'setTransform 需要 JSON 对象。'
+                : 'setTempAnimation 需要 JSON 帧数组。',
+              detailRange(body),
+            );
+        } catch {
+          if (isPotentialDynamicJson(body, command === 'setTempAnimation')) {
+            unsafeProjection = true;
+            add(
+              'DYNAMIC_VALUE_NOT_CHECKED',
+              'warning',
+              '该 JSON 来自运行时变量；静态检查不能验证最终值。',
+              detailRange(body),
+            );
+          } else
+            add(
+              'INVALID_JSON',
+              'error',
+              'JSON 内容未闭合或格式无效。',
+              detailRange(body),
+            );
+        }
+      }
+    }
+    if (command === 'choose') {
+      for (const option of body.split(/(?<!\\)\|/)) {
+        const parts = option.split('->');
+        const targetPart = parts.length > 1 ? parts[1] : parts[0];
+        // Native ChooseOption unconditionally reads jump.match(), so absent
+        // destination separators are a real runtime error, not a style rule.
+        if (!/(?<!\\):/.test(targetPart))
+          add(
+            'CHOICE_DESTINATION_MISSING',
+            'error',
+            '选项需要“显示文字:目标标签或场景”的分隔符。',
+            detailRange(option),
+          );
+        if (parts.length > 1) {
+          const issue = expressionStructureIssue(parts[0]);
+          if (issue)
+            add(
+              'INVALID_EXPRESSION',
+              'error',
+              `选项条件${issue}`,
+              detailRange(parts[0]),
+            );
+        }
+      }
+    }
+    block.graphicalEditable =
+      !unsafeProjection &&
+      diagnostics.filter((entry) => entry.severity === 'error').length ===
+        errorCount;
+  }
+  try {
+    const identity = inspectSceneIdentity(text, native);
+    for (const diagnostic of identity.diagnostics) {
+      if (diagnostic.severity !== 'error') continue;
+      const line = Math.max(0, Math.min(diagnostic.line, lines.length - 1));
+      add(
+        diagnostic.code,
+        'error',
+        diagnostic.message,
+        range(
+          offsets[line],
+          offsets[line] + lines[line].replace(/\r$/, '').length,
+        ),
+      );
+    }
+  } catch (error) {
+    if (!(error instanceof SceneIdentityError)) throw error;
+    const reportedLine =
+      typeof error.details.line === 'number' ? error.details.line : 0;
+    const line = Math.max(0, Math.min(reportedLine, lines.length - 1));
+    add(
+      error.code,
+      'error',
+      error.message,
+      range(
+        offsets[line],
+        offsets[line] + lines[line].replace(/\r$/, '').length,
+      ),
+    );
+  }
+  // The native preprocessor tolerates EOF after a backslash by flushing it.
+  // This editor treats an unfinished continuation as an unapplied draft.
+  let lastNonempty = lines.length - 1;
+  while (lastNonempty > 0 && lines[lastNonempty].replace(/\r$/, '') === '')
+    lastNonempty--;
+  if (lines[lastNonempty]?.replace(/\r$/, '').endsWith('\\')) {
+    const line = lines[lastNonempty].replace(/\r$/, '');
+    add(
+      'UNFINISHED_CONTINUATION',
+      'error',
+      '续行符后还没有完整的下一行；草稿保留，补完后再保存。',
+      range(
+        offsets[lastNonempty] + line.length - 1,
+        offsets[lastNonempty] + line.length,
+      ),
+    );
+  }
+  const valid = !diagnostics.some((entry) => entry.severity === 'error');
+  for (const block of blocks) {
+    if (
+      diagnostics.some(
+        (entry) =>
+          entry.severity === 'error' &&
+          entry.range.start.line <= block.endLine &&
+          entry.range.end.line >= block.startLine,
+      )
+    )
+      block.graphicalEditable = false;
+  }
+  const hasAdvanced = blocks.some((block) => block.kind === 'advanced');
+  return {
+    valid,
+    previewable: valid && !hasAdvanced,
+    hasAdvanced,
+    coverage: 'locked-webgal-core',
+    diagnostics,
+    blocks,
+  };
+}
+
+/** New/changed unregistered source needs explicit review; unchanged blocks survive. */
+export function hasUnreviewedAdvancedChanges(
+  previous: SceneAnalysis,
+  next: SceneAnalysis,
+): boolean {
+  const counts = new Map<string, number>();
+  for (const block of previous.blocks)
+    if (block.kind === 'advanced')
+      counts.set(block.raw, (counts.get(block.raw) ?? 0) + 1);
+  for (const block of next.blocks) {
+    if (block.kind !== 'advanced') continue;
+    const count = counts.get(block.raw) ?? 0;
+    if (!count) return true;
+    counts.set(block.raw, count - 1);
+  }
+  return false;
+}
+
+function hasInterpolation(value: string): boolean {
+  return /(?<!\\)\{[^{}]+\}/.test(value);
+}
+function isPotentialDynamicJson(value: string, array: boolean): boolean {
+  // Only identifier-shaped substitutions are treated as dynamic JSON. Arbitrary
+  // braces must not turn malformed object syntax into an unchecked expression.
+  const placeholder = /\{[\p{L}_$][\p{L}\p{N}_$.\[\]-]*\}/gu;
+  if (!placeholder.test(value)) return false;
+  placeholder.lastIndex = 0;
+  if (value.replace(placeholder, '') === '') return true;
+  try {
+    const replaced: unknown = JSON.parse(value.replace(placeholder, 'null'));
+    return array
+      ? Array.isArray(replaced)
+      : replaced !== null &&
+          typeof replaced === 'object' &&
+          !Array.isArray(replaced);
+  } catch {
+    return false;
+  }
+}
+
+/** Deliberately a structural check, not a second evaluator or variable resolver. */
+function expressionStructureIssue(value: string): string | undefined {
+  const stack: string[] = [];
+  let quote = '';
+  let escaped = false;
+  let lastOutside = '';
+  for (const char of value) {
+    if (escaped) {
+      escaped = false;
+      continue;
+    }
+    if (char === '\\') {
+      escaped = true;
+      continue;
+    }
+    if (quote) {
+      if (char === quote) quote = '';
+      continue;
+    }
+    if (char === '"' || char === "'") {
+      quote = char;
+      lastOutside = 'literal';
+      continue;
+    }
+    if ('([{'.includes(char)) stack.push(char);
+    if (')]}'.includes(char)) {
+      const expected = { ')': '(', ']': '[', '}': '{' }[char];
+      if (stack.pop() !== expected) return '存在不匹配的括号。';
+    }
+    if (char.trim()) lastOutside = char;
+  }
+  if (quote) return '字符串未闭合。';
+  if (stack.length) return '括号未闭合。';
+  if (/[+\-*/<>=!&|?:]$/.test(lastOutside)) return '在运算符后缺少内容。';
+  return undefined;
+}
diff --git a/packages/terre2/src/Modules/scene-document/scene-write-validation.spec.ts b/packages/terre2/src/Modules/scene-document/scene-write-validation.spec.ts
