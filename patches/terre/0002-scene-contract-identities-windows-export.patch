@@ -0,0 +1,593 @@
+/**
+ * Source identity and conservative text edits shared by the editor and server.
+ * Ranges MUST come from the locked native parser for this exact source string.
+ * Offsets are UTF-16 string offsets, not UTF-8 byte offsets. Valid UTF-8 source
+ * round-trips unchanged outside the listed edits; no second story parser lives here.
+ */
+export interface NativeSentenceRange {
+  startLine: number;
+  endLine: number;
+  commandRaw: string;
+  inlineComment?: string;
+  isLineBreakHolder?: boolean;
+}
+
+export interface IdentityDiagnostic {
+  code: string;
+  message: string;
+  severity: 'warning' | 'error';
+  /** Zero-based physical source line, as used by the native parser. */
+  line: number;
+  nodeId?: string;
+}
+
+export interface SourceNode {
+  nodeId?: string;
+  markerKind?: 'inline' | 'standalone';
+  markerLine?: number;
+  markerStart?: number;
+  markerEnd?: number;
+  startLine: number;
+  endLine: number;
+  /** Whole block including an immediately attached legacy marker, without BOM. */
+  blockStart: number;
+  blockEnd: number;
+  /** Native command source, excluding line terminator and legacy marker. */
+  start: number;
+  end: number;
+  commandRaw: string;
+}
+
+export interface SceneIdentity {
+  nodes: SourceNode[];
+  diagnostics: IdentityDiagnostic[];
+}
+
+export interface SourceChange {
+  start: number;
+  end: number;
+  before: string;
+  after: string;
+}
+
+export interface SourceEditResult {
+  source: string;
+  changes: SourceChange[];
+}
+
+export class SceneIdentityError extends Error {
+  readonly code: string;
+  readonly details: Record<string, unknown>;
+
+  constructor(code: string, message: string, details: Record<string, unknown> = {}) {
+    super(message);
+    this.name = 'SceneIdentityError';
+    this.code = code;
+    this.details = details;
+  }
+}
+
+interface SourceLine {
+  start: number;
+  end: number;
+  next: number;
+  text: string;
+  eol: string;
+}
+
+const markerPrefix = '@makenovel-node';
+const idPattern = /^[A-Za-z][A-Za-z0-9._:-]{0,95}$/;
+const markerPattern = /@makenovel-node ([A-Za-z][A-Za-z0-9._:-]{0,95})\s*$/;
+
+function fail(code: string, message: string, details: Record<string, unknown> = {}): never {
+  throw new SceneIdentityError(code, message, details);
+}
+
+function scanLines(source: string): SourceLine[] {
+  if (typeof source !== 'string' || /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/u.test(source)) {
+    fail('INVALID_SOURCE', '源码必须是有效的 Unicode 文本。');
+  }
+  const lines: SourceLine[] = [];
+  let start = source.startsWith('\uFEFF') ? 1 : 0;
+  for (let offset = start; offset <= source.length; offset += 1) {
+    if (offset !== source.length && source[offset] !== '\n') continue;
+    const end = offset < source.length && offset > start && source[offset - 1] === '\r' ? offset - 1 : offset;
+    const text = source.slice(start, end);
+    if (text.includes('\r')) fail('UNSUPPORTED_LINE_ENDING', '独立 CR 换行需要在源码中处理。', { line: lines.length });
+    const next = offset < source.length ? offset + 1 : offset;
+    lines.push({ start, end, next, text, eol: source.slice(end, next) });
+    start = next;
+  }
+  return lines;
+}
+
+/** First native comment delimiter; WebGAL deliberately checks one preceding slash. */
+function commentOffset(text: string): number {
+  for (let i = 0; i < text.length; i += 1) {
+    if (text[i] === ';' && text[i - 1] !== '\\') return i;
+  }
+  return -1;
+}
+
+function isComment(range: NativeSentenceRange, line: SourceLine): boolean {
+  return range.commandRaw === 'comment' && (line.text.trim() === '' || line.text.replace(/^\s+/, '').startsWith(';'));
+}
+
+function nativeHeads(ranges: readonly NativeSentenceRange[], lines: SourceLine[]): NativeSentenceRange[] {
+  const heads = ranges.filter(range => !range.isLineBreakHolder);
+  let lastEnd = -1;
+  for (const range of heads) {
+    if (!Number.isInteger(range.startLine) || !Number.isInteger(range.endLine)
+        || range.startLine <= lastEnd || range.startLine < 0 || range.endLine < range.startLine
+        || range.endLine >= lines.length) {
+      fail('INVALID_SOURCE_RANGES', '语句范围不属于当前源码；请重新解析后再编辑。');
+    }
+    lastEnd = range.endLine;
+  }
+  return heads;
+}
+
+function diagnostic(code: string, message: string, line: number, nodeId?: string): IdentityDiagnostic {
+  return { code, message, line, nodeId, severity: 'error' };
+}
