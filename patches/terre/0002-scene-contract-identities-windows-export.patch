+  for (const range of heads) {
+    const first = lines[range.startLine];
+    const last = lines[range.endLine];
+    if (isComment(range, first)) continue;
+    const attached = legacy.get(range.startLine);
+    const node: SourceNode = {
+      startLine: range.startLine,
+      endLine: range.endLine,
+      blockStart: attached ? lines[attached.line].start : first.start,
+      blockEnd: last.next,
+      start: first.start,
+      end: last.end,
+      commandRaw: range.commandRaw,
