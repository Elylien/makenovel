+
+function freshId(factory: () => string, occupied: Set<string>): string {
+  const id = factory();
+  if (!idPattern.test(id)) fail('INVALID_NEW_ID', '新身份必须以字母开头，并仅包含字母、数字和 ._:-。');
+  if (id.includes('-concat')) fail('UNSAFE_NEW_ID', '身份中不能包含会影响原生续行解析的 -concat。');
+  if (occupied.has(id)) fail('DUPLICATE_NEW_ID', '新生成的身份与现有身份重复，请重试。', { nodeId: id });
+  occupied.add(id);
+  return id;
+}
