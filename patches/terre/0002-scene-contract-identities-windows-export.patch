diff --git a/packages/terre2/src/Modules/scene-document/scene-analysis.spec.ts b/packages/terre2/src/Modules/scene-document/scene-analysis.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fdbe3fb8b1e42e70d40580023ed34c1caa0af448
--- /dev/null
+++ b/packages/terre2/src/Modules/scene-document/scene-analysis.spec.ts
@@ -0,0 +1,246 @@
+import * as fs from 'fs';
+import { resolve } from 'path';
+import SceneParser, { SCRIPT_CONFIG } from 'webgal-parser';
+import { analyzeScene, hasUnreviewedAdvancedChanges } from './scene-analysis';
+
+const native = new SceneParser(undefined, (name) => name, [], SCRIPT_CONFIG);
+const runtimeRoot = resolve(__dirname, '../../../../../../WebGAL');
+
+describe('scene source contract (locked WebGAL parser, no execution)', () => {
+  it.each(['start.txt', 'var.txt', 'line-break.txt', 'long-script.txt'])(
+    'does not reject the upstream %s fixture and uses native physical ranges',
+    (fixture) => {
+      const text = fs.readFileSync(
+        resolve(runtimeRoot, 'packages/parser/test/test-resources', fixture),
+        'utf8',
+      );
+      const analysis = analyzeScene(text);
+      expect(
+        analysis.diagnostics.filter((item) => item.severity === 'error'),
+      ).toEqual([]);
+      const expected = native
+        .parse(text, 'fixture', 'fixture.txt')
+        .sentenceList.filter((sentence) => !sentence.isLineBreakHolder);
+      expect(
+        analysis.blocks.map((block) => [block.startLine, block.endLine]),
+      ).toEqual(
+        expected.map((sentence) => [
+          sentence.startLine + 1,
+          sentence.endLine + 1,
+        ]),
+      );
+      for (const block of analysis.blocks)
+        expect(
+          text.slice(block.range.start.offset, block.range.end.offset),
+        ).toBe(block.raw);
+    },
+  );
+
+  it('distinguishes deliberate malformed choice fixtures from successful parsing', () => {
+    const text = fs.readFileSync(
+      resolve(runtimeRoot, 'packages/parser/test/test-resources/choose.txt'),
+      'utf8',
+    );
+    expect(() => native.parse(text, 'fixture', 'fixture.txt')).not.toThrow();
+    expect(
+      analyzeScene(text)
+        .diagnostics.filter(
+          (item) => item.code === 'CHOICE_DESTINATION_MISSING',
+        )
+        .map((item) => item.range.start.line),
+    ).toEqual([1, 2, 2, 5]);
+  });
+
+  it('matches all registered commands in the locked runtime source', () => {
+    const registry = fs.readFileSync(
+      resolve(runtimeRoot, 'packages/webgal/src/Core/parser/sceneParser.ts'),
+      'utf8',
+    );
+    const tags = [...registry.matchAll(/^\s+(\w+): ScriptConfig/gm)]
+      .map((match) => match[1])
+      .filter((name) => name !== '__commment');
+    for (const command of tags) {
+      const body =
+        command === 'choose'
+          ? '选项:label'
+          : command === 'wait'
+          ? '10'
+          : command === 'setVar'
+          ? 'x='
+          : command === 'setTempAnimation'
+          ? '[]'
+          : command === 'setTransform'
+          ? '{}'
+          : '';
+      expect(analyzeScene(`${command}:${body};`).blocks[0].kind).not.toBe(
+        'advanced',
+      );
+    }
+    expect(
+      analyzeScene('if:x;\nchooseLabel:x;').blocks.every(
+        (block) => block.kind === 'advanced',
+      ),
+    ).toBe(true);
+  });
+
+  it('does not confuse an unregistered tag with a confirmed speaker', () => {
+    const analysis = analyzeScene(
+      'futureFoo:opaque -custom=keep;\n凛:你好;\nsay:你好 -speaker=凛;\n接下来的对白;',
+    );
+    expect(analysis.blocks.map((block) => block.kind)).toEqual([
+      'advanced',
+      'advanced',
+      'dialogue',
+      'dialogue',
+    ]);
+    expect(analysis).toMatchObject({
+      valid: true,
+      previewable: false,
+      hasAdvanced: true,
+    });
+    expect(
+      analysis.blocks.slice(0, 2).every((block) => !block.graphicalEditable),
+    ).toBe(true);
+  });
+
+  it('keeps BOM/CRLF and non-ASCII positions without normalization', () => {
+    const text =
+      '\uFEFF;保留\r\nsay:你好😀 -speaker=凛;  注释\r\nwait:nope;\r\n';
+    const analysis = analyzeScene(text);
+    const error = analysis.diagnostics.find(
+      (entry) => entry.code === 'INVALID_WAIT_DURATION',
+    );
+    expect(error?.range).toEqual({
+      start: { line: 3, column: 6, offset: text.indexOf('nope') },
+      end: { line: 3, column: 10, offset: text.indexOf('nope') + 4 },
+    });
+    expect(analysis.blocks[1].raw).toBe('say:你好😀 -speaker=凛;  注释');
+    expect(analysis.blocks[1].graphicalEditable).toBe(true);
+  });
+
+  it('uses native multiline grouping and protects it from graphical serialization', () => {
+    const text = 'setTransform:{"x":1}\r\n  -duration=100\r\nsay:下一句;';
+    expect(
+      analyzeScene(text).blocks.map((block) => [
+        block.startLine,
+        block.endLine,
+        block.graphicalEditable,
+      ]),
+    ).toEqual([
+      [1, 2, false],
+      [3, 3, true],
+    ]);
+  });
+
+  it('retains native concat exception and explicit continuation behavior', () => {
+    for (const text of [
+      'intro:aaa\n  |bbb -concat\n',
+      'intro:aaa\\\n|bbb\\\n|ccc -concat\n',
+    ]) {
+      expect(
+        analyzeScene(text).blocks.map((block) => [
+          block.startLine,
+          block.endLine,
+        ]),
+      ).toEqual(
+        native
+          .parse(text, '', '')
+          .sentenceList.filter((sentence) => !sentence.isLineBreakHolder)
+          .map((sentence) => [sentence.startLine + 1, sentence.endLine + 1]),
+      );
+    }
+  });
+
+  it.each([
+    ['say:unfinished\\', 'UNFINISHED_CONTINUATION'],
+    ['setTransform:{"x":', 'INVALID_JSON'],
+    ['setTransform:[];', 'INVALID_JSON_SHAPE'],
+    ['setTempAnimation:{"x":1};', 'INVALID_JSON_SHAPE'],
+    ['setVar: =1;', 'INVALID_ASSIGNMENT'],
+    ['setVar:x=(1+2;', 'INVALID_EXPRESSION'],
+    ['say:条件 -when=a>;', 'INVALID_EXPRESSION'],
+    ['say:条件 -when=(a>1];', 'INVALID_EXPRESSION'],
+    ['say:条件 -when=a=="unfinished;', 'INVALID_EXPRESSION'],
+    ['wait:NaN;', 'INVALID_WAIT_DURATION'],
+    ['changeBg:background.png -duration=bad;', 'INVALID_NUMERIC_ARGUMENT'],
+    ['choose:选项没有目标;', 'CHOICE_DESTINATION_MISSING'],
+  ])('keeps an invalid draft unapplied: %s', (text, code) => {
+    expect(analyzeScene(text)).toMatchObject({
+      valid: false,
+      previewable: false,
+    });
+    expect(
+      analyzeScene(text).diagnostics.some(
+        (item) => item.code === code && item.severity === 'error',
+      ),
+    ).toBe(true);
+  });
+
+  it.each([
+    'setVar:empty=;',
+    'setVar:words=他说“你好;',
+    'say:普通对白中的(和引号"不做表达式处理;',
+    'setVar:x=random(1,5);',
+    'setVar:x="a"+"b";',
+    'say:条件 -when=(a>1)&&(b<=2);',
+    'choose:(a>1)[b>2]->选项:label|另一选项:next.txt;',
+    'setTransform:;',
+    'setTransform:{"x":{position}};',
+    'setTransform:{变换};',
+    'wait:{time};',
+    'changeBg:bg.webp -duration=true;',
+    'say:转义分号\\;继续 -speaker=凛;',
+    'say:旁白 -clear;',
+    'say:继承名字;',
+  ])('accepts native-compatible core forms: %s', (text) =>
+    expect(analyzeScene(text).valid).toBe(true),
+  );
+
+  it('makes duplicated and unrecognized arguments read-only without rewriting them', () => {
+    for (const text of [
+      'say:对白 -speaker=甲 -speaker=乙;',
+      'say:对白 -future=keep;',
+    ]) {
+      expect(analyzeScene(text).blocks[0]).toMatchObject({
+        raw: text,
+        graphicalEditable: false,
+      });
+    }
+    expect(
+      analyzeScene('say:对白 -figureId=x -left14; @makenovel-node abc')
+        .blocks[0].graphicalEditable,
+    ).toBe(true);
+  });
+
+  it('allows unchanged advanced neighbors but rejects changes or extra copies', () => {
+    const original = analyzeScene(
+      'future: x -custom=keep;  untouched\r\nsay:old;',
+    );
+    expect(
+      hasUnreviewedAdvancedChanges(
+        original,
+        analyzeScene('future: x -custom=keep;  untouched\r\nsay:new;'),
+      ),
+    ).toBe(false);
+    expect(
+      hasUnreviewedAdvancedChanges(
+        original,
+        analyzeScene('future:x -custom=keep;  untouched\r\nsay:new;'),
+      ),
+    ).toBe(true);
+    expect(
+      hasUnreviewedAdvancedChanges(
+        original,
+        analyzeScene(
+          'future: x -custom=keep;  untouched\nfuture: x -custom=keep;  untouched',
+        ),
+      ),
+    ).toBe(true);
+    expect(
+      hasUnreviewedAdvancedChanges(
+        original,
+        analyzeScene('say:explicit -speaker=future;'),
+      ),
+    ).toBe(false);
+  });
+});
diff --git a/packages/terre2/src/Modules/scene-document/scene-analysis.ts b/packages/terre2/src/Modules/scene-document/scene-analysis.ts
