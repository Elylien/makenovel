@@ -0,0 +1,44 @@
+import SceneParser, { SCRIPT_CONFIG, sceneTextPreProcess } from 'webgal-parser';
+import { analyzeScene, assignMissingNodeIds, inspectSceneIdentity } from './sceneContract';
+import { patchNodeStatement } from '../../../../../terre2/src/Modules/scene-identity/scene-identity';
+
+const parser = new SceneParser(undefined, name => name, [], SCRIPT_CONFIG);
+export const nativeRanges = (source: string) => parser.parse(source.replace(/^\uFEFF/, ''), 'editing', 'editing.txt').sentenceList;
+export const freshNodeId = () => `node-${crypto.randomUUID()}`;
+
+export function registerSceneNodes(source: string) {
+  const analysis = analyzeScene(source);
+  if (!analysis.valid) throw new Error('请先修复脚本错误，再登记节点身份。');
+  const eligibleStartLines = analysis.blocks.filter(block => block.kind === 'command' || block.kind === 'dialogue').map(block => block.startLine - 1);
+  return assignMissingNodeIds(source, nativeRanges(source), freshNodeId, { eligibleStartLines });
+}
+
+/** The serializer proposes semantics; only changed source tokens are applied. */
+export function editGraphicalStatement(source: string, startLine: number, replacement: string) {
+  const block = analyzeScene(source).blocks.find(item => item.startLine === startLine + 1);
+  if (!block?.graphicalEditable) throw new Error('该段源码无法安全投影为表单，请在源码模式编辑。');
+  const registered = assignMissingNodeIds(source, nativeRanges(source), freshNodeId, { eligibleStartLines: [startLine] }).source;
+  const ranges = nativeRanges(registered);
+  const node = inspectSceneIdentity(registered, ranges).nodes.find(item => item.startLine === startLine);
+  if (!node?.nodeId) throw new Error('无法确定节点身份，请在源码中检查标记。');
+  let folded = sceneTextPreProcess(replacement).split('\n')[0];
+  if (block.kind === 'dialogue' && !block.raw.split(/(?<!\\);/)[0].includes(':')) folded = folded.replace(/^say:/, '');
+  return patchNodeStatement(registered, ranges, { nodeId: node.nodeId, replacement: folded }, nativeRanges).source;
+}
+
+/** Explicit user confirmation resolves the native parser's unknown-command/speaker ambiguity. */
+export function confirmSpeakerDialogue(source: string, startLine: number) {
+  const block = analyzeScene(source).blocks.find(item => item.startLine === startLine + 1);
+  if (block?.kind !== 'advanced' || block.startLine !== block.endLine) throw new Error('只支持确认单行角色对白；复杂代码请在源码中处理。');
+  const comment = block.raw.search(/(?<!\\);/);
+  const code = comment < 0 ? block.raw : block.raw.slice(0, comment);
+  const colon = code.indexOf(':');
+  const speaker = code.slice(0, colon);
+  if (colon <= 0 || speaker !== speaker.trim() || /[=;\\\r\n]/.test(speaker) || speaker.includes(' -') || / -speaker(?:=|\s|$)/.test(code)) {
+    throw new Error('角色名或参数存在歧义，请在源码中明确写为 say:对白 -speaker=角色名。');
+  }
+  const next = `say:${code.slice(colon + 1)} -speaker=${speaker}${comment < 0 ? ';' : block.raw.slice(comment)}`;
+  const result = source.slice(0, block.range.start.offset) + next + source.slice(block.range.end.offset);
+  if (!analyzeScene(result).valid) throw new Error('转换后仍有脚本错误，请先在源码中修复。');
+  return assignMissingNodeIds(result, nativeRanges(result), freshNodeId, { eligibleStartLines: [startLine] }).source;
+}
