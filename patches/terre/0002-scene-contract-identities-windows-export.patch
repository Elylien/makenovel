+
+export interface NativeEditableSentence extends NativeSentenceRange {
+  command: number;
+  content: string;
+  args: readonly { key: string; value: string | number | boolean }[];
+}
+
+interface StatementParts {
+  contentStart: number;
+  contentEnd: number;
+  insertAt: number;
+  prefix: string | undefined;
+  tokens: Array<{ start: number; end: number; raw: string }>;
+}
+
+function statementParts(raw: string): StatementParts {
+  const comment = commentOffset(raw);
+  const codeEnd = comment >= 0 ? comment : raw.length;
+  const colon = raw.indexOf(':');
+  const hasColon = colon >= 0 && colon < codeEnd;
+  const prefix = hasColon ? raw.slice(0, colon) : undefined;
+  let contentStart = hasColon ? colon + 1 : 0;
+  const argStarts: number[] = [];
+  for (let offset = contentStart; offset < codeEnd - 1; offset += 1) {
+    if (raw[offset] === ' ' && raw[offset + 1] === '-') argStarts.push(offset);
+  }
+  let contentEnd = argStarts[0] ?? codeEnd;
+  while (contentStart < contentEnd && raw[contentStart].trim() === '') contentStart += 1;
+  while (contentEnd > contentStart && raw[contentEnd - 1].trim() === '') contentEnd -= 1;
+  let insertAt = codeEnd;
+  while (insertAt > 0 && raw[insertAt - 1].trim() === '') insertAt -= 1;
+  return {
+    contentStart, contentEnd, insertAt, prefix,
+    tokens: argStarts.map((start, index) => {
+      let end = argStarts[index + 1] ?? codeEnd;
+      while (end > start && raw[end - 1].trim() === '') end -= 1;
+      return { start, end, raw: raw.slice(start, end) };
+    }),
+  };
+}
+
+function uniqueArgs(sentence: NativeEditableSentence): Map<string, string | number | boolean> {
+  const result = new Map<string, string | number | boolean>();
+  for (const arg of sentence.args) {
+    if (result.has(arg.key)) fail('AMBIGUOUS_ARGUMENTS', '重复参数不能通过整句控件安全修改；可单独改正文或使用源码模式。', { key: arg.key });
