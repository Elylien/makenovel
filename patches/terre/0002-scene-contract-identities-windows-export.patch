+/** Read-only projection. Missing IDs are reported; source or text equality never invents identity. */
+export function inspectSceneIdentity(source: string, ranges: readonly NativeSentenceRange[]): SceneIdentity {
+  const lines = scanLines(source);
+  const heads = nativeHeads(ranges, lines);
+  const diagnostics: IdentityDiagnostic[] = [];
+  const nodes: SourceNode[] = [];
+  const legacy = new Map<number, { id: string; line: number; start: number; end: number }>();
