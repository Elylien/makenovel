+.surface.surface {
+  width: min(940px, calc(100vw - 32px));
+  max-width: 940px;
+  max-height: calc(100dvh - 32px);
+  padding: 24px;
+  overflow: hidden;
+}
+
+.body.body {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  max-height: calc(100dvh - 82px);
+  gap: 12px;
+}
+
+.body.body > :not(.content) { flex-shrink: 0; min-width: 0; }
+.heading { min-width: 0; }
+.dialogue { font-weight: 600; margin: 0 0 8px; overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
+.explanation, .hint { margin: 4px 0; font-size: 12px; color: var(--text-sub); line-height: 1.6; }
+.content.content { flex: 1 1 auto; overflow-y: auto; min-height: 0; margin: 0; padding: 2px 6px 2px 2px; }
+.card { border: var(--border-md); border-radius: var(--radius-md); margin-bottom: 10px; overflow: hidden; }
+.card summary { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 12px; cursor: pointer; background: var(--bg-card); }
+.card summary::before { content: '›'; font-size: 18px; width: 10px; }
+.card[open] summary::before { transform: rotate(90deg); }
+.card summary:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; }
+.rowTitle { font-weight: 600; color: var(--primary); min-width: 104px; }
+.summary { flex: 1; min-width: 120px; overflow-wrap: anywhere; font-size: 12px; }
+.line { color: var(--text-sub); font-size: 11px; }
+.controls { padding: 10px; }
+.readOnly { display: flex; gap: 12px; margin: 8px 12px; color: var(--text-sub); font-size: 12px; }
+.readOnly small { overflow-wrap: anywhere; white-space: pre-wrap; flex: 1; }
+.error { margin: 6px 0; color: #b1372e; background: #fff1ee; padding: 8px 10px; border-radius: 4px; font-size: 12px; line-height: 1.5; }
+.actions.actions { display: flex; flex-direction: row; justify-content: flex-end; align-items: center; align-self: stretch; flex-wrap: wrap; gap: 8px; }
+.pending { margin-right: auto; color: var(--text-sub); font-size: 12px; }
+
+@media (max-width: 600px) {
+  .surface.surface { padding: 14px; }
+  .body.body { max-height: calc(100dvh - 62px); }
+  .line { width: 100%; padding-left: 18px; }
+}
