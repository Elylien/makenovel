diff --git a/packages/origine2/src/pages/editor/GraphicalEditor/components/DirectorPanel.tsx b/packages/origine2/src/pages/editor/GraphicalEditor/components/DirectorPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8340ed2a4b41d904dc4a7cef29204acca11d8932
--- /dev/null
+++ b/packages/origine2/src/pages/editor/GraphicalEditor/components/DirectorPanel.tsx
@@ -0,0 +1,183 @@
+import { useLayoutEffect, useRef, useState } from 'react';
+import { Button, Dialog, DialogActions, DialogBody, DialogContent, DialogSurface, DialogTitle } from '@fluentui/react-components';
+import { sentenceEditorConfig } from '../SentenceEditor';
+import { getArgByKey } from '../utils/getArgByKey';
+import { editDirectorSession, commitDirectorSession, type DirectorSession, type DirectorSessionNode } from '../../SceneDocument/directorSession';
+import type { SceneDocument } from '../../SceneDocument/sceneDocument';
+import { holdScenePreview } from '../../SceneDocument/sceneDocumentRegistry';
+import styles from './directorPanel.module.scss';
+
+interface DirectorPanelProps {
+  initialSession: DirectorSession;
+  document: SceneDocument;
+  targetPath: string;
+  onClose: () => void;
+}
+
+const editorByCommand = new Map(sentenceEditorConfig.map(config => [config.type, config.component]));
+
+function rowTitle(node: DirectorSessionNode) {
+  const sentence = node.sentence;
+  const id = getArgByKey(sentence, 'id');
+  const position = id ? `ID ${id}` : getArgByKey(sentence, 'left') ? '左侧' : getArgByKey(sentence, 'right') ? '右侧' : '中间';
+  switch (node.command) {
+  case 'changeBg': return '背景';
+  case 'changeFigure': return `立绘 · ${position}`;
+  case 'changeFigureDiff': return `表情差分 · ${position}`;
+  case 'bgm': return '背景音乐';
+  case 'playEffect': return '效果音';
+  case 'wait': return '等待演出';
+  default: return node.role === 'dialogue' ? '对白与语音' : '源码注释';
+  }
+}
+
+function rowSummary(node: DirectorSessionNode) {
+  if (node.role === 'dialogue') {
+    const voice = getArgByKey(node.sentence, 'vocal');
+    return voice ? `语音：${voice}` : '未指定本句语音';
+  }
+  if (node.role === 'wait') return `${node.sentence.content} 毫秒 · 保留原等待顺序`;
+  if (node.role === 'comment') return node.raw.trim() || '空行';
+  return node.sentence.content === 'none' ? '关闭 / 清除' : node.sentence.content;
+}
+
+/** A local transaction. No child callback writes or previews the shared scene. */
+export function DirectorPanel({ initialSession, document, targetPath, onClose }: DirectorPanelProps) {
+  const [session, setSession] = useState(initialSession);
+  const sessionRef = useRef(session);
+  const [errors, setErrors] = useState<Record<string, string>>({});
+  const errorsRef = useRef(errors);
+  const [message, setMessage] = useState('');
+  const composing = useRef(false);
+  const closed = useRef(false);
+  const releasePreview = useRef<() => void>(() => {});
+
+  useLayoutEffect(() => {
+    closed.current = false;
+    const release = holdScenePreview(targetPath);
+    releasePreview.current = release;
+    return () => { closed.current = true; release(); };
+  }, [targetPath]);
+
+  const updateNode = (nodeId: string, replacement: string) => {
+    if (closed.current) return;
+    try {
+      const next = editDirectorSession(sessionRef.current, nodeId, replacement);
+      sessionRef.current = next;
+      setSession(next);
+      const nextErrors = { ...errorsRef.current };
+      delete nextErrors[nodeId];
+      errorsRef.current = nextErrors;
+      setErrors(nextErrors);
+      setMessage('');
+    } catch (error) {
+      const nextErrors = { ...errorsRef.current, [nodeId]: error instanceof Error ? error.message : '这项修改无法安全应用，请修正或取消。' };
+      errorsRef.current = nextErrors;
+      setErrors(nextErrors);
+    }
+  };
+
+  const cancel = () => {
+    if (closed.current) return;
+    closed.current = true;
+    // The parent status bar reads the hold during render. Release before asking
+    // it to close, rather than leaving that render ahead of layout cleanup.
+    releasePreview.current();
+    onClose();
+  };
+  const apply = () => {
+    if (closed.current) return;
+    if (composing.current) {
+      setMessage('请先完成中文候选输入，再应用到草稿。');
+      return;
+    }
+    // Native controls commit on blur; Say also queues composition-end work.
+    // Read the refs after those callbacks, never the render's older session.
+    const active = globalThis.document.activeElement;
+    if (active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement) active.blur();
+    queueMicrotask(() => queueMicrotask(() => {
+      if (closed.current) return;
+      if (composing.current || document.getSnapshot().isComposing) {
+        setMessage('请先完成中文候选输入，再应用到草稿。');
+        return;
+      }
+      if (Object.keys(errorsRef.current).length) {
+        setMessage('仍有无法应用的输入。请修正下方提示，或取消本次修改。');
+        return;
+      }
+      const current = document.getSnapshot();
+      if (!current.revision || current.status === 'loading' || current.status === 'conflict' || current.status === 'saving') {
+        setMessage('主文档正在读取、保存或存在冲突。面板内容已保留，请处理后重试。');
+        return;
+      }
+      try {
+        const source = commitDirectorSession(current.text, current.historyVersion, sessionRef.current);
+        document.edit(source, { resyncControls: true });
+        releasePreview.current();
+        document.reportMessage(source === current.text ? '舞台与声音没有变化。' : '舞台与声音已一次应用到草稿；保存后可以预览，也可一次撤销。');
+        closed.current = true;
+        onClose();
+      } catch (error) {
+        setMessage(error instanceof Error ? error.message : '无法应用，面板内容已保留。');
+      }
+    }));
+  };
+
+  const selected = session.nodes.find(node => node.nodeId === session.selectedNodeId)!;
+  const editableCount = session.nodes.filter(node => node.editable && node.role !== 'dialogue').length;
+
+  return <Dialog open onOpenChange={(_, data) => { if (!data.open && !composing.current) cancel(); }}>
+    <DialogSurface className={styles.surface} data-makenovel-director-panel="true"
+      onCompositionStartCapture={() => { composing.current = true; }}
+      onCompositionEndCapture={() => { queueMicrotask(() => { composing.current = false; }); }}
+      onKeyDownCapture={event => {
+        if (!(event.ctrlKey || event.metaKey) || event.altKey) return;
+        const key = event.key.toLowerCase();
+        if (!['s', 'z', 'y'].includes(key)) return;
+        event.stopPropagation();
+        if (key !== 's') return; // Keep the focused input's native text undo.
+        event.preventDefault();
+        if (event.nativeEvent.isComposing || event.keyCode === 229) {
+          setMessage('请先完成中文候选输入，再应用到草稿。');
+          return;
+        }
+        apply();
+      }}>
+      <DialogBody className={styles.body}>
+        <DialogTitle>舞台与声音</DialogTitle>
+        <div className={styles.heading}>
+          <p className={styles.dialogue} title={selected.sentence.content}>{selected.sentence.content || '（空白对白）'}</p>
+          <p className={styles.explanation}>编辑本句前相邻的 {editableCount} 项设置与本句语音；不推算更早对白或分支的继承状态。顺序与等待保持原样。</p>
+          <p className={styles.hint}>面板打开期间不能执行到此句或修改舞台预览。应用只进入场景草稿；保存后再预览。Ctrl+S 同样只应用到草稿。</p>
+        </div>
+        <DialogContent className={styles.content}>
+          {session.nodes.map(node => {
+            const Editor = editorByCommand.get(node.sentence.command);
+            if (!node.editable) return <div key={node.nodeId} className={styles.readOnly}>
+              <span>{rowTitle(node)}</span><small>{rowSummary(node)}</small>
+            </div>;
+            return <details key={node.nodeId} className={styles.card} open={node.role === 'dialogue'}>
+              <summary>
+                <span className={styles.rowTitle}>{rowTitle(node)}</span>
+                <span className={styles.summary}>{rowSummary(node)}</span>
+                <span className={styles.line}>第 {node.startLine + 1} 行{errors[node.nodeId] ? ' · 输入待修正' : node.raw !== node.originalRaw ? ' · 已修改' : ''}</span>
+              </summary>
+              <div className={styles.controls}>
+                {(node.command === 'changeBg' || node.command === 'changeFigure') && <p className={styles.hint}>此处编辑素材与原有参数。动画及更多选项请应用或取消后在原语句中设置。</p>}
+                {Editor && <Editor sentence={node.sentence} index={node.startLine} targetPath={targetPath}
+                  disableEffectEditor onSubmit={replacement => updateNode(node.nodeId, replacement)} />}
+                {errors[node.nodeId] && <p role="alert" className={styles.error}>{errors[node.nodeId]}</p>}
+              </div>
+            </details>;
+          })}
+        </DialogContent>
+        {message && <p role="alert" className={styles.error}>{message}</p>}
+        <DialogActions className={styles.actions}>
+          <span className={styles.pending}>{session.changed ? '面板修改尚未应用' : '尚未修改场景'}</span>
+          <Button onClick={cancel}>取消</Button>
+          <Button appearance="primary" onClick={apply}>应用到草稿</Button>
+        </DialogActions>
+      </DialogBody>
+    </DialogSurface>
+  </Dialog>;
+}
