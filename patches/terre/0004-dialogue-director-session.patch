+++ b/packages/origine2/src/pages/editor/SceneDocument/directorSession.ts
@@ -0,0 +1,166 @@
+import type { ISentence } from 'webgal-parser/src/interface/sceneInterface';
+import { analyzeScene, assignMissingNodeIds, inspectSceneIdentity, type SceneBlock } from './sceneContract';
+import { editGraphicalStatement, freshNodeId, nativeRanges } from './graphicalSourceEdits';
+import { applySourceChanges } from '../../../../../terre2/src/Modules/scene-identity/scene-identity';
+
+export interface DirectorSessionNode {
+  /** Existing source identity, or an identity reserved only inside this session. */
+  readonly nodeId: string;
+  readonly startLine: number;
+  readonly command: string;
+  readonly sentence: ISentence;
+  readonly raw: string;
+  readonly originalRaw: string;
+  readonly originallyRegistered: boolean;
+  readonly registered: boolean;
+  readonly editable: boolean;
+  readonly role: 'dialogue' | 'stage' | 'wait' | 'comment';
+}
+
+export interface DirectorSession {
+  readonly expectedSource: string;
+  readonly historyVersion: number;
+  /** Local draft only. Opening and cancelling never touch the shared document. */
+  readonly source: string;
+  readonly selectedNodeId: string;
+  readonly nodes: readonly DirectorSessionNode[];
+  readonly changed: boolean;
+}
+
+const stageCommands = new Set(['changeBg', 'changeFigure', 'changeFigureDiff', 'bgm', 'playEffect']);
+const dialogueBoundaries = new Set(['when', 'next', 'continue', 'concat', 'notend']);
+const hasArgument = (sentence: ISentence, keys: ReadonlySet<string>) => sentence.args.some(arg => keys.has(arg.key));
+const conditional = new Set(['when']);
+
+function isSimpleDialogue(block: SceneBlock, sentence: ISentence) {
+  return block.kind === 'dialogue' && block.graphicalEditable && block.startLine === block.endLine
+    && !hasArgument(sentence, dialogueBoundaries);
+}
+
+function acceptedStage(block: SceneBlock, sentence: ISentence) {
+  return block.kind === 'command' && block.graphicalEditable && block.startLine === block.endLine
+    && !hasArgument(sentence, conditional) && (stageCommands.has(block.command ?? '') || block.command === 'wait');
+}
+
+function checkedAnalysis(source: string) {
+  const analysis = analyzeScene(source);
+  if (!analysis.valid) throw new Error('请先修复脚本或节点身份错误，再打开导演面板。原草稿已保留。');
+  return analysis;
+}
+
+/**
+ * Collect only the immediately preceding linear native commands. This is a
+ * source group, not an inferred stage snapshot or a cross-branch reconstruction.
+ * Comments stay as independent read-only rows; unknown syntax is a boundary.
+ */
+export function createDirectorSession(source: string, startLine: number, historyVersion: number): DirectorSession {
+  if (!Number.isInteger(startLine) || startLine < 0 || !Number.isInteger(historyVersion) || historyVersion < 0) {
+    throw new Error('导演面板的位置已失效，请重新选择对白。');
+  }
+  const analysis = checkedAnalysis(source);
+  const ranges = nativeRanges(source);
+  const index = analysis.blocks.findIndex(block => block.startLine === startLine + 1);
+  const selected = analysis.blocks[index];
+  const selectedSentence = ranges.find(sentence => sentence.startLine === startLine && !sentence.isLineBreakHolder);
+  if (!selected || !selectedSentence || !isSimpleDialogue(selected, selectedSentence)) {
+    throw new Error('导演面板仅支持单行普通对白；条件、连续对白、多行及高级源码请使用原有编辑方式。');
+  }
+  let first = index;
+  for (let candidate = index - 1; candidate >= 0; candidate--) {
+    const block = analysis.blocks[candidate];
+    const sentence = ranges.find(item => item.startLine === block.startLine - 1 && !item.isLineBreakHolder);
+    if (block.kind !== 'comment' && block.kind !== 'blank' && (!sentence || !acceptedStage(block, sentence))) break;
+    first = candidate;
+  }
+  const identity = inspectSceneIdentity(source, ranges);
+  const occupied = new Set(identity.nodes.flatMap(node => node.nodeId ? [node.nodeId] : []));
+  const reserveId = () => {
+    const id = freshNodeId();
+    if (occupied.has(id)) throw new Error('无法创建唯一的会话身份，请重新打开导演面板。');
+    occupied.add(id);
+    return id;
+  };
+  const nodes = analysis.blocks.slice(first, index + 1).map((block): DirectorSessionNode => {
+    const sentence = ranges.find(item => item.startLine === block.startLine - 1 && !item.isLineBreakHolder);
+    if (!sentence) throw new Error('无法定位原生语句，请重新打开导演面板。');
+    const node = identity.nodes.find(item => item.startLine === sentence.startLine);
+    const role = block === selected ? 'dialogue' : block.kind === 'comment' || block.kind === 'blank'
+      ? 'comment' : block.command === 'wait' ? 'wait' : 'stage';
+    // A reserved ID is not written until this particular node actually changes.
+    return {
+      nodeId: node?.nodeId ?? reserveId(), startLine: sentence.startLine,
+      command: block.command ?? sentence.commandRaw, sentence, raw: block.raw, originalRaw: block.raw,
+      originallyRegistered: !!node?.nodeId, registered: !!node?.nodeId,
+      editable: role === 'dialogue' || role === 'stage', role,
+    };
+  });
+  return { expectedSource: source, historyVersion, source, selectedNodeId: nodes[nodes.length - 1].nodeId, nodes, changed: false };
+}
+
+function refreshNodes(session: DirectorSession, source: string): DirectorSession {
+  const analysis = checkedAnalysis(source);
+  const ranges = nativeRanges(source);
+  const identity = inspectSceneIdentity(source, ranges);
+  const nodes = session.nodes.map((node): DirectorSessionNode => {
+    const identified = identity.nodes.find(item => item.nodeId === node.nodeId);
+    // Unregistered rows cannot move: this API never inserts, deletes or folds.
+    if (!identified && node.originallyRegistered) throw new Error('节点身份已改变，导演草稿未应用。');
+    const line = identified?.startLine ?? node.startLine;
+    const block = analysis.blocks.find(item => item.startLine === line + 1);
+    const sentence = ranges.find(item => item.startLine === line && !item.isLineBreakHolder);
+    if (!block || !sentence || line !== node.startLine) throw new Error('语句范围已改变，导演草稿未应用。');
+    if (node.role === 'dialogue' && !isSimpleDialogue(block, sentence)) {
+      throw new Error('本面板不支持把对白改为条件或连续对白，请取消后使用原有编辑方式。');
+    }
+    if (node.role === 'stage' && !acceptedStage(block, sentence)) {
+      throw new Error('该修改超出本面板支持的单行演出参数，导演草稿未应用。');
+    }
+    return { ...node, sentence, raw: block.raw, registered: !!identified };
+  });
+  return { ...session, source, nodes, changed: source !== session.expectedSource };
+}
+
+/** Immutable local edit, using the existing native serializer/token projection. */
+export function editDirectorSession(session: DirectorSession, nodeId: string, replacement: string): DirectorSession {
+  const selected = session.nodes.find(node => node.nodeId === nodeId);
+  if (!selected?.editable) throw new Error('该行仅供参考，不能在导演面板修改。');
+  let source = session.source;
+  let ranges = nativeRanges(source);
+  let identity = inspectSceneIdentity(source, ranges);
+  let target = identity.nodes.find(node => node.nodeId === nodeId);
+  if (!target) {
+    if (selected.registered) throw new Error('节点身份已改变，导演草稿未应用。');
+    const unregistered = identity.nodes.find(node => node.startLine === selected.startLine);
+    if (!unregistered || unregistered.nodeId || source.slice(unregistered.start, unregistered.end) !== selected.raw) {
+      throw new Error('语句已经改变，请重新打开导演面板。');
+    }
+    source = assignMissingNodeIds(source, ranges, () => nodeId, { eligibleStartLines: [selected.startLine] }).source;
+    ranges = nativeRanges(source);
+    identity = inspectSceneIdentity(source, ranges);
+    target = identity.nodes.find(node => node.nodeId === nodeId);
+  }
+  if (!target) throw new Error('无法定位节点身份，导演草稿未应用。');
+  const edited = editGraphicalStatement(source, target.startLine, replacement);
+  // A serializer spelling-only change must not silently register an identity.
+  if (edited === source) return session;
+  source = edited;
+  if (!selected.originallyRegistered) {
+    const editedNode = inspectSceneIdentity(source, nativeRanges(source)).nodes.find(node => node.nodeId === nodeId);
+    const suffix = `; @makenovel-node ${nodeId}`;
+    if (editedNode && source.slice(editedNode.start, editedNode.end) === selected.originalRaw + suffix) {
+      source = applySourceChanges(source, [{
+        start: editedNode.end - suffix.length, end: editedNode.end, before: suffix, after: '',
+      }]).source;
+    }
+  }
+  return refreshNodes(session, source);
+}
+
+/** Caller commits the returned text with exactly one shared document.edit(). */
+export function commitDirectorSession(currentSource: string, currentHistoryVersion: number, session: DirectorSession): string {
+  if (currentSource !== session.expectedSource || currentHistoryVersion !== session.historyVersion) {
+    throw new Error('主文档已改变，导演草稿未应用。请保留需要的内容，关闭面板后重新打开。');
+  }
+  if (!session.changed) return currentSource;
+  return refreshNodes(session, session.source).source;
+}
