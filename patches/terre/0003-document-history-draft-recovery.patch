diff --git a/packages/origine2/src/pages/editor/SceneDocument/DraftRecovery.tsx b/packages/origine2/src/pages/editor/SceneDocument/DraftRecovery.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e2f7343acfe2a900ba8147dbdf11db7c72428ee7
--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/DraftRecovery.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useState } from 'react';
+import type { DocumentState, SceneDocument } from './sceneDocument';
+import { listRecoveryDrafts } from './sceneDocumentRegistry';
+import type { RecoveryDraft } from './draftVault';
+import styles from './documentBar.module.scss';
+
+export function DraftRecovery({ document, state }: { document: SceneDocument; state: DocumentState }) {
+  const [open, setOpen] = useState(false);
+  const [copies, setCopies] = useState<RecoveryDraft[]>([]);
+  const [error, setError] = useState('');
+  const refresh = () => {
+    try { setCopies(listRecoveryDrafts(document)); setError(''); }
+    catch { setError('无法读取本机恢复副本。当前草稿仍可下载备份。'); }
+  };
+  useEffect(() => {
+    if (!open) return;
+    refresh();
+    const changed = () => refresh();
+    window.addEventListener('storage', changed);
+    return () => window.removeEventListener('storage', changed);
+  }, [document, open, state.revision]);
+  const download = (copy: RecoveryDraft) => {
+    const url = URL.createObjectURL(new Blob([copy.text], { type: 'text/plain;charset=utf-8' }));
+    const anchor = globalThis.document.createElement('a');
+    anchor.href = url;
+    anchor.download = `scene-recovery-${copy.updatedAt || 'legacy'}.txt`;
+    anchor.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  };
+  const canRecover = !!state.revision && !document.hasUnsavedChanges() && !['loading', 'saving', 'conflict'].includes(state.status);
+  return <details className={styles.recovery} onToggle={event => setOpen(event.currentTarget.open)}>
+    <summary>本机恢复副本</summary>
+    {open && <>
+      <p>副本保存在此浏览器中，关闭页面后可在同一工作区、同一场景恢复。各窗口独立保留；不会自动覆盖磁盘。其他场景请打开对应文件查看。</p>
+      <button type="button" onClick={refresh}>刷新副本列表</button>
+      {error && <p role="alert">{error}</p>}
+      {!error && copies.length === 0 && <p>没有其他页面留下的可恢复副本。</p>}
+      {!canRecover && <p>恢复前请先保存当前草稿，或下载备份并载入磁盘版本。</p>}
+      <ul>{copies.map(copy => <li key={copy.id}>
+        <strong>{copy.legacy ? '旧版标签页草稿（请核对作品）' : new Date(copy.updatedAt).toLocaleString()}</strong>
+        <span>{copy.revision === state.revision ? '基于当前磁盘版本' : '基于其他版本，恢复后需处理冲突'}</span>
+        <pre>{copy.text.slice(0, 240)}{copy.text.length > 240 ? '…' : ''}</pre>
+        <button type="button" onClick={() => download(copy)}>下载此副本</button>{' '}
+        <button type="button" disabled={!canRecover} onClick={() => { document.recoverDraft(copy); }}>恢复到草稿</button>
+      </li>)}</ul>
+      <p>浏览器清理数据或容量不足会影响恢复；重要内容请另存文件。其他副本保留，不自动清理。</p>
+    </>}
+  </details>;
+}
