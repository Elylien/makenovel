index 0000000000000000000000000000000000000000..0150891b1e953c85a71401d450d3ef0ffa1e5d5d
--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/draftVault.ts
@@ -0,0 +1,72 @@
+import type { DraftStorage, TextSnapshot } from './sceneDocument';
+
+export interface KeyValueStorage {
+  readonly length: number;
+  key(index: number): string | null;
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+  removeItem(key: string): void;
+}
+export interface RecoveryDraft extends TextSnapshot { id: string; updatedAt: number; legacy?: boolean }
+
+/** Each document instance owns one record. Other tabs' recovery copies are never overwritten. */
+export class DraftVault implements DraftStorage {
+  private prefix: string;
+  private sessionKey: string;
+  private ownKey: string;
+  private legacyKey: string;
+  constructor(private durable: KeyValueStorage, private session: KeyValueStorage, workspaceId: string,
+    path: string, owner: string, private now: () => number = Date.now) {
+    if (!/^[a-f0-9]{64}$/.test(workspaceId) || !owner) throw new Error('无法确定草稿所属工作区。');
+    this.prefix = `makenovel.scene-recovery.v2:${workspaceId}:${encodeURIComponent(path)}:`;
+    this.sessionKey = `${this.prefix}session`;
+    this.ownKey = `${this.prefix}${owner}`;
+    this.legacyKey = `makenovel.scene-draft.v1:${path}`;
+  }
+  read = () => this.session.getItem(this.sessionKey);
+  write = (raw: string) => {
+    // Keep the session copy even when the durable quota is exhausted. Report the
+    // failure to SceneDocument; never evict another tab's only recovery copy.
+    const draft = parseDraft(raw);
+    if (!draft) throw new Error('无法暂存未知格式的草稿。');
+    let failed = false;
+    try { this.session.setItem(this.sessionKey, raw); } catch { failed = true; }
+    try { this.durable.setItem(this.ownKey, JSON.stringify({ version: 2, updatedAt: this.now(), draft })); } catch { failed = true; }
+    if (failed) throw new Error('部分浏览器存储不可用，请下载草稿备份。');
+  };
+  clear = () => {
+    let failed = false;
+    try { this.durable.removeItem(this.ownKey); } catch { failed = true; }
+    try { this.session.removeItem(this.sessionKey); } catch { failed = true; }
+    if (failed) throw new Error('部分暂存副本无法清理。');
+  };
+  list(): RecoveryDraft[] {
+    const result: RecoveryDraft[] = [];
+    // Old session-only data had no workspace identity. Keep it available for
+    // explicit review, but never silently restore it into the new workspace.
+    let legacy: ReturnType<typeof parseDraft> = null;
+    try { legacy = parseDraft(this.session.getItem(this.legacyKey) ?? undefined); } catch { /* Durable copies remain available if session storage is disabled. */ }
+    if (legacy) result.push({ ...legacy, id: this.legacyKey, updatedAt: 0, legacy: true });
