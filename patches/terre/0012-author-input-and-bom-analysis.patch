diff --git a/packages/origine2/src/utils/isImeKeyEvent.ts b/packages/origine2/src/utils/isImeKeyEvent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef3081945fb2412ee2b33811245833d30b15866e
--- /dev/null
+++ b/packages/origine2/src/utils/isImeKeyEvent.ts
@@ -0,0 +1,16 @@
+interface CompositionKeyEvent {
+  isComposing?: boolean;
+  keyCode?: number;
+  nativeEvent?: {
+    isComposing?: boolean;
+    keyCode?: number;
+  };
+}
+
+/** Candidate-confirmation keys must not submit an author form or close its editor. */
+export function isImeKeyEvent(event: CompositionKeyEvent): boolean {
+  const nativeEvent = event.nativeEvent ?? event;
+  // Some IMEs report 229 on the confirming key even when isComposing is already false.
+  return event.isComposing === true || nativeEvent.isComposing === true ||
+    event.keyCode === 229 || nativeEvent.keyCode === 229;
+}
