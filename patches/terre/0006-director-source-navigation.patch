--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/directorNavigation.ts
@@ -0,0 +1,97 @@
+import type { DirectorSession, DirectorSourceFact } from './directorSession';
+import { analyzeScene, inspectSceneIdentity } from './sceneContract';
+import { nativeRanges } from './graphicalSourceEdits';
+
+/** A location within one exact shared-document snapshot; never a write intent. */
+export interface DirectorNavigationLocator {
+  readonly expectedSource: string;
+  readonly historyVersion: number;
+  /** Zero-based physical source line, as used by the native parser. */
+  readonly startLine: number;
+  readonly raw: string;
+  readonly command: string;
+  /** Only a source-registered identity, never the director's reserved local ID. */
+  readonly nodeId?: string;
+}
+
+export interface DirectorSourceNavigation {
+  readonly target: DirectorNavigationLocator;
+  readonly origin: DirectorNavigationLocator;
+}
+
+export interface DirectorNavigationLocation {
+  readonly startLine: number;
+  readonly raw: string;
+  readonly command: string;
+  readonly nodeId?: string;
+}
+
+function sourceLocation(source: string, startLine: number): DirectorNavigationLocation {
+  if (!Number.isInteger(startLine) || startLine < 0) throw new Error('来源位置已失效，请重新打开导演面板。');
+  const analysis = analyzeScene(source);
+  const block = analysis.blocks.find(item => item.startLine === startLine + 1);
+  const ranges = nativeRanges(source);
+  const sentence = ranges.find(item => item.startLine === startLine && !item.isLineBreakHolder);
+  const identity = inspectSceneIdentity(source, ranges);
+  const node = identity.nodes.find(item => item.startLine === startLine);
+  if (!analysis.valid || !block || !sentence || !node || block.startLine !== block.endLine
+    || (block.kind !== 'command' && block.kind !== 'dialogue')) {
+    throw new Error('来源语句无法安全定位，请重新打开导演面板。');
+  }
+  return { startLine, raw: source.slice(node.start, node.end), command: block.command ?? sentence.commandRaw,
+    ...(node.nodeId ? { nodeId: node.nodeId } : {}) };
+}
+
+function sameFact(left: DirectorSourceFact, right: DirectorSourceFact) {
+  return left.target === right.target && left.status === right.status && left.command === right.command
+    && left.content === right.content && left.startLine === right.startLine
+    && left.nodeId === right.nodeId && left.scope === right.scope;
+}
+
+/**
+ * Build a source/return pair without registering IDs, editing or saving. The UI
+ * also guards unfinished controls and binds this pair to its scene document.
+ */
+export function createDirectorSourceNavigation(session: DirectorSession, fact: DirectorSourceFact): DirectorSourceNavigation {
+  if (session.changed || session.source !== session.expectedSource) {
+    throw new Error('导演面板还有未应用修改，请先应用或取消修改，再定位来源。');
+  }
+  if (!Number.isInteger(session.historyVersion) || session.historyVersion < 0) {
+    throw new Error('导演面板的文档版本已失效，请重新打开。');
+  }
+  const facts = [session.inheritance.background, session.inheritance.bgm,
+    ...session.inheritance.figures, ...session.inheritance.effects];
+  if (fact.startLine === undefined || !fact.command || fact.status === 'not-seen'
+    || !facts.some(candidate => sameFact(candidate, fact))) {
+    throw new Error('该设置没有可定位的本场景来源。');
+  }
+  const selected = session.nodes.find(node => node.nodeId === session.selectedNodeId);
+  if (!selected || selected.role !== 'dialogue' || selected.origin !== 'existing') {
+    throw new Error('原对白位置已失效，请重新打开导演面板。');
+  }
+  const target = sourceLocation(session.expectedSource, fact.startLine);
+  const origin = sourceLocation(session.expectedSource, selected.startLine);
+  if (target.command !== fact.command || target.startLine >= origin.startLine
+    || origin.raw !== selected.originalRaw || origin.command !== selected.command
+    || (selected.originallyRegistered && origin.nodeId !== selected.nodeId)) {
+    throw new Error('来源或原对白已改变，请重新打开导演面板。');
+  }
+  const locator = (location: DirectorNavigationLocation): DirectorNavigationLocator => Object.freeze({
+    expectedSource: session.expectedSource, historyVersion: session.historyVersion, ...location,
+  });
+  return Object.freeze({ target: locator(target), origin: locator(origin) });
+}
+
+/** Recheck immediately before focusing or returning; undo/redo ABA is stale too. */
+export function resolveDirectorNavigation(
+  currentSource: string, currentHistoryVersion: number, locator: DirectorNavigationLocator,
+): DirectorNavigationLocation {
+  if (currentSource !== locator.expectedSource || currentHistoryVersion !== locator.historyVersion) {
+    throw new Error('主文档已改变，来源定位已失效。请重新打开导演面板。');
+  }
+  const location = sourceLocation(currentSource, locator.startLine);
+  if (location.raw !== locator.raw || location.command !== locator.command || location.nodeId !== locator.nodeId) {
+    throw new Error('来源身份或原文已改变，无法定位。请重新打开导演面板。');
+  }
+  return location;
+}
