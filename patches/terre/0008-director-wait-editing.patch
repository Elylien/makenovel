+// Match getBooleanArgByKey/toSafeBoolean without evaluating source or variables.
+function nativeBoolean(value: unknown): boolean | null {
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  if (typeof value === 'string') {
+    if (value.trim().toLowerCase() === 'true') return true;
+    if (value.trim().toLowerCase() === 'false') return false;
+  }
+  return null;
+}
+
+function configuredDurations(node: DirectorSessionNode): string {
+  const values = ['duration', 'enterDuration', 'exitDuration'].flatMap(key => {
+    const value = firstArgument(node, key);
+    return typeof value === 'number' && Number.isFinite(value) ? [`${key}=${value} 毫秒`] : [];
+  });
+  return values.length ? ` 时长配置：${values.join('，')}；实际演出还受动画与运行状态影响。` : '';
+}
+
+/** Source-level guidance only; never a timeline, runtime snapshot or edit. */
+export function directorExecutionNote(node: DirectorSessionNode): string | null {
+  if (node.role !== 'wait' && node.role !== 'stage') return null;
+  const args = node.sentence.args;
+  const dynamic = [node.sentence.content, ...args.map(arg => String(arg.value))]
+    .some(value => /[{}]/.test(value));
+  if (dynamic || args.some(arg => arg.key === 'when')) {
+    return '包含条件或动态内容，执行时按原文解析；本面板不推断完成时间或舞台终态。';
+  }
+
+  if (node.role === 'wait') {
+    if (args.some(arg => arg.key === 'next' || arg.key === 'continue')) {
+      return '等待带有 next 或 continue 参数，执行顺序按原文处理；可能与其他演出重叠，不据此推算停留时间。';
+    }
+    const content = node.sentence.content;
+    const duration = Number(content);
+    if (!/^[0-9]+$/.test(content) || !Number.isSafeInteger(duration) || duration > 2147483647) {
+      return '等待时长按原文执行；此处不推算实际停留时间。';
+    }
+    const value = firstArgument(node, 'nobreak');
+    const nobreak = value === undefined ? false : nativeBoolean(value);
+    const skip = nobreak === true ? '点击与快进不会提前结束此等待'
+      : nobreak === false ? '点击或快进可提前结束此等待'
+        : '能否提前结束按原文参数处理';
+    return `配置等待 ${duration} 毫秒；${skip}，自动播放仍等待结束。菜单内计时继续，剧情推进延后到菜单关闭；实际停留还受其他演出和运行状态影响。`;
+  }
+
+  const next = ADD_NEXT_ARG_LIST.includes(node.sentence.command)
+    || (nativeBoolean(firstArgument(node, 'next')) ?? false);
+  const order = next ? '立即继续执行后续命令，演出可能与后续内容重叠。'
+    : '未开启立即继续，推进以原生演出完成与玩家输入为准。';
+  const continuation = args.some(arg => arg.key === 'continue')
+    ? ' continue 参数按原文处理，不据此推断完成时间。' : '';
+  return order + continuation + configuredDurations(node);
+}
