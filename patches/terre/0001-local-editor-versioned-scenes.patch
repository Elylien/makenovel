diff --git a/packages/origine2/src/pages/editor/SceneDocument/sceneDocument.ts b/packages/origine2/src/pages/editor/SceneDocument/sceneDocument.ts
new file mode 100644
index 0000000..13a7093
--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/sceneDocument.ts
@@ -0,0 +1,153 @@
+export interface TextSnapshot { text: string; revision: string }
+export interface SnapshotTransport {
+  read(): Promise<TextSnapshot>;
+  save(text: string, expectedRevision: string): Promise<TextSnapshot>;
+}
+export interface DraftStorage {
+  read(): string | null;
+  write(value: string): void;
+  clear(): void;
+}
+export type DocumentStatus = 'loading' | 'saved' | 'dirty' | 'saving' | 'conflict' | 'error';
+export interface DocumentState {
+  text: string;
+  revision: string | null;
+  status: DocumentStatus;
+  message: string;
+  recoveryWarning: string;
+}
+
+/** A single file session shared by both editor modes. Network completion never replaces newer input. */
+export class SceneDocument {
+  private state: DocumentState = { text: '', revision: null, status: 'loading', message: '', recoveryWarning: '' };
+  private listeners = new Set<() => void>();
+  private savedText = '';
+  private pendingRead: Promise<void> | null = null;
+  private pendingSave: Promise<boolean> | null = null;
+  private initialized = false;
+  private preserveUnknownDraft = false;
+  constructor(private transport: SnapshotTransport, private storage: DraftStorage) {}
+  getSnapshot = () => this.state;
+  subscribe = (listener: () => void) => { this.listeners.add(listener); return () => { this.listeners.delete(listener); }; };
+  canPreview = () => this.state.status === 'saved';
+  private publish(next: Partial<DocumentState>) {
+    this.state = { ...this.state, ...next };
+    for (const listener of this.listeners) listener();
+  }
+  private persist() {
+    if (this.preserveUnknownDraft) return;
+    try {
+      if (this.state.status === 'saved') this.storage.clear();
+      else if (this.state.revision) this.storage.write(JSON.stringify({ version: 1, text: this.state.text, revision: this.state.revision }));
+    } catch {
+      this.publish({ recoveryWarning: '浏览器无法暂存草稿，请下载草稿备份后再关闭页面。' });
+    }
+  }
+  edit(text: string) {
+    if (!this.state.revision || text === this.state.text) return;
+    const blocked = this.state.status === 'conflict';
+    this.publish({ text, status: blocked ? 'conflict' : this.pendingSave ? 'saving' : text === this.savedText ? 'saved' : 'dirty', message: blocked ? this.state.message : '' });
+    this.persist();
+  }
+  load = (): Promise<void> => {
+    if (this.pendingRead) return this.pendingRead;
+    // Do not race a stale read against an acknowledged write.
+    if (this.pendingSave) return this.pendingSave.then(() => undefined);
+    this.pendingRead = this.read().finally(() => { this.pendingRead = null; });
+    return this.pendingRead;
+  };
+  private async read() {
+    const revisionAtStart = this.state.revision;
+    try {
+      const snapshot = await this.transport.read();
+      if (this.state.revision !== revisionAtStart || this.pendingSave) return;
+      if (!this.initialized) {
+        this.initialized = true;
+        this.savedText = snapshot.text;
+        let recovered: TextSnapshot | undefined;
+        let warning = '';
+        let unknownDraft: string | null = null;
+        try {
+          const raw = this.storage.read();
+          let value;
+          try { value = raw ? JSON.parse(raw) : null; } catch { value = null; }
+          if (value?.version === 1 && typeof value.text === 'string' && /^[a-f0-9]{64}$/.test(value.revision)) recovered = value;
+          else if (raw) { unknownDraft = raw; warning = '暂存草稿格式无法识别，已保留原始数据。请先下载草稿备份，再载入磁盘版本。'; }
+        } catch { warning = '无法读取浏览器暂存草稿。'; }
+        if (unknownDraft !== null) {
+          this.preserveUnknownDraft = true;
+          this.publish({ text: unknownDraft, revision: snapshot.revision, status: 'conflict', message: warning, recoveryWarning: warning });
+          return;
+        }
+        const text = recovered?.text ?? snapshot.text;
+        const conflict = !!recovered && recovered.revision !== snapshot.revision && text !== snapshot.text;
+        this.publish({ text, revision: conflict ? recovered!.revision : snapshot.revision,
+          status: conflict ? 'conflict' : text === snapshot.text ? 'saved' : 'dirty',
+          message: conflict ? '恢复的草稿与磁盘版本不同。请先下载草稿，再载入磁盘版本比较。' : recovered && text !== snapshot.text ? '已恢复本标签页的未保存草稿。' : '', recoveryWarning: warning });
+      } else if (snapshot.revision === this.state.revision) {
+        if (this.state.status === 'error') this.publish({ status: this.state.text === this.savedText ? 'saved' : 'dirty', message: '' });
+      } else if (this.state.text !== this.savedText || this.state.status === 'conflict') {
+        this.publish({ status: 'conflict', message: '磁盘文件已被其他窗口或程序修改。本地草稿已保留，未覆盖文件。' });
+      } else {
+        this.savedText = snapshot.text;
+        this.publish({ ...snapshot, status: 'saved', message: '' });
+      }
+      this.persist();
+    } catch (error) { this.publish({ status: this.state.status === 'conflict' ? 'conflict' : 'error', message: errorMessage(error) }); }
+  }
+  save = (): Promise<boolean> => {
+    if (this.pendingSave) return this.pendingSave;
+    if (!this.state.revision || this.state.status === 'conflict' || this.state.status === 'loading' || this.pendingRead) return Promise.resolve(false);
+    if (this.state.status === 'saved') return Promise.resolve(true);
+    const submitted = this.state.text;
+    const expectedRevision = this.state.revision;
+    this.publish({ status: 'saving', message: '' });
+    this.pendingSave = this.transport.save(submitted, expectedRevision).then(snapshot => {
+      this.savedText = snapshot.text;
+      const current = this.state.text === submitted;
+      this.publish({ revision: snapshot.revision, status: current ? 'saved' : 'dirty', message: current ? '' : '保存期间的新修改仍在草稿中，请再次保存。' });
+      this.persist();
+      return current;
+    }).catch(error => {
+      const conflict = (error as { code?: string }).code === 'REVISION_CONFLICT';
+      this.publish({ status: conflict ? 'conflict' : 'error', message: errorMessage(error) });
+      this.persist();
+      return false;
+    }).finally(() => { this.pendingSave = null; });
+    return this.pendingSave;
+  };
+  /** Call only after the user has downloaded/backed up the local draft and explicitly selected reload. */
+  reloadDisk = (): Promise<void> => {
+    if (this.pendingSave || this.pendingRead) return Promise.resolve();
+    this.pendingRead = this.replaceFromDisk().finally(() => { this.pendingRead = null; });
+    return this.pendingRead;
+  };
+  private async replaceFromDisk() {
+    const textAtStart = this.state.text;
+    const revisionAtStart = this.state.revision;
+    try {
+      const snapshot = await this.transport.read();
+      if (this.state.text !== textAtStart || this.state.revision !== revisionAtStart) {
+        this.publish({ message: '载入期间草稿发生变化，已保留新修改，请重试。' });
+        return;
+      }
+      this.savedText = snapshot.text;
+      this.initialized = true;
+      this.preserveUnknownDraft = false;
+      this.publish({ ...snapshot, status: 'saved', message: '', recoveryWarning: '' });
+      this.persist();
+    } catch (error) { this.publish({ message: errorMessage(error) }); }
+  }
+}
+
+function errorMessage(error: unknown): string {
+  if ((error as { code?: string })?.code === 'REVISION_CONFLICT') return '磁盘文件已变化，保存被拒绝。本地草稿已保留，请下载后与磁盘版本比较。';
+  return error instanceof Error ? error.message : '读取或保存失败，草稿已保留，请重试。';
+}
+
+export function parseScenePath(targetPath: string) {
+  const parts = targetPath.replace(/^\//, '').split('/');
+  if (parts[0] !== 'games' || !parts[1] || parts.length < 4) throw new Error('无法识别作品脚本路径');
+  // These are filesystem-oriented paths from EditArea, not percent-encoded URLs.
+  return { gameName: parts[1], path: parts.slice(2).join('/') };
+}
diff --git a/packages/origine2/src/pages/editor/SceneDocument/sceneDocumentRegistry.ts b/packages/origine2/src/pages/editor/SceneDocument/sceneDocumentRegistry.ts
new file mode 100644
index 0000000..e115294
--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/sceneDocumentRegistry.ts
@@ -0,0 +1,32 @@
+import axios from "axios";
+import { SceneDocument, parseScenePath, type TextSnapshot } from "./sceneDocument";
+
+const documents = new Map<string, SceneDocument>();
+export function getDocument(path: string) {
+  let document = documents.get(path);
+  if (document) return document;
+  const address = parseScenePath(path);
+  const request = async (endpoint: string, data: object): Promise<TextSnapshot> => {
+    try { return (await axios.post(`/api/manageGame/${endpoint}`, { ...address, ...data })).data; }
+    catch (error) {
+      const detail = axios.isAxiosError(error) ? error.response?.data : null;
+      throw Object.assign(new Error(detail?.message || '无法连接编辑器，草稿已保留，请重试。'), { code: detail?.code });
+    }
+  };
+  const key = `makenovel.scene-draft.v1:${path}`;
+  document = new SceneDocument({ read: () => request('textSnapshot', {}), save: (text, expectedRevision) => request('saveTextSnapshot', { text, expectedRevision }) }, {
+    read: () => sessionStorage.getItem(key), write: value => sessionStorage.setItem(key, value), clear: () => sessionStorage.removeItem(key),
+  });
+  documents.set(path, document);
+  return document;
+}
+
+// One listener for the application; drafts are retained when closing an editor tab or changing modes.
+window.addEventListener('beforeunload', event => {
+  if ([...documents.values()].some(doc => !doc.canPreview() && doc.getSnapshot().revision)) { event.preventDefault(); event.returnValue = ''; }
+});
+
+
+export function canPreviewDocuments() { return [...documents.values()].every(document => document.canPreview()); }
+
+export function pendingScenePaths() { return [...documents.entries()].filter(([, document]) => !document.canPreview()).map(([path]) => path); }
diff --git a/packages/origine2/src/pages/editor/SceneDocument/sourceEdits.ts b/packages/origine2/src/pages/editor/SceneDocument/sourceEdits.ts
new file mode 100644
index 0000000..925ac46
--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/sourceEdits.ts
@@ -0,0 +1,19 @@
+interface SourceChange {
+  range: { startLineNumber: number; startColumn: number; endLineNumber: number; endColumn: number };
+  text: string;
+}
+/** Monaco excludes the BOM and normalizes line endings; map edits back onto the original text. */
+export function applySourceEdits(raw: string, changes: readonly SourceChange[]) {
+  const bom = raw.startsWith('\uFEFF') ? '\uFEFF' : '';
+  const body = raw.slice(bom.length);
+  const lines = body.split('\n');
+  const offset = (line: number, column: number) => {
+    let value = column - 1;
+    for (let i = 0; i < line - 1; i++) value += lines[i].length + 1;
+    return value;
+  };
+  const patches = changes.map(change => ({ start: offset(change.range.startLineNumber, change.range.startColumn), end: offset(change.range.endLineNumber, change.range.endColumn), text: change.text }));
+  let result = body;
+  for (const patch of patches.sort((a, b) => b.start - a.start)) result = result.slice(0, patch.start) + patch.text + result.slice(patch.end);
+  return bom + result;
+}
diff --git a/packages/origine2/src/pages/editor/SceneDocument/useSceneDocument.ts b/packages/origine2/src/pages/editor/SceneDocument/useSceneDocument.ts
new file mode 100644
index 0000000..e2f738b
--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/useSceneDocument.ts
@@ -0,0 +1,17 @@
+import { useEffect, useMemo, useSyncExternalStore } from "react";
+import { eventBus } from "@/utils/eventBus";
+import { getDocument } from "./sceneDocumentRegistry";
+
+export function useSceneDocument(path: string) {
+  const document = useMemo(() => getDocument(path), [path]);
+  const state = useSyncExternalStore(document.subscribe, document.getSnapshot);
+  useEffect(() => {
+    void document.load();
+    const refresh = () => { if (globalThis.document.visibilityState === 'visible') void document.load(); };
+    window.addEventListener('focus', refresh);
+    globalThis.document.addEventListener('visibilitychange', refresh);
+    return () => { window.removeEventListener('focus', refresh); globalThis.document.removeEventListener('visibilitychange', refresh); };
+  }, [document]);
+  useEffect(() => { if (state.status === 'saved') eventBus.emit('editor:update-scene', { scene: state.text }); }, [state.status, state.text]);
+  return { document, state };
+}
