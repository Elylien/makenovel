@@ -0,0 +1,323 @@
+import { HttpException } from '@nestjs/common';
+import { createHash, randomUUID } from 'crypto';
+import * as fs from 'fs/promises';
+import {
+  basename,
+  dirname,
+  isAbsolute,
+  join,
+  relative,
+  resolve,
+  sep,
+} from 'path';
+
+export interface TextFileSnapshot {
+  text: string;
+  revision: string;
+}
+
+/**
+ * Serializes cooperating editor writers and atomically replaces existing files.
+ * An unrelated process can still write between the last hash check and rename:
+ * portable filesystem APIs do not offer compare-and-swap against a content hash.
+ */
+export class TextFileTransactions {
+  private static readonly queues = new Map<string, Promise<void>>();
+
+  constructor(
+    private readonly getGamesRoot: () => string,
+    private readonly lockWaitMs = 5000,
+  ) {}
+
+  async read(gameName: string, path: string): Promise<TextFileSnapshot> {
+    try {
+      const target = await this.resolveTarget(gameName, path);
+      // Cooperating replacements are atomic, so cross-process reads see a whole
+      // old or new file. Do not let an orphaned write lock prevent recovery reads.
+      return await this.serial(target, async () => {
+        await this.ensureSameTarget(gameName, path, target);
+        return this.snapshot(await fs.readFile(target));
+      });
+    } catch (error) {
+      throw this.fileError(error);
+    }
+  }
+
+  async save(
+    gameName: string,
+    path: string,
+    text: string,
+    expectedRevision: string,
+  ): Promise<TextFileSnapshot> {
+    if (
+      typeof text !== 'string' ||
+      typeof expectedRevision !== 'string' ||
+      !/^[a-f0-9]{64}$/.test(expectedRevision)
+    ) {
+      throw this.failure(
+        400,
+        'INVALID_REQUEST',
+        'Text and a SHA256 expectedRevision are required.',
+      );
+    }
+    const bytes = Buffer.from(text, 'utf8');
+    // Do not silently replace unpaired surrogates or accept binary data as text.
+    if (bytes.toString('utf8') !== text || text.includes('\0')) {
+      throw this.failure(
+        422,
+        'INVALID_UTF8',
+        'The submitted text is not lossless UTF-8 text.',
+      );
+    }
+    try {
+      const target = await this.resolveTarget(gameName, path);
+      return await this.serial(target, async () => {
+        await this.ensureSameTarget(gameName, path, target);
+        const lockPath = join(
+          dirname(target),
+          `.${basename(target)}.makenovel.lock`,
+        );
+        const lock = await this.acquireLock(lockPath);
+        let temporaryPath: string | undefined;
+        let committed = false;
+        try {
+          await this.ensureSameTarget(gameName, path, target);
+          this.checkRevision(await fs.readFile(target), expectedRevision);
+          const originalStat = await fs.stat(target);
+          temporaryPath = join(
+            dirname(target),
+            `.${basename(target)}.${randomUUID()}.tmp`,
+          );
+          const temporary = await fs.open(
+            temporaryPath,
+            'wx',
+            originalStat.mode,
+          );
+          try {
+            await temporary.writeFile(bytes);
+            await temporary.sync();
+          } finally {
+            await temporary.close();
+          }
+          // Validate again after I/O, including rechecking links and missing files.
+          await this.ensureSameTarget(gameName, path, target);
+          this.checkRevision(await fs.readFile(target), expectedRevision);
+          await fs.rename(temporaryPath, target);
+          temporaryPath = undefined;
+          committed = true;
+          return this.snapshot(bytes);
+        } finally {
+          // No unlink of the destination: failed writes retain the original file.
+          try {
+            if (temporaryPath) {
+              await fs
+                .chmod(temporaryPath, 0o600)
+                .catch((error: NodeJS.ErrnoException) => {
+                  if (error.code !== 'ENOENT') throw error;
+                });
+              await fs
+                .unlink(temporaryPath)
+                .catch((error: NodeJS.ErrnoException) => {
+                  if (error.code !== 'ENOENT') throw error;
+                });
+            }
+          } finally {
+            await lock.close();
+            try {
+              await fs.unlink(lockPath);
+            } catch (error) {
+              throw this.fileError(error, committed);
+            }
+          }
+        }
+      });
+    } catch (error) {
+      throw this.fileError(error);
+    }
+  }
+
+  private async ensureSameTarget(
+    gameName: string,
+    path: string,
+    target: string,
+  ) {
+    if ((await this.resolveTarget(gameName, path)) !== target) {
+      throw this.failure(
+        409,
+        'EDIT_TARGET_CHANGED',
+        'The active game location changed; reload before editing.',
+      );
+    }
+  }
+
+  private async resolveTarget(gameName: string, path: string): Promise<string> {
+    if (
+      typeof gameName !== 'string' ||
+      typeof path !== 'string' ||
+      gameName.length === 0 ||
+      /[/\\]/.test(gameName) ||
+      path.length === 0 ||
+      isAbsolute(path)
+    ) {
+      throw this.failure(
+        400,
+        'INVALID_PATH',
+        'A game name and a relative file path are required.',
+      );
+    }
+    // JSON inputs are already plain text. Decoding here would corrupt literal % names.
+    const segments = [gameName, ...path.replace(/\\/g, '/').split('/')];
+    if (
+      segments.some(
+        (segment) =>
+          !segment ||
+          segment === '.' ||
+          segment === '..' ||
+          /[\x00-\x1f<>:"|?*]/.test(segment) ||
+          /[ .]$/.test(segment) ||
+          /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i.test(segment),
+      )
+    ) {
+      throw this.failure(
+        400,
+        'INVALID_PATH',
+        'The file path contains an invalid segment.',
+      );
+    }
+    const root = resolve(this.getGamesRoot());
+    const rootStat = await fs.lstat(root);
+    if (!rootStat.isDirectory() || rootStat.isSymbolicLink()) {
+      throw this.failure(
+        403,
+        'FORBIDDEN_PATH',
+        'The game root must be a real directory.',
+      );
+    }
+    const canonicalRoot = await fs.realpath(root);
+    let target = root;
+    for (let i = 0; i < segments.length; i++) {
+      target = join(target, segments[i]);
+      const stat = await fs.lstat(target);
+      if (stat.isSymbolicLink()) {
+        throw this.failure(
+          403,
+          'FORBIDDEN_PATH',
+          'Symbolic links and junctions cannot be edited.',
+        );
+      }
+      if (i < segments.length - 1 ? !stat.isDirectory() : !stat.isFile()) {
+        throw this.failure(
+          400,
+          'INVALID_PATH',
+          'The target must be an existing regular file.',
+        );
+      }
+    }
+    const canonicalTarget = await fs.realpath(target);
+    const inside = relative(canonicalRoot, canonicalTarget);
+    if (
+      !inside ||
+      inside === '..' ||
+      inside.startsWith(`..${sep}`) ||
+      isAbsolute(inside)
+    ) {
+      throw this.failure(
+        403,
+        'FORBIDDEN_PATH',
+        'The file is outside the selected game root.',
+      );
+    }
+    return canonicalTarget;
+  }
+
+  private snapshot(bytes: Buffer): TextFileSnapshot {
+    const text = bytes.toString('utf8');
+    if (!Buffer.from(text, 'utf8').equals(bytes) || text.includes('\0')) {
+      throw this.failure(
+        422,
+        'INVALID_UTF8',
+        'The file is not lossless UTF-8 text.',
+      );
+    }
+    return { text, revision: createHash('sha256').update(bytes).digest('hex') };
+  }
+
+  private checkRevision(bytes: Buffer, expectedRevision: string) {
+    const { revision } = this.snapshot(bytes);
+    if (revision !== expectedRevision) {
+      throw this.failure(
+        409,
+        'REVISION_CONFLICT',
+        'The file changed on disk; reload or preserve your draft before retrying.',
+        {
+          expectedRevision,
+          actualRevision: revision,
+        },
+      );
+    }
+  }
+
+  private async acquireLock(path: string): Promise<fs.FileHandle> {
+    const deadline = Date.now() + this.lockWaitMs;
+    while (true) {
+      try {
+        return await fs.open(path, 'wx');
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+        if (Date.now() >= deadline) {
+          throw this.failure(
+            409,
+            'WRITE_LOCKED',
+            'Another editor owns the write lock. A lock left by an interrupted process must be inspected before removal.',
+          );
+        }
+        await new Promise((done) => setTimeout(done, 25));
+      }
+    }
+  }
+
+  private async serial<T>(
+    path: string,
+    operation: () => Promise<T>,
+  ): Promise<T> {
+    const key = process.platform === 'win32' ? path.toLowerCase() : path;
+    const previous = TextFileTransactions.queues.get(key) ?? Promise.resolve();
+    let release: () => void;
+    const current = new Promise<void>((done) => {
+      release = done;
+    });
+    TextFileTransactions.queues.set(key, current);
+    await previous;
+    try {
+      return await operation();
+    } finally {
+      release();
+      if (TextFileTransactions.queues.get(key) === current) {
+        TextFileTransactions.queues.delete(key);
+      }
+    }
+  }
+
+  private failure(status: number, code: string, message: string, details = {}) {
+    return new HttpException({ code, message, ...details }, status);
+  }
+
+  private fileError(error: unknown, committed = false): HttpException {
+    if (error instanceof HttpException) return error;
+    const ioCode = (error as NodeJS.ErrnoException)?.code ?? 'UNKNOWN';
+    const status =
+      ioCode === 'ENOENT'
+        ? 404
+        : ioCode === 'EACCES' || ioCode === 'EPERM'
+        ? 403
+        : 500;
+    return this.failure(
+      status,
+      status === 404 ? 'TEXT_FILE_MISSING' : 'TEXT_FILE_IO_ERROR',
+      committed
+        ? 'The text was saved, but its write lock could not be removed.'
+        : 'The text file could not be read or saved.',
+      { ioCode, ...(committed ? { committed: true } : {}) },
+    );
+  }
+}
