diff --git a/packages/origine2/src/pages/editor/SceneDocument/DocumentBar.tsx b/packages/origine2/src/pages/editor/SceneDocument/DocumentBar.tsx
new file mode 100644
index 0000000..bde2de4
--- /dev/null
+++ b/packages/origine2/src/pages/editor/SceneDocument/DocumentBar.tsx
@@ -0,0 +1,27 @@
+import { useState } from 'react';
+import type { DocumentState, SceneDocument } from './sceneDocument';
+import styles from './documentBar.module.scss';
+import { pendingScenePaths } from './sceneDocumentRegistry';
+
+const labels = { loading: '正在读取', saved: '已保存', dirty: '未保存草稿', saving: '正在保存', conflict: '文件冲突 · 草稿已保留', error: '操作失败 · 草稿已保留' };
+export function DocumentBar({ document, state }: { document: SceneDocument; state: DocumentState }) {
+  const [backedUp, setBackedUp] = useState<string | null>(null);
+  const download = () => {
+    const url = URL.createObjectURL(new Blob([state.text], { type: 'text/plain;charset=utf-8' }));
+    const anchor = globalThis.document.createElement('a');
+    anchor.href = url;
+    anchor.download = `scene-draft-${Date.now()}.txt`;
+    anchor.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+    setBackedUp(state.text);
+  };
+  return <div className={styles.bar} data-status={state.status}>
+    <div role="status" aria-live="polite"><strong>{labels[state.status]}</strong>{state.status === 'dirty' && <span>保存后可同步预览</span>}{state.status === 'saved' && pendingScenePaths().length > 0 && <span>预览暂停，请先处理其他脚本：{pendingScenePaths().join('、')}</span>}{state.message && <span>{state.message}</span>}{state.recoveryWarning && <span>{state.recoveryWarning}</span>}</div>
+    <div className={styles.actions}>
+      <button type="button" disabled={!state.revision || ['saved', 'loading', 'saving', 'conflict'].includes(state.status)} onClick={() => void document.save()}>保存脚本</button>
+      <button type="button" disabled={state.status === 'loading' || state.status === 'saving'} onClick={() => void document.load()}>检查磁盘版本</button>
+      <button type="button" disabled={!state.revision} onClick={download}>下载草稿</button>
+      {(state.status === 'conflict' || state.status === 'error') && <button type="button" disabled={backedUp !== state.text} title="请先下载当前草稿，再载入磁盘版本" onClick={() => void document.reloadDisk()}>已备份，载入磁盘版本</button>}
+    </div>
+  </div>;
+}
