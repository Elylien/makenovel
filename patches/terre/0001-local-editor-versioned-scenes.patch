+import { ConsoleLogger, INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import * as fs from 'fs/promises';
+import { tmpdir } from 'os';
+import { dirname, join } from 'path';
+import request = require('supertest');
+import { ManageGameController } from '../manage-game/manage-game.controller';
+import { ManageGameService } from '../manage-game/manage-game.service';
+import { UserDataService } from '../user-data/user-data.service';
+import { WebgalFsService } from './webgal-fs.service';
+
+describe('Text snapshot HTTP API (real filesystem)', () => {
+  const location = {
+    gameName: 'API 中文作品',
+    path: 'game/scene/开始 场景.txt',
+  };
+  let root: string;
+  let target: string;
+  let app: INestApplication;
+  let gameRoot: jest.SpyInstance;
+
+  beforeEach(async () => {
+    root = await fs.mkdtemp(join(tmpdir(), 'makenovel-text-api-'));
+    target = join(root, location.gameName, location.path);
+    await fs.mkdir(dirname(target), { recursive: true });
+    await fs.writeFile(target, '\uFEFF角色:原文;\r\n');
+    // Profile selection is the only boundary substituted. Every file operation,
+    // request parser, controller, service and error response remains real.
+    gameRoot = jest.spyOn(UserDataService, 'getGameRoot').mockReturnValue(root);
+    const module = await Test.createTestingModule({
+      controllers: [ManageGameController],
+      providers: [
+        ConsoleLogger,
+        WebgalFsService,
+        { provide: ManageGameService, useValue: {} },
+      ],
+    }).compile();
+    app = module.createNestApplication();
+    await app.init();
+  });
+
+  afterEach(async () => {
+    await app?.close();
+    gameRoot?.mockRestore();
+    await fs.chmod(target, 0o666).catch(() => undefined);
+    await fs.rm(root, { recursive: true, force: true });
+  });
+
+  it('returns persisted text and byte revision with HTTP 200 on read and save', async () => {
+    const before = await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send(location)
+      .expect(200);
+    expect(before.body.text).toBe('\uFEFF角色:原文;\r\n');
+    expect(before.body.revision).toMatch(/^[a-f0-9]{64}$/);
+    const next = '\uFEFF角色:新对白;\r\n';
+    const saved = await request(app.getHttpServer())
+      .post('/api/manageGame/saveTextSnapshot')
+      .send({ ...location, text: next, expectedRevision: before.body.revision })
+      .expect(200);
+    expect(saved.body.text).toBe(next);
+    expect(await fs.readFile(target, 'utf8')).toBe(next);
+    const reopened = await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send(location)
+      .expect(200);
+    expect(reopened.body).toEqual(saved.body);
+  });
+
+  it('returns a structured HTTP 409 after a real external edit and preserves that edit', async () => {
+    const before = await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send(location)
+      .expect(200);
+    await fs.writeFile(target, '外部 AI:已修改;\r\n');
+    const response = await request(app.getHttpServer())
+      .post('/api/manageGame/saveTextSnapshot')
+      .send({
+        ...location,
+        text: '旧缓存;',
+        expectedRevision: before.body.revision,
+      })
+      .expect(409);
+    expect(response.body).toMatchObject({
+      code: 'REVISION_CONFLICT',
+      expectedRevision: before.body.revision,
+    });
+    expect(response.body.actualRevision).toMatch(/^[a-f0-9]{64}$/);
+    expect(await fs.readFile(target, 'utf8')).toBe('外部 AI:已修改;\r\n');
+  });
+
+  it('reports missing files as HTTP 404', async () => {
+    await fs.unlink(target);
+    const response = await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send(location)
+      .expect(404);
+    expect(response.body).toMatchObject({
+      code: 'TEXT_FILE_MISSING',
+      ioCode: 'ENOENT',
+    });
+  });
+
+  it('reports malformed requests and path traversal as HTTP 400', async () => {
+    await request(app.getHttpServer())
+      .post('/api/manageGame/saveTextSnapshot')
+      .send({ ...location, text: 'no revision' })
+      .expect(400);
+    await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send({ ...location, path: '../outside.txt' })
+      .expect(400);
+    await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send({})
+      .expect(400);
+    expect(await fs.readFile(target, 'utf8')).toBe('\uFEFF角色:原文;\r\n');
+  });
+
+  it('reports a real read-only replacement failure with HTTP 403', async () => {
+    const before = await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send(location)
+      .expect(200);
+    if (process.platform === 'win32') await fs.chmod(target, 0o444);
+    else await fs.chmod(dirname(target), 0o555);
+    try {
+      const result = await request(app.getHttpServer())
+        .post('/api/manageGame/saveTextSnapshot')
+        .send({
+          ...location,
+          text: 'wrong',
+          expectedRevision: before.body.revision,
+        })
+        .expect(403);
+      expect(result.body.code).toBe('TEXT_FILE_IO_ERROR');
+      expect(['EPERM', 'EACCES']).toContain(result.body.ioCode);
+      expect(await fs.readFile(target, 'utf8')).toBe('\uFEFF角色:原文;\r\n');
+    } finally {
+      await fs.chmod(target, 0o666);
+      await fs.chmod(dirname(target), 0o755);
+    }
+  });
+
+  it('reports invalid on-disk UTF-8 with HTTP 422', async () => {
+    await fs.writeFile(target, Buffer.from([0xff, 0xfe, 0x80]));
+    const result = await request(app.getHttpServer())
+      .post('/api/manageGame/textSnapshot')
+      .send(location)
+      .expect(422);
+    expect(result.body.code).toBe('INVALID_UTF8');
+  });
+});
