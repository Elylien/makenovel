+import { createHash } from 'crypto';
+import { spawn } from 'child_process';
+import * as fs from 'fs/promises';
+import { tmpdir } from 'os';
+import { basename, dirname, join } from 'path';
+import { TextFileTransactions } from './text-file-transaction';
+
+describe('TextFileTransactions (real filesystem)', () => {
+  const gameName = '中文 作品';
+  const scene = 'game/scene/中文 剧本.txt';
+  const original = '\uFEFF; 保留注释\r\n未知命令:值 -keep;\r\n角色:旧对白;\r\n';
+  let root: string;
+  let target: string;
+  let transaction: TextFileTransactions;
+
+  beforeEach(async () => {
+    root = await fs.mkdtemp(join(tmpdir(), 'makenovel-transaction-'));
+    target = join(root, gameName, scene);
+    await fs.mkdir(dirname(target), { recursive: true });
+    await fs.writeFile(target, original, 'utf8');
+    transaction = new TextFileTransactions(() => root, 200);
+  });
+
+  afterEach(async () => {
+    await fs.chmod(target, 0o666).catch(() => undefined);
+    await fs.rm(root, { recursive: true, force: true });
+  });
+
+  it('hashes real UTF-8 bytes and keeps BOM, CRLF, comments and unknown syntax', async () => {
+    const snapshot = await transaction.read(gameName, scene);
+    expect(snapshot).toEqual({
+      text: original,
+      revision: createHash('sha256')
+        .update(await fs.readFile(target))
+        .digest('hex'),
+    });
+    const changed = original.replace('旧对白', '新对白');
+    const saved = await transaction.save(
+      gameName,
+      scene,
+      changed,
+      snapshot.revision,
+    );
+    expect(await fs.readFile(target)).toEqual(Buffer.from(changed, 'utf8'));
+    expect(saved).toEqual(await transaction.read(gameName, scene));
+    expect(await fs.readdir(dirname(target))).toEqual([basename(target)]);
+  });
+
+  it('refuses stale writes after an external editor changes the file', async () => {
+    const snapshot = await transaction.read(gameName, scene);
+    const external = original + '; 外部修改\r\n';
+    await fs.writeFile(target, external);
+    await expect(
+      transaction.save(gameName, scene, 'stale', snapshot.revision),
+    ).rejects.toMatchObject({
+      status: 409,
+      response: {
+        code: 'REVISION_CONFLICT',
+        expectedRevision: snapshot.revision,
+        actualRevision: createHash('sha256').update(external).digest('hex'),
+      },
+    });
+    expect(await fs.readFile(target, 'utf8')).toBe(external);
+    expect(await fs.readdir(dirname(target))).toEqual([basename(target)]);
+  });
+
+  it('allows only one of two concurrent writers with the same revision', async () => {
+    const snapshot = await transaction.read(gameName, scene);
+    const second = new TextFileTransactions(() => root);
+    const outcomes = await Promise.allSettled([
+      transaction.save(gameName, scene, 'writer one', snapshot.revision),
+      second.save(gameName, scene, 'writer two', snapshot.revision),
+    ]);
+    expect(
+      outcomes.filter((outcome) => outcome.status === 'fulfilled'),
+    ).toHaveLength(1);
+    const rejected = outcomes.find(
+      (outcome) => outcome.status === 'rejected',
+    ) as PromiseRejectedResult;
+    expect(rejected.reason).toMatchObject({
+      status: 409,
+      response: { code: 'REVISION_CONFLICT' },
+    });
+    expect(['writer one', 'writer two']).toContain(
+      await fs.readFile(target, 'utf8'),
+    );
+  });
+
+  it('serializes cooperating writers in independent node processes using the lockfile', async () => {
+    const snapshot = await transaction.read(gameName, scene);
+    const runWriter = (text: string) =>
+      new Promise<{ status: number; code?: string }>((done, reject) => {
+        const program = `
+        const { TextFileTransactions } = require(process.argv[1]);
+        const [root, game, path, text, revision] = JSON.parse(process.argv[2]);
+        new TextFileTransactions(() => root).save(game, path, text, revision)
+          .then(() => console.log(JSON.stringify({status: 200})))
+          .catch(error => console.log(JSON.stringify({status: error.getStatus(), code: error.getResponse().code})));
+      `;
+        const child = spawn(
+          process.execPath,
+          [
+            '-r',
+            require.resolve('ts-node/register/transpile-only'),
+            '-e',
+            program,
+            join(__dirname, 'text-file-transaction.ts'),
+            JSON.stringify([root, gameName, scene, text, snapshot.revision]),
+          ],
+          { cwd: join(__dirname, '../../..'), windowsHide: true },
+        );
+        let output = '';
+        let errors = '';
+        child.stdout.on('data', (data) => {
+          output += data;
+        });
+        child.stderr.on('data', (data) => {
+          errors += data;
+        });
+        child.on('error', reject);
+        child.on('close', (code) => {
+          if (code !== 0) return reject(new Error(errors));
+          try {
+            done(JSON.parse(output.trim()));
+          } catch (error) {
+            reject(error);
+          }
+        });
+      });
+    const results = await Promise.all([
+      runWriter('process one'),
+      runWriter('process two'),
+    ]);
+    expect(results.map((result) => result.status).sort()).toEqual([200, 409]);
+    expect(results.find((result) => result.status === 409).code).toBe(
+      'REVISION_CONFLICT',
+    );
+    expect(['process one', 'process two']).toContain(
+      await fs.readFile(target, 'utf8'),
+    );
+    expect(await fs.readdir(dirname(target))).toEqual([basename(target)]);
+  }, 30000);
+
+  it('does not steal an existing lock or write through it', async () => {
+    const snapshot = await transaction.read(gameName, scene);
+    const lockPath = join(
+      dirname(target),
+      `.${basename(target)}.makenovel.lock`,
+    );
+    await fs.writeFile(lockPath, 'another process');
+    await expect(
+      transaction.save(gameName, scene, 'wrong', snapshot.revision),
+    ).rejects.toMatchObject({
+      status: 409,
+      response: { code: 'WRITE_LOCKED' },
+    });
+    expect(await fs.readFile(target, 'utf8')).toBe(original);
+    expect(await fs.readFile(lockPath, 'utf8')).toBe('another process');
+  });
+
+  it('rejects missing files on both read and write instead of creating or claiming success', async () => {
+    const snapshot = await transaction.read(gameName, scene);
+    await fs.unlink(target);
+    await expect(transaction.read(gameName, scene)).rejects.toMatchObject({
+      status: 404,
+      response: { code: 'TEXT_FILE_MISSING' },
+    });
+    await expect(
+      transaction.save(gameName, scene, 'wrong', snapshot.revision),
+    ).rejects.toMatchObject({ status: 404 });
+    await expect(fs.stat(target)).rejects.toMatchObject({ code: 'ENOENT' });
+  });
+
+  it('rejects replacement of a read-only file without damaging its bytes', async () => {
+    const snapshot = await transaction.read(gameName, scene);
+    // Windows read-only prevents replacement; POSIX directory access controls it.
+    if (process.platform === 'win32') await fs.chmod(target, 0o444);
+    else await fs.chmod(dirname(target), 0o555);
+    try {
+      await expect(
+        transaction.save(gameName, scene, 'wrong', snapshot.revision),
+      ).rejects.toMatchObject({
+        status: 403,
+        response: { code: 'TEXT_FILE_IO_ERROR' },
+      });
+      expect(await fs.readFile(target, 'utf8')).toBe(original);
+      expect(await fs.readdir(dirname(target))).toEqual([basename(target)]);
+    } finally {
+      await fs.chmod(target, 0o666);
+      await fs.chmod(dirname(target), 0o755);
+    }
+  });
+
+  it.each([
+    ['../other', scene],
+    [gameName, '../other.txt'],
+    [gameName, 'game/../../other.txt'],
+    [gameName, 'C:\\outside.txt'],
+    [gameName, '/outside.txt'],
+    [gameName, 'game/scene/a.txt:stream'],
+    [gameName, 'game/scene./a.txt'],
+    ['', scene],
+  ])('rejects path escape or platform aliases (%s, %s)', async (game, path) => {
+    await expect(transaction.read(game, path)).rejects.toMatchObject({
+      status: 400,
+      response: { code: 'INVALID_PATH' },
+    });
+    expect(await fs.readFile(target, 'utf8')).toBe(original);
+  });
+
+  it('rejects junctions to files outside the selected game', async () => {
+    const outside = join(root, 'outside');
+    await fs.mkdir(outside);
+    await fs.writeFile(join(outside, 'secret.txt'), 'outside');
+    await fs.symlink(outside, join(root, gameName, 'linked'), 'junction');
+    await expect(
+      transaction.read(gameName, 'linked/secret.txt'),
+    ).rejects.toMatchObject({
+      status: 403,
+      response: { code: 'FORBIDDEN_PATH' },
+    });
+    await expect(
+      transaction.save(gameName, 'linked/secret.txt', 'wrong', '0'.repeat(64)),
+    ).rejects.toMatchObject({ status: 403 });
+    expect(await fs.readFile(join(outside, 'secret.txt'), 'utf8')).toBe(
+      'outside',
+    );
+  });
+
+  it('does not URL-decode literal percent sequences in JSON paths', async () => {
+    const name = 'game/scene/%20中文.txt';
+    await fs.writeFile(join(root, gameName, name), 'literal');
+    expect((await transaction.read(gameName, name)).text).toBe('literal');
+  });
+
+  it('refuses a profile-root change during a transaction', async () => {
+    const revision = (await transaction.read(gameName, scene)).revision;
+    const anotherRoot = join(root, 'another profile');
+    const anotherTarget = join(anotherRoot, gameName, scene);
+    await fs.mkdir(dirname(anotherTarget), { recursive: true });
+    await fs.writeFile(anotherTarget, original);
+    let rootReads = 0;
+    const changingProfile = new TextFileTransactions(() =>
+      ++rootReads === 1 ? root : anotherRoot,
+    );
+    await expect(
+      changingProfile.save(gameName, scene, 'wrong', revision),
+    ).rejects.toMatchObject({
+      status: 409,
+      response: { code: 'EDIT_TARGET_CHANGED' },
