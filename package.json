{
  "name": "makenovel",
  "version": "0.0.6",
  "private": true,
  "description": "Visual novel authoring toolchain based on verified WebGAL and Terre baselines",
  "license": "MPL-2.0",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --test experiments/source-roundtrip/*.test.mjs",
    "baseline:install": "pwsh -NoLogo -NoProfile -File scripts/Invoke-Upstream.ps1 -Target WebGAL -Action Install",
    "baseline:build": "pwsh -NoLogo -NoProfile -File scripts/Invoke-Upstream.ps1 -Target WebGAL -Action Build",
    "baseline:test": "pwsh -NoLogo -NoProfile -File scripts/Invoke-Upstream.ps1 -Target WebGAL -Action Test",
    "baseline:preview": "pwsh -NoLogo -NoProfile -File scripts/Invoke-Upstream.ps1 -Target WebGAL -Action Preview",
    "patch:check": "pwsh -NoLogo -NoProfile -File scripts/Apply-Patches.ps1 -Check",
    "patch:apply": "pwsh -NoLogo -NoProfile -File scripts/Apply-Patches.ps1 -Apply",
    "patch:runtime:check": "pwsh -NoLogo -NoProfile -File scripts/Apply-Patches.ps1 -Target WebGAL -Check",
    "patch:runtime:apply": "pwsh -NoLogo -NoProfile -File scripts/Apply-Patches.ps1 -Target WebGAL -Apply",
    "editor:build": "pwsh -NoLogo -NoProfile -File scripts/Invoke-Upstream.ps1 -Target WebGAL_Terre -Action Build",
    "editor:start": "pwsh -NoLogo -NoProfile -File scripts/Start-Editor.ps1 -Background",
    "editor:stop": "pwsh -NoLogo -NoProfile -File scripts/Start-Editor.ps1 -Stop",
    "test:editor": "node integrations/terre-tests/run.cjs --no-cache",
    "test:documents": "node integrations/scene-document-tests/run-tests.mjs && node integrations/scene-document-tests/run-message-tests.mjs",
    "test:source-input": "node integrations/scene-document-tests/run-source-editor-tests.mjs",
    "test:graph-input": "node integrations/scene-document-tests/run-graph-input-tests.mjs",
    "test:patches": "pwsh -NoLogo -NoProfile -File integrations/patch-tests/Test-PatchReplay.ps1",
    "test:identity": "node integrations/scene-identity-tests/run-tests.mjs",
    "game:export": "pwsh -NoLogo -NoProfile -File scripts/Export-Game.ps1",
    "test:manifest": "node --test integrations/game-manifest/manifest.test.mjs",
    "test:save-backup": "node integrations/save-backup-tests/run-tests.mjs",
    "test:save-compatibility": "node integrations/save-compatibility-tests/run-tests.mjs",
    "test:runtime-restore": "node integrations/runtime-restore-tests/run-tests.mjs",
    "test:save-storage": "node integrations/save-storage-tests/run-tests.mjs",
    "game:seal": "pwsh -NoLogo -NoProfile -File scripts/Seal-Game.ps1",
    "test:save-initialization": "node integrations/save-initialization-tests/run-tests.mjs",
    "test:save-ui": "node integrations/runtime-restore-tests/run-ui-tests.mjs",
    "test:menu-lifecycle": "node integrations/menu-lifecycle-tests/run-tests.mjs",
    "test:perform-lifecycle": "node integrations/perform-lifecycle-tests/run-tests.mjs",
    "test:audio-lifecycle": "node integrations/audio-lifecycle-tests/run-tests.mjs",
    "test:stage-exit": "node integrations/stage-exit-tests/run-tests.mjs",
    "test:stage-demo": "node --test integrations/stage-demo/stage-demo.test.mjs",
    "demo:stage": "node integrations/stage-demo/generate.mjs"
  }
}
